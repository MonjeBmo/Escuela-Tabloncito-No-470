<div class="flex items-center gap-3 mb-6">
  <a href="/alumnos" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 transition-colors flex-shrink-0">
    <i class="bi bi-arrow-left text-sm"></i>
  </a>
  <div class="flex-1">
    <h1 class="text-xl font-semibold text-slate-900">
      <%= alumno.primer_apellido %><% if(alumno.segundo_apellido){%> <%= alumno.segundo_apellido %><% } %>,
      <%= alumno.primer_nombre %><% if(alumno.segundo_nombre){%> <%= alumno.segundo_nombre %><% } %>
    </h1>
    <p class="text-sm text-slate-500 mt-0.5">Perfil del alumno</p>
  </div>
  <% if (usuario.rol === 'director') { %>
  <form method="POST" action="/alumnos/<%= alumno.id %>/eliminar">
    <button type="button" class="inline-flex items-center gap-2 px-3 py-2 bg-white border border-red-200 text-red-500 text-sm font-medium rounded-lg hover:bg-red-50 transition-colors"
      data-confirm="¿Eliminar el registro de <%= alumno.primer_nombre %> <%= alumno.primer_apellido %>?">
      <i class="bi bi-trash"></i> Eliminar
    </button>
  </form>
  <% } %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <!-- Perfil -->
  <div class="lg:col-span-2 space-y-5">
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-4 border-b border-slate-100 flex items-center gap-4">
        <div class="w-12 h-12 rounded-full flex items-center justify-center text-lg font-bold flex-shrink-0
          <%= alumno.genero === 'M' ? 'bg-blue-100 text-blue-700' : alumno.genero === 'F' ? 'bg-pink-100 text-pink-700' : 'bg-slate-100 text-slate-600' %>">
          <%= (alumno.primer_nombre.charAt(0) + alumno.primer_apellido.charAt(0)).toUpperCase() %>
        </div>
        <div>
          <div class="font-semibold text-slate-900">
            <%= alumno.primer_apellido %><% if(alumno.segundo_apellido){%> <%= alumno.segundo_apellido %><% } %>,
            <%= alumno.primer_nombre %><% if(alumno.segundo_nombre){%> <%= alumno.segundo_nombre %><% } %>
          </div>
          <div class="text-sm text-slate-500 mt-0.5">
            <%= alumno.genero === 'M' ? 'Masculino' : alumno.genero === 'F' ? 'Femenino' : 'Sin especificar' %>
          </div>
        </div>
      </div>
      <dl class="divide-y divide-slate-100">
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">CUI</dt>
          <dd class="text-sm font-mono text-slate-700"><%= alumno.cui || '—' %></dd>
        </div>
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Nacimiento</dt>
          <dd class="text-sm text-slate-700"><%= alumno.fecha_nacimiento ? new Date(alumno.fecha_nacimiento).toLocaleDateString('es-GT',{day:'2-digit',month:'long',year:'numeric'}) : '—' %></dd>
        </div>
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Municipio</dt>
          <dd class="text-sm text-slate-700"><%= alumno.municipio || '—' %></dd>
        </div>
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Departamento</dt>
          <dd class="text-sm text-slate-700"><%= alumno.departamento || '—' %></dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Lateral -->
  <div class="space-y-4">
    <div class="bg-white rounded-xl border border-slate-200/70 p-5">
      <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Datos académicos</h2>
      <dl class="space-y-3">
        <div>
          <dt class="text-xs text-slate-400 mb-0.5">Grado</dt>
          <dd class="text-sm font-medium text-slate-800"><%= alumno.grado_nombre || '—' %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-400 mb-0.5">Año de ingreso</dt>
          <dd class="text-sm font-medium text-slate-800"><%= alumno.anio_ingreso %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-400 mb-0.5">Registrado</dt>
          <dd class="text-sm text-slate-600"><%= new Date(alumno.created_at).toLocaleDateString('es-GT') %></dd>
        </div>
      </dl>
    </div>
    <div class="bg-white rounded-xl border border-slate-200/70 p-5">
      <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Encargado</h2>
      <dl class="space-y-3">
        <div>
          <dt class="text-xs text-slate-400 mb-0.5">Nombre</dt>
          <dd class="text-sm font-medium text-slate-800"><%= alumno.nombre_encargado || '—' %></dd>
        </div>
        <div>
          <dt class="text-xs text-slate-400 mb-0.5">Teléfono</dt>
          <dd class="text-sm text-slate-600"><%= alumno.telefono_encargado || '—' %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>
