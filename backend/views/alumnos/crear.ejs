<div class="flex items-center gap-3 mb-6">
  <a href="/alumnos" class="w-9 h-9 flex items-center justify-center rounded-xl border border-hueso-300 bg-white text-marino-700 hover:bg-hueso-100 hover:border-bosque-500 transition-all shadow-sm flex-shrink-0">
    <i class="bi bi-arrow-left text-sm font-bold"></i>
  </a>
  <div>
    <h1 class="text-xl font-bold font-serif text-marino-950">Registrar Alumno de Nuevo Ingreso</h1>
    <p class="text-xs text-marino-600/80 mt-0.5">Ficha de matrícula y datos escolares del estudiante</p>
  </div>
</div>

<script id="sections-data" type="application/json"><%- JSON.stringify(sections) %></script>

<form method="POST" action="/alumnos/crear">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Left (main data) -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Datos personales -->
      <div class="bg-white rounded-2xl border border-hueso-200/80 p-6 shadow-sm">
        <div class="flex items-center gap-2.5 pb-4 mb-5 border-b border-hueso-100">
          <div class="w-8 h-8 rounded-lg bg-bosque-100 text-bosque-700 flex items-center justify-center font-bold text-sm">
            <i class="bi bi-person"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-marino-950 font-serif">Datos Personales del Estudiante</h2>
            <p class="text-[11px] text-marino-600/70">Información de identificación oficial</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Primer nombre <span class="text-ladrillo-600">*</span></label>
            <input type="text" name="primer_nombre" required class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Segundo nombre</label>
            <input type="text" name="segundo_nombre" class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Primer apellido <span class="text-ladrillo-600">*</span></label>
            <input type="text" name="primer_apellido" required class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Segundo apellido</label>
            <input type="text" name="segundo_apellido" class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">CUI (Código Único de Identificación)</label>
            <input type="text" name="cui" placeholder="13 dígitos del RENAP" maxlength="20" class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-400 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none font-mono">
            <p class="text-[11px] text-marino-500 mt-1">Número de 13 dígitos emitido en el certificado de nacimiento.</p>
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Fecha de nacimiento</label>
            <input type="date" name="fecha_nacimiento" class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
            <p class="text-[11px] text-marino-500 mt-1">Calcula automáticamente la edad del estudiante.</p>
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Género</label>
            <select name="genero" class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 px-3 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
              <option value="">Sin especificar</option>
              <option value="M">Masculino</option>
              <option value="F">Femenino</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Año de ingreso</label>
            <input type="number" name="anio_ingreso" value="<%= new Date().getFullYear() %>"
              min="2000" max="<%= new Date().getFullYear() %>"
              class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
          </div>
        </div>
      </div>

      <!-- Datos académicos -->
      <div class="bg-white rounded-2xl border border-hueso-200/80 p-6 shadow-sm">
        <div class="flex items-center gap-2.5 pb-4 mb-5 border-b border-hueso-100">
          <div class="w-8 h-8 rounded-lg bg-marino-100 text-marino-700 flex items-center justify-center font-bold text-sm">
            <i class="bi bi-mortarboard"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-marino-950 font-serif">Asignación Escolar y Procedencia</h2>
            <p class="text-[11px] text-marino-600/70">Grado inicial y datos de origen</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Grado y sección con selects dependientes -->
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Grado a Inscribir</label>
            <select id="grade-sel" class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 px-3 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
              <option value="">Sin asignar</option>
              <% grades.forEach(g => { %><option value="<%= g.id %>"><%= g.nombre %></option><% }) %>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Sección</label>
            <select name="section_id" id="section-sel" class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 px-3 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
              <option value="">Sin asignar</option>
              <% sections.forEach(s => { %><option value="<%= s.id %>" data-grade="<%= s.grade_id %>"><%= s.nombre %></option><% }) %>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Municipio de Residencia</label>
            <input type="text" name="municipio" placeholder="Ej. Guatemala" class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Departamento</label>
            <input type="text" name="departamento" placeholder="Ej. Guatemala" class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
          </div>
        </div>
      </div>
    </div>

    <!-- Right (encargado + actions) -->
    <div class="space-y-6">
      <div class="bg-white rounded-2xl border border-hueso-200/80 p-6 shadow-sm">
        <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-hueso-100">
          <div class="w-8 h-8 rounded-lg bg-ocre-100 text-ocre-800 flex items-center justify-center font-bold text-sm">
            <i class="bi bi-people"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-marino-950 font-serif">Encargado o Tutor</h2>
            <p class="text-[11px] text-marino-600/70">Contacto para emergencias</p>
          </div>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Nombre Completo</label>
            <input type="text" name="nombre_encargado" placeholder="Padre, madre o tutor" class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Teléfono de Contacto</label>
            <input type="tel" name="telefono_encargado" placeholder="5555-5555"
              class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-bosque-600 focus:ring-2 focus:ring-bosque-500/20 transition-all outline-none">
          </div>
        </div>
      </div>

      <div class="space-y-3">
        <button type="submit" class="w-full h-11 bg-bosque-600 hover:bg-bosque-700 text-white text-sm font-semibold rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2">
          <i class="bi bi-person-plus-fill"></i> Registrar Alumno
        </button>
        <a href="/alumnos" class="w-full h-10 flex items-center justify-center bg-white border border-hueso-300 text-marino-700 text-xs font-semibold rounded-xl hover:bg-hueso-100 transition-all shadow-sm">
          Cancelar
        </a>
      </div>
    </div>
  </div>
</form>

<script>
(function () {
  const allSections = JSON.parse(document.getElementById('sections-data').textContent);
  const gradeSel   = document.getElementById('grade-sel');
  const sectionSel = document.getElementById('section-sel');

  gradeSel.addEventListener('change', function () {
    const gradeId = parseInt(this.value) || 0;
    const prev = sectionSel.value;
    sectionSel.innerHTML = '<option value="">Sin asignar</option>';
    allSections
      .filter(s => s.is_active && (!gradeId || s.grade_id === gradeId))
      .forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.nombre;
        if (String(s.id) === prev) opt.selected = true;
        sectionSel.appendChild(opt);
      });
  });
})();
</script>
