<div class="flex items-center gap-3 mb-6">
  <a href="/alumnos" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 transition-colors flex-shrink-0">
    <i class="bi bi-arrow-left text-sm"></i>
  </a>
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Registrar alumno de nuevo ingreso</h1>
    <p class="text-sm text-slate-500 mt-0.5">Complete los datos del estudiante</p>
  </div>
</div>

<script id="sections-data" type="application/json"><%- JSON.stringify(sections) %></script>

<form method="POST" action="/alumnos/crear">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

    <!-- Left (main data) -->
    <div class="lg:col-span-2 space-y-5">
      <!-- Datos personales -->
      <div class="bg-white rounded-xl border border-slate-200/70 p-5">
        <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-4">Datos personales</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Primer nombre <span class="text-red-400">*</span></label>
            <input type="text" name="primer_nombre" required class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Segundo nombre</label>
            <input type="text" name="segundo_nombre" class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Primer apellido <span class="text-red-400">*</span></label>
            <input type="text" name="primer_apellido" required class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Segundo apellido</label>
            <input type="text" name="segundo_apellido" class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">CUI</label>
            <input type="text" name="cui" placeholder="################" class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white focus:border-blue-400 transition-colors font-mono">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Fecha de nacimiento</label>
            <input type="date" name="fecha_nacimiento" class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Género</label>
            <select name="genero" class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
              <option value="">Sin especificar</option>
              <option value="M">Masculino</option>
              <option value="F">Femenino</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Año de ingreso</label>
            <input type="number" name="anio_ingreso" value="<%= new Date().getFullYear() %>"
              min="2000" max="<%= new Date().getFullYear() %>"
              class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
        </div>
      </div>

      <!-- Datos académicos -->
      <div class="bg-white rounded-xl border border-slate-200/70 p-5">
        <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-4">Datos académicos y origen</h2>
        <div class="grid grid-cols-2 gap-4">
          <!-- Grado y sección con selects dependientes -->
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Grado</label>
            <select id="grade-sel" class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
              <option value="">Sin asignar</option>
              <% grades.forEach(g => { %><option value="<%= g.id %>"><%= g.nombre %></option><% }) %>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Sección</label>
            <select name="section_id" id="section-sel" class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
              <option value="">Sin asignar</option>
              <% sections.forEach(s => { %><option value="<%= s.id %>" data-grade="<%= s.grade_id %>"><%= s.nombre %></option><% }) %>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Municipio</label>
            <input type="text" name="municipio" class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Departamento</label>
            <input type="text" name="departamento" class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
        </div>
      </div>
    </div>

    <!-- Right (encargado + actions) -->
    <div class="space-y-4">
      <div class="bg-white rounded-xl border border-slate-200/70 p-5">
        <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-4">Encargado / padre de familia</h2>
        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre</label>
            <input type="text" name="nombre_encargado" class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Teléfono</label>
            <input type="tel" name="telefono_encargado" placeholder="####-####"
              class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
        </div>
      </div>
      <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
        <i class="bi bi-floppy"></i> Registrar alumno
      </button>
      <a href="/alumnos" class="w-full h-10 flex items-center justify-center bg-white border border-slate-200 text-slate-600 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors">
        Cancelar
      </a>
    </div>
  </div>
</form>

<script>
(function () {
  const allSections = JSON.parse(document.getElementById('sections-data').textContent);
  const gradeSel   = document.getElementById('grade-sel');
  const sectionSel = document.getElementById('section-sel');

  gradeSel.addEventListener('change', function () {
    const gradeId = parseInt(this.value) || 0;
    const prev = sectionSel.value;
    sectionSel.innerHTML = '<option value="">Sin asignar</option>';
    allSections
      .filter(s => s.is_active && (!gradeId || s.grade_id === gradeId))
      .forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.nombre;
        if (String(s.id) === prev) opt.selected = true;
        sectionSel.appendChild(opt);
      });
  });
})();
</script>
