<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-5">
  <div>
    <div class="flex items-center gap-2 mb-1">
      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-bosque-100 text-bosque-800 border border-bosque-200/70">
        <i class="bi bi-tree-fill text-[10px]"></i> Registro Escolar
      </span>
      <span class="text-xs text-marino-400">•</span>
      <span class="text-xs text-marino-500 font-medium"><%= total %> alumno(s) registrados</span>
    </div>
    <h1 class="text-2xl font-display font-bold text-marino-900 tracking-tight">Registro de Alumnos</h1>
  </div>
  <div class="flex items-center gap-2.5 flex-shrink-0">
    <button type="button" onclick="document.getElementById('import-modal-alumnos').showModal()"
      class="inline-flex items-center gap-2 px-3.5 py-2 bg-white border border-hueso-300 text-bosque-700 text-sm font-semibold rounded-xl hover:bg-bosque-50 hover:border-bosque-300 shadow-xs transition-colors">
      <i class="bi bi-file-earmark-excel-fill text-bosque-600"></i>
      <span>Importar Excel</span>
    </button>
    <% if (can('students.create')) { %>
    <a href="/alumnos/crear" aria-label="Nuevo alumno"
      class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-bosque-600 to-bosque-700 text-white text-sm font-bold font-display rounded-xl hover:from-bosque-700 hover:to-bosque-800 shadow-sm shadow-bosque-600/25 transition-all">
      <i class="bi bi-person-plus-fill"></i>
      <span>Nuevo Alumno</span>
    </a>
    <% } %>
  </div>
</div>

<!-- Guía Rápida para Maestros / Dirección -->
<div class="mb-5 p-4 rounded-xl bg-bosque-50/70 border border-bosque-200/70 flex items-start gap-3 text-xs text-marino-700">
  <i class="bi bi-person-badge text-bosque-700 text-base flex-shrink-0 mt-0.5"></i>
  <div class="flex-1 leading-relaxed">
    <strong class="font-semibold text-bosque-900">Control de Estudiantes y Matrícula:</strong> 
    Aquí puede administrar los expedientes individuales de los alumnos de la escuela. Puede buscar por 
    <span class="font-semibold text-bosque-800">CUI</span>, <span class="font-semibold text-bosque-800">Código Personal MINEDUC</span> o filtrar por grado y sección activa. Para cargas masivas, use el botón <span class="font-semibold text-bosque-800">"Importar Excel"</span>.
  </div>
</div>

<!-- Filters -->
<div class="bg-white rounded-2xl border border-hueso-200 p-4 mb-6 shadow-xs">
  <form method="GET" action="/alumnos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    <div class="sm:col-span-2 lg:col-span-2">
      <div class="relative">
        <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-marino-400 text-xs pointer-events-none"></i>
        <input type="text" name="q" value="<%= filtros.q || '' %>" placeholder="Buscar por nombre, apellido, CUI..."
          class="w-full h-10 pl-9 pr-3 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 placeholder-marino-400 focus:bg-white focus:border-bosque-500 transition-colors outline-none">
      </div>
    </div>
    <div>
      <select name="section_id" class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-700 px-3 focus:bg-white focus:border-bosque-500 transition-colors outline-none font-medium">
        <option value="">Todos los grados</option>
        <% secciones.forEach(s => { %><option value="<%= s.id %>" <%= filtros.section_id == s.id ? 'selected' : '' %>><%= s.display_name || s.nombre %></option><% }) %>
      </select>
    </div>
    <div class="flex gap-2">
      <input type="number" name="anio_ingreso" placeholder="Año de ingreso" value="<%= filtros.anio_ingreso || '' %>"
        class="flex-1 min-w-0 h-10 px-3 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 placeholder-marino-400 focus:bg-white focus:border-bosque-500 transition-colors outline-none font-medium">
      <button type="submit" class="h-10 px-4 bg-bosque-600 text-white text-sm font-semibold rounded-xl hover:bg-bosque-700 transition-colors flex-shrink-0 shadow-xs" aria-label="Buscar">
        <i class="bi bi-search"></i>
      </button>
    </div>
  </form>
</div>

<!-- Table / Cards -->
<div class="bg-white rounded-2xl border border-hueso-200 shadow-sm overflow-hidden">
  <% if (alumnos.length === 0) { %>
  <div class="py-16 text-center px-4">
    <div class="w-16 h-16 rounded-2xl bg-hueso-100 text-marino-300 flex items-center justify-center mx-auto mb-3">
      <i class="bi bi-people text-3xl"></i>
    </div>
    <p class="text-sm font-medium text-marino-500">No se encontraron alumnos registrados.</p>
  </div>
  <% } else { %>

  <!-- ── Desktop table (md+) ──────────────────────────── -->
  <div class="hidden md:block table-wrap">
    <table class="w-full text-sm">
      <thead class="bg-hueso-100/70 border-b border-hueso-200 text-marino-600">
        <tr>
          <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Alumno</th>
          <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">CUI</th>
          <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Grado y Sección</th>
          <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Ingreso</th>
          <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Encargado</th>
          <th class="px-6 py-3.5 w-16"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hueso-200/70">
        <% alumnos.forEach(a => { %>
        <tr class="hover:bg-hueso-50/80 transition-colors <%= !a.is_active ? 'opacity-50' : '' %>">
          <td class="px-6 py-3.5">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0 text-xs font-bold shadow-2xs
                <%= a.genero === 'M' ? 'bg-marino-100 text-marino-800 border border-marino-200' : a.genero === 'F' ? 'bg-ladrillo-100 text-ladrillo-800 border border-ladrillo-200' : 'bg-hueso-200 text-marino-700' %>">
                <%= (a.primer_nombre.charAt(0) + a.primer_apellido.charAt(0)).toUpperCase() %>
              </div>
              <div class="min-w-0">
                <div class="font-bold text-marino-900 truncate">
                  <%= a.primer_apellido %><% if (a.segundo_apellido) { %> <%= a.segundo_apellido %><% } %>,
                  <%= a.primer_nombre %><% if (a.segundo_nombre) { %> <%= a.segundo_nombre %><% } %>
                </div>
                <div class="text-xs text-marino-400">
                  <% if (!a.is_active) { %><span class="text-ladrillo-600 font-semibold">Inactivo</span><% } else { %>
                  <%= a.genero === 'M' ? 'Masculino' : a.genero === 'F' ? 'Femenino' : '' %><% } %>
                </div>
              </div>
            </div>
          </td>
          <td class="px-4 py-3.5 text-marino-500 text-xs font-mono font-medium"><%= a.cui || '—' %></td>
          <td class="px-4 py-3.5 text-marino-700 font-medium"><%= a.grado_nombre || '—' %></td>
          <td class="px-4 py-3.5 text-marino-800 font-semibold font-display"><%= a.anio_ingreso %></td>
          <td class="px-4 py-3.5">
            <div class="text-marino-700 text-sm font-medium"><%= a.nombre_encargado || '—' %></div>
            <% if (a.telefono_encargado) { %>
            <div class="text-xs text-marino-400"><%= a.telefono_encargado %></div>
            <% } %>
          </td>
          <td class="px-6 py-3.5 text-right">
            <div class="flex items-center justify-end gap-1.5">
              <a href="/alumnos/<%= a.id %>" aria-label="Ver alumno"
                class="w-8 h-8 flex items-center justify-center rounded-lg text-marino-500 hover:bg-hueso-200 hover:text-marino-900 transition-colors">
                <i class="bi bi-eye text-sm"></i>
              </a>
              <% if (can('students.create')) { %>
              <a href="/alumnos/<%= a.id %>/editar" aria-label="Editar alumno"
                class="w-8 h-8 flex items-center justify-center rounded-lg text-marino-500 hover:bg-hueso-200 hover:text-marino-900 transition-colors">
                <i class="bi bi-pencil text-sm"></i>
              </a>
              <form method="POST" action="/alumnos/<%= a.id %>/toggle">
                <button type="submit" aria-label="<%= a.is_active ? 'Desactivar' : 'Activar' %>"
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors
                    <%= a.is_active ? 'bg-bosque-50 text-bosque-700 hover:bg-bosque-100 border border-bosque-200' : 'bg-hueso-200 text-marino-500 hover:bg-hueso-300' %>">
                  <i class="bi bi-<%= a.is_active ? 'check-circle-fill' : 'slash-circle' %> text-xs"></i>
                  <%= a.is_active ? 'Activo' : 'Inactivo' %>
                </button>
              </form>
              <% } %>
              <% if (can('students.delete')) { %>
              <div class="relative">
                <button data-dd-trigger aria-label="Más opciones"
                  class="w-8 h-8 flex items-center justify-center rounded-lg text-marino-400 hover:bg-hueso-200 hover:text-marino-700 transition-colors">
                  <i class="bi bi-three-dots text-sm"></i>
                </button>
                <div data-dd-menu class="dropdown-menu closed absolute right-0 top-full mt-1 w-36 bg-white rounded-xl border border-hueso-200 shadow-xl p-1.5 z-20">
                  <form method="POST" action="/alumnos/<%= a.id %>/eliminar">
                    <button type="button" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-ladrillo-600 font-medium rounded-lg hover:bg-ladrillo-50 transition-colors"
                      data-confirm="¿Eliminar el registro de <%= a.primer_nombre %> <%= a.primer_apellido %>?">
                      <i class="bi bi-trash"></i> Eliminar
                    </button>
                  </form>
                </div>
              </div>
              <% } %>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- ── Mobile card list (< md) ──────────────────────── -->
  <div class="md:hidden divide-y divide-hueso-200/70">
    <% alumnos.forEach(a => { %>
    <div class="px-4 py-4">
      <div class="flex items-start justify-between gap-2">
        <a href="/alumnos/<%= a.id %>" class="flex items-center gap-3 min-w-0 flex-1">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 text-sm font-bold
            <%= a.genero === 'M' ? 'bg-marino-100 text-marino-800' : a.genero === 'F' ? 'bg-ladrillo-100 text-ladrillo-800' : 'bg-hueso-200 text-marino-700' %>">
            <%= (a.primer_nombre.charAt(0) + a.primer_apellido.charAt(0)).toUpperCase() %>
          </div>
          <div class="min-w-0">
            <div class="font-bold text-marino-900 truncate">
              <%= a.primer_apellido %><% if (a.segundo_apellido) { %> <%= a.segundo_apellido %><% } %>,
              <%= a.primer_nombre %><% if (a.segundo_nombre) { %> <%= a.segundo_nombre %><% } %>
            </div>
            <div class="text-xs text-marino-500 mt-0.5">
              <%= a.genero === 'M' ? 'Masculino' : a.genero === 'F' ? 'Femenino' : 'Sin especificar' %>
            </div>
          </div>
        </a>
        <div class="flex items-center gap-1 flex-shrink-0">
          <a href="/alumnos/<%= a.id %>" aria-label="Ver alumno"
            class="w-9 h-9 flex items-center justify-center rounded-lg text-marino-500 hover:bg-hueso-200 transition-colors">
            <i class="bi bi-eye text-sm"></i>
          </a>
          <% if (can('students.delete')) { %>
          <div class="relative">
            <button data-dd-trigger aria-label="Más opciones"
              class="w-9 h-9 flex items-center justify-center rounded-lg text-marino-400 hover:bg-hueso-200 transition-colors">
              <i class="bi bi-three-dots text-sm"></i>
            </button>
            <div data-dd-menu class="dropdown-menu closed absolute right-0 top-full mt-1 w-36 bg-white rounded-xl border border-hueso-200 shadow-xl p-1.5 z-20">
              <form method="POST" action="/alumnos/<%= a.id %>/eliminar">
                <button type="button" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-ladrillo-600 font-medium rounded-lg hover:bg-ladrillo-50 transition-colors"
                  data-confirm="¿Eliminar el registro de <%= a.primer_nombre %> <%= a.primer_apellido %>?">
                  <i class="bi bi-trash"></i> Eliminar
                </button>
              </form>
            </div>
          </div>
          <% } %>
        </div>
      </div>
      <div class="mt-2.5 ml-[52px] flex flex-wrap gap-x-3 gap-y-1 text-xs">
        <% if (a.grado_nombre) { %><span class="text-marino-600 font-medium"><i class="bi bi-mortarboard mr-1 text-marino-400"></i><%= a.grado_nombre %></span><% } %>
        <span class="text-marino-500">Ingreso <%= a.anio_ingreso %></span>
        <% if (a.nombre_encargado) { %><span class="text-marino-400 truncate"><i class="bi bi-person mr-0.5"></i><%= a.nombre_encargado %></span><% } %>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Pagination bar -->
  <% const _fq = encodeURIComponent(filtros.q||''); const _fg = encodeURIComponent(filtros.section_id||''); const _fa = encodeURIComponent(filtros.anio_ingreso||''); %>
  <div class="flex items-center justify-between gap-3 px-6 py-4 border-t border-hueso-200 bg-hueso-50/40">
    <div class="flex items-center gap-2 text-xs font-medium text-marino-500">
      <span class="hidden sm:inline">Mostrar:</span>
      <% [10, 20].forEach(n => { %>
        <a href="?q=<%= _fq %>&section_id=<%= _fg %>&anio_ingreso=<%= _fa %>&pagina=1&limit=<%= n %>"
          class="w-8 h-7 flex items-center justify-center rounded-lg border text-xs font-semibold transition-all
            <%= limit === n ? 'bg-bosque-600 text-white border-bosque-600 shadow-xs' : 'bg-white text-marino-700 border-hueso-300 hover:bg-hueso-100' %>">
          <%= n %>
        </a>
      <% }) %>
    </div>
    <% if (totalPaginas > 1) { %>
    <div class="flex items-center gap-1.5">
      <% if (pagina > 1) { %>
        <a href="?q=<%= _fq %>&section_id=<%= _fg %>&anio_ingreso=<%= _fa %>&pagina=<%= pagina-1 %>&limit=<%= limit %>" class="w-8 h-8 flex items-center justify-center rounded-lg text-marino-600 hover:bg-hueso-200 text-sm"><i class="bi bi-chevron-left"></i></a>
      <% } %>
      <% for(let p=1;p<=totalPaginas;p++){%>
        <% if(p===pagina){%><span class="w-8 h-8 flex items-center justify-center rounded-lg bg-bosque-600 text-white text-xs font-bold shadow-xs"><%= p %></span>
        <%}else{%><a href="?q=<%= _fq %>&section_id=<%= _fg %>&anio_ingreso=<%= _fa %>&pagina=<%= p %>&limit=<%= limit %>" class="w-8 h-8 flex items-center justify-center rounded-lg text-marino-700 hover:bg-hueso-200 text-xs font-semibold"><%= p %></a><%}%>
      <% } %>
      <% if (pagina < totalPaginas) { %>
        <a href="?q=<%= _fq %>&section_id=<%= _fg %>&anio_ingreso=<%= _fa %>&pagina=<%= pagina+1 %>&limit=<%= limit %>" class="w-8 h-8 flex items-center justify-center rounded-lg text-marino-600 hover:bg-hueso-200 text-sm"><i class="bi bi-chevron-right"></i></a>
      <% } %>
    </div>
    <% } else { %>
    <span></span>
    <% } %>
  </div>

  <% } %>
</div>

<%- include('../partials/import-modal', { modulo: 'alumnos', moduloLabel: 'Alumnos' }) %>

