<!-- Header -->
<div class="flex items-start sm:items-center justify-between gap-3 mb-6">
  <div class="min-w-0">
    <h1 class="text-xl font-semibold text-slate-900 truncate">Registro de alumnos</h1>
    <p class="text-sm text-slate-500 mt-0.5"><%= total %> alumno(s)</p>
  </div>
  <div class="flex gap-2 flex-shrink-0">
    <button type="button" onclick="document.getElementById('import-modal-alumnos').showModal()"
      class="inline-flex items-center gap-2 px-3 py-2 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition-colors">
      <i class="bi bi-file-earmark-excel"></i>
      <span class="hidden sm:inline">Importar</span>
    </button>
    <a href="/alumnos/crear" aria-label="Nuevo alumno"
      class="inline-flex items-center gap-2 px-3 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
      <i class="bi bi-person-plus"></i>
      <span class="hidden sm:inline">Nuevo alumno</span>
    </a>
  </div>
</div>

<!-- Filters -->
<div class="bg-white rounded-xl border border-slate-200/70 p-4 mb-5">
  <form method="GET" action="/alumnos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
    <div class="sm:col-span-2 lg:col-span-2">
      <div class="relative">
        <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
        <input type="text" name="q" value="<%= filtros.q || '' %>" placeholder="Nombre, apellido, CUI..."
          class="w-full h-10 pl-8 pr-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white focus:border-blue-400 transition-colors">
      </div>
    </div>
    <div>
      <select name="section_id" class="w-full h-10 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
        <option value="">Todos los grados</option>
        <% secciones.forEach(s => { %><option value="<%= s.id %>" <%= filtros.section_id == s.id ? 'selected' : '' %>><%= s.display_name || s.nombre %></option><% }) %>
      </select>
    </div>
    <div class="flex gap-2">
      <input type="number" name="anio_ingreso" placeholder="Año" value="<%= filtros.anio_ingreso || '' %>"
        class="flex-1 min-w-0 h-10 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white focus:border-blue-400 transition-colors">
      <button type="submit" class="h-10 px-4 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex-shrink-0" aria-label="Buscar">
        <i class="bi bi-search"></i>
      </button>
    </div>
  </form>
</div>

<!-- Table / Cards -->
<div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
  <% if (alumnos.length === 0) { %>
  <div class="py-16 text-center px-4">
    <i class="bi bi-people text-5xl text-slate-200 block mb-3"></i>
    <p class="text-sm text-slate-400">No se encontraron alumnos.</p>
  </div>
  <% } else { %>

  <!-- ── Desktop table (md+) ──────────────────────────── -->
  <div class="hidden md:block table-wrap">
    <table class="w-full text-sm">
      <thead class="bg-slate-50/80">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Alumno</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">CUI</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Grado</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Ingreso</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Encargado</th>
          <th class="px-4 py-3 w-16"></th>
        </tr>
      </thead>
      <tbody>
        <% alumnos.forEach(a => { %>
        <tr class="border-t border-slate-100 hover:bg-slate-50/60 transition-colors <%= !a.is_active ? 'opacity-60' : '' %>">
          <td class="px-5 py-3.5">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 text-xs font-bold
                <%= a.genero === 'M' ? 'bg-blue-100 text-blue-700' : a.genero === 'F' ? 'bg-pink-100 text-pink-700' : 'bg-slate-100 text-slate-600' %>">
                <%= (a.primer_nombre.charAt(0) + a.primer_apellido.charAt(0)).toUpperCase() %>
              </div>
              <div class="min-w-0">
                <div class="font-medium text-slate-800 truncate">
                  <%= a.primer_apellido %><% if (a.segundo_apellido) { %> <%= a.segundo_apellido %><% } %>,
                  <%= a.primer_nombre %><% if (a.segundo_nombre) { %> <%= a.segundo_nombre %><% } %>
                </div>
                <div class="text-xs text-slate-400">
                  <% if (!a.is_active) { %><span class="text-red-400 font-medium">Inactivo</span><% } else { %>
                  <%= a.genero === 'M' ? 'Masculino' : a.genero === 'F' ? 'Femenino' : '' %><% } %>
                </div>
              </div>
            </div>
          </td>
          <td class="px-4 py-3.5 text-slate-500 text-xs font-mono"><%= a.cui || '—' %></td>
          <td class="px-4 py-3.5 text-slate-500"><%= a.grado_nombre || '—' %></td>
          <td class="px-4 py-3.5 text-slate-600 font-medium"><%= a.anio_ingreso %></td>
          <td class="px-4 py-3.5">
            <div class="text-slate-600 text-sm"><%= a.nombre_encargado || '—' %></div>
            <% if (a.telefono_encargado) { %>
            <div class="text-xs text-slate-400"><%= a.telefono_encargado %></div>
            <% } %>
          </td>
          <td class="px-4 py-3.5 text-right">
            <div class="flex items-center justify-end gap-1">
              <a href="/alumnos/<%= a.id %>" aria-label="Ver alumno"
                class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors">
                <i class="bi bi-eye text-sm"></i>
              </a>
              <% if (can('students.create')) { %>
              <a href="/alumnos/<%= a.id %>/editar" aria-label="Editar alumno"
                class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors">
                <i class="bi bi-pencil text-sm"></i>
              </a>
              <form method="POST" action="/alumnos/<%= a.id %>/toggle">
                <button type="submit" aria-label="<%= a.is_active ? 'Desactivar' : 'Activar' %>"
                  class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-medium transition-colors
                    <%= a.is_active ? 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100' : 'bg-slate-100 text-slate-500 hover:bg-slate-200' %>">
                  <i class="bi bi-<%= a.is_active ? 'check-circle' : 'slash-circle' %> text-xs"></i>
                  <%= a.is_active ? 'Activo' : 'Inactivo' %>
                </button>
              </form>
              <% } %>
              <% if (can('students.delete')) { %>
              <div class="relative">
                <button data-dd-trigger aria-label="Más opciones"
                  class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors">
                  <i class="bi bi-three-dots text-sm"></i>
                </button>
                <div data-dd-menu class="dropdown-menu closed absolute right-0 top-full mt-1 w-36 bg-white rounded-xl border border-slate-200 shadow-lg p-1.5 z-20">
                  <form method="POST" action="/alumnos/<%= a.id %>/eliminar">
                    <button type="button" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-500 rounded-lg hover:bg-red-50 transition-colors"
                      data-confirm="¿Eliminar el registro de <%= a.primer_nombre %> <%= a.primer_apellido %>?">
                      <i class="bi bi-trash"></i> Eliminar
                    </button>
                  </form>
                </div>
              </div>
              <% } %>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- ── Mobile card list (< md) ──────────────────────── -->
  <div class="md:hidden divide-y divide-slate-100">
    <% alumnos.forEach(a => { %>
    <div class="px-4 py-3.5">
      <div class="flex items-start justify-between gap-2">
        <a href="/alumnos/<%= a.id %>" class="flex items-center gap-3 min-w-0 flex-1">
          <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 text-sm font-bold
            <%= a.genero === 'M' ? 'bg-blue-100 text-blue-700' : a.genero === 'F' ? 'bg-pink-100 text-pink-700' : 'bg-slate-100 text-slate-600' %>">
            <%= (a.primer_nombre.charAt(0) + a.primer_apellido.charAt(0)).toUpperCase() %>
          </div>
          <div class="min-w-0">
            <div class="font-medium text-slate-800 truncate">
              <%= a.primer_apellido %><% if (a.segundo_apellido) { %> <%= a.segundo_apellido %><% } %>,
              <%= a.primer_nombre %><% if (a.segundo_nombre) { %> <%= a.segundo_nombre %><% } %>
            </div>
            <div class="text-xs text-slate-500 mt-0.5">
              <%= a.genero === 'M' ? 'Masculino' : a.genero === 'F' ? 'Femenino' : 'Sin especificar' %>
            </div>
          </div>
        </a>
        <div class="flex items-center gap-0.5 flex-shrink-0">
          <a href="/alumnos/<%= a.id %>" aria-label="Ver alumno"
            class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors">
            <i class="bi bi-eye text-sm"></i>
          </a>
          <% if (can('students.delete')) { %>
          <div class="relative">
            <button data-dd-trigger aria-label="Más opciones"
              class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors">
              <i class="bi bi-three-dots text-sm"></i>
            </button>
            <div data-dd-menu class="dropdown-menu closed absolute right-0 top-full mt-1 w-36 bg-white rounded-xl border border-slate-200 shadow-lg p-1.5 z-20">
              <form method="POST" action="/alumnos/<%= a.id %>/eliminar">
                <button type="button" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-500 rounded-lg hover:bg-red-50 transition-colors"
                  data-confirm="¿Eliminar el registro de <%= a.primer_nombre %> <%= a.primer_apellido %>?">
                  <i class="bi bi-trash"></i> Eliminar
                </button>
              </form>
            </div>
          </div>
          <% } %>
        </div>
      </div>
      <div class="mt-2 ml-[52px] flex flex-wrap gap-x-3 gap-y-1">
        <% if (a.grado_nombre) { %><span class="text-xs text-slate-500"><i class="bi bi-mortarboard mr-0.5 text-[10px]"></i><%= a.grado_nombre %></span><% } %>
        <span class="text-xs text-slate-500">Ingreso <%= a.anio_ingreso %></span>
        <% if (a.nombre_encargado) { %><span class="text-xs text-slate-400 truncate"><i class="bi bi-person mr-0.5 text-[10px]"></i><%= a.nombre_encargado %></span><% } %>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Pagination bar -->
  <% const _fq = encodeURIComponent(filtros.q||''); const _fg = encodeURIComponent(filtros.section_id||''); const _fa = encodeURIComponent(filtros.anio_ingreso||''); %>
  <div class="flex items-center justify-between gap-3 px-4 py-3 border-t border-slate-100">
    <div class="flex items-center gap-2 text-xs text-slate-500">
      <span class="hidden sm:inline">Mostrar</span>
      <% [10, 20].forEach(n => { %>
        <a href="?q=<%= _fq %>&section_id=<%= _fg %>&anio_ingreso=<%= _fa %>&pagina=1&limit=<%= n %>"
          class="w-9 h-8 flex items-center justify-center rounded-lg border text-xs font-medium transition-colors
            <%= limit === n ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
          <%= n %>
        </a>
      <% }) %>
    </div>
    <% if (totalPaginas > 1) { %>
    <div class="flex items-center gap-1">
      <% if (pagina > 1) { %>
        <a href="?q=<%= _fq %>&section_id=<%= _fg %>&anio_ingreso=<%= _fa %>&pagina=<%= pagina-1 %>&limit=<%= limit %>" class="w-9 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 text-sm"><i class="bi bi-chevron-left"></i></a>
      <% } %>
      <% for(let p=1;p<=totalPaginas;p++){%>
        <% if(p===pagina){%><span class="w-9 h-8 flex items-center justify-center rounded-lg bg-blue-600 text-white text-sm font-medium"><%= p %></span>
        <%}else{%><a href="?q=<%= _fq %>&section_id=<%= _fg %>&anio_ingreso=<%= _fa %>&pagina=<%= p %>&limit=<%= limit %>" class="w-9 h-8 flex items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 text-sm"><%= p %></a><%}%>
      <% } %>
      <% if (pagina < totalPaginas) { %>
        <a href="?q=<%= _fq %>&section_id=<%= _fg %>&anio_ingreso=<%= _fa %>&pagina=<%= pagina+1 %>&limit=<%= limit %>" class="w-9 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 text-sm"><i class="bi bi-chevron-right"></i></a>
      <% } %>
    </div>
    <% } else { %>
    <span></span>
    <% } %>
  </div>

  <% } %>
</div>

<%- include('../partials/import-modal', { modulo: 'alumnos', moduloLabel: 'Alumnos' }) %>
