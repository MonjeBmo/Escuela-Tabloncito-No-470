<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div class="flex items-center gap-3">
    <a href="/ocr" class="w-9 h-9 flex items-center justify-center rounded-xl border border-hueso-300 bg-white text-marino-700 hover:bg-hueso-100 hover:border-marino-400 transition-all shadow-sm flex-shrink-0">
      <i class="bi bi-arrow-left text-sm font-bold"></i>
    </a>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <h1 class="text-xl font-bold font-serif text-marino-950 truncate">Revisión Humana — Digitalización #<%= job.id %></h1>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-ocre-100 text-ocre-800 border border-ocre-200">
          <i class="bi bi-person-check mr-1 text-[11px]"></i> Validación en curso
        </span>
      </div>
      <p class="text-xs text-marino-600/80 mt-0.5">Verifique y ajuste los campos detectados antes de indexar en el archivo oficial</p>
    </div>
  </div>

  <!-- Reprocesar -->
  <form method="POST" action="/ocr/revision/<%= job.id %>/reprocesar">
    <button type="submit"
      class="inline-flex items-center gap-2 px-3.5 py-2 bg-white border border-hueso-300 text-marino-800 text-xs font-semibold rounded-xl hover:bg-hueso-100 transition-all shadow-sm flex-shrink-0">
      <i class="bi bi-arrow-clockwise text-marino-600"></i>
      <span>Re-ejecutar OCR</span>
    </button>
  </form>
</div>

<!-- Layout: PDF izquierda + formulario derecha -->
<div class="flex flex-col xl:flex-row gap-6">

  <!-- ── Visor de documento (Capa 1) ─────────────────────────────── -->
  <div class="xl:w-[52%] xl:sticky xl:top-4 xl:self-start">
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-5 py-3.5 border-b border-hueso-200 bg-hueso-50/60 flex items-center justify-between">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-7 h-7 rounded-lg bg-ladrillo-100 text-ladrillo-700 flex items-center justify-center text-xs flex-shrink-0">
            <i class="bi bi-file-earmark-pdf"></i>
          </div>
          <span class="text-xs font-bold text-marino-950 truncate max-w-xs font-mono"><%= job.documento_nombre || job.documento_key %></span>
        </div>
        <% if (docUrl) { %>
        <a href="<%= docUrl %>" target="_blank"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-marino-700 hover:text-marino-900 bg-white border border-hueso-300 rounded-xl transition-all shadow-xs">
          <i class="bi bi-box-arrow-up-right"></i> Abrir en ventana
        </a>
        <% } %>
      </div>
      <% if (docUrl) { %>
      <iframe src="<%= docUrl %>#toolbar=1&navpanes=0"
        class="w-full border-0 bg-hueso-100"
        style="height: calc(100vh - 220px); min-height: 520px;"
        title="Vista previa del documento original">
      </iframe>
      <% } else { %>
      <div class="py-20 text-center">
        <i class="bi bi-file-earmark-x text-4xl text-marino-300 block mb-3"></i>
        <p class="text-xs text-marino-500">No se pudo cargar la vista previa del documento.</p>
      </div>
      <% } %>
    </div>
  </div>

  <!-- ── Formulario + panel lateral ──────────────────────────────── -->
  <div class="xl:flex-1 space-y-6">

    <!-- Campos extraídos -->
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-hueso-200 bg-hueso-50/50 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-marino-100 text-marino-700 flex items-center justify-center font-bold text-sm">
            <i class="bi bi-cpu"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-marino-950 font-serif">Campos Extraídos por IA</h2>
            <p class="text-[11px] text-marino-600/70">Revise y confirme la exactitud de cada dato</p>
          </div>
        </div>
      </div>

      <div class="px-6 pt-3.5 pb-2">
        <div class="p-3 rounded-xl bg-ocre-50/80 border border-ocre-200/60 flex items-start gap-2.5">
          <i class="bi bi-info-circle text-ocre-700 text-xs mt-0.5 flex-shrink-0"></i>
          <p class="text-[11px] text-ocre-900 leading-relaxed">
            Las barras de color representan el nivel de confianza algorítmica. Preste especial atención a campos con menor porcentaje.
          </p>
        </div>
      </div>

      <form method="POST" action="/ocr/revision/<%= job.id %>/validar" class="p-6 pt-3 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

          <!-- Código -->
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">
              Código de Cuadro <span class="text-ladrillo-600">*</span>
            </label>
            <input type="text" name="codigo" required
              value="<%= job.campos_extraidos.codigo || '' %>"
              class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 font-mono font-bold focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
            <% const confCodigo = (job.confianza.codigo || 0) * 100; %>
            <div class="confidence-bar mt-2"><div class="conf-fill" data-pct="<%= confCodigo.toFixed(0) %>"></div></div>
            <div class="flex items-center justify-between text-[11px] text-marino-500 mt-1 font-sans">
              <span>Confianza OCR</span>
              <span class="font-bold"><%= confCodigo.toFixed(0) %>%</span>
            </div>
          </div>

          <!-- Año -->
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">
              Año Lectivo <span class="text-ladrillo-600">*</span>
            </label>
            <input type="number" name="anio" required min="1990"
              value="<%= job.campos_extraidos.anio || new Date().getFullYear() %>"
              class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 font-bold focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
            <% const confAnio = (job.confianza.anio || 0) * 100; %>
            <div class="confidence-bar mt-2"><div class="conf-fill" data-pct="<%= confAnio.toFixed(0) %>"></div></div>
            <div class="flex items-center justify-between text-[11px] text-marino-500 mt-1 font-sans">
              <span>Confianza OCR</span>
              <span class="font-bold"><%= confAnio.toFixed(0) %>%</span>
            </div>
          </div>

          <!-- Grado -->
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Grado Correspondiente</label>
            <select name="grado_id"
              class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 px-3 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
              <option value="">Sin especificar</option>
              <% grados.forEach(g => { %>
              <option value="<%= g.id %>"
                <%= job.campos_extraidos.grado && job.campos_extraidos.grado.toLowerCase().includes(g.nombre.toLowerCase()) ? 'selected' : '' %>>
                <%= g.nombre %>
              </option>
              <% }) %>
            </select>
            <% const confGrado = (job.confianza.grado || 0) * 100; %>
            <div class="confidence-bar mt-2"><div class="conf-fill" data-pct="<%= confGrado.toFixed(0) %>"></div></div>
            <div class="flex items-center justify-between text-[11px] text-marino-500 mt-1 font-sans">
              <span>Confianza OCR</span>
              <span class="font-bold"><%= confGrado.toFixed(0) %>%</span>
            </div>
          </div>

          <!-- Total alumnos -->
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Total de Alumnos</label>
            <input type="number" name="total_alumnos" min="0"
              value="<%= job.campos_extraidos.total_alumnos || '' %>"
              class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
          </div>

          <!-- Docente -->
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Docente Registrado</label>
            <input type="text" name="docente"
              value="<%= job.campos_extraidos.docente || '' %>"
              class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
            <% const confDocente = (job.confianza.docente || 0) * 100; %>
            <div class="confidence-bar mt-2"><div class="conf-fill" data-pct="<%= confDocente.toFixed(0) %>"></div></div>
            <div class="flex items-center justify-between text-[11px] text-marino-500 mt-1 font-sans">
              <span>Confianza OCR</span>
              <span class="font-bold"><%= confDocente.toFixed(0) %>%</span>
            </div>
          </div>

          <!-- Notas -->
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Notas u Observaciones del Validador</label>
            <textarea name="notas" rows="2"
              placeholder="Observaciones de cotejo o corrección (opcional)"
              class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none resize-none"></textarea>
          </div>
        </div>

        <div class="pt-3">
          <button type="button"
            class="w-full h-11 bg-bosque-600 hover:bg-bosque-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2"
            data-confirm="¿Ratificar los datos revisados y oficializar el cuadro en el repositorio institucional?">
            <i class="bi bi-check2-circle text-base"></i> Validar y Guardar Cuadro Histórico
          </button>
        </div>
      </form>
    </div>

    <!-- Info del job -->
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-3.5 border-b border-hueso-200 bg-hueso-50/50">
        <h2 class="text-xs font-bold text-marino-600 uppercase tracking-wider">Metadatos del Trabajo</h2>
      </div>
      <dl class="divide-y divide-hueso-100">
        <div class="flex items-start px-6 py-3 text-xs">
          <dt class="font-bold text-marino-600 uppercase tracking-wider w-32 flex-shrink-0">Documento</dt>
          <dd class="text-marino-800 break-all font-mono"><%= job.documento_nombre || job.documento_key %></dd>
        </div>
        <div class="flex items-center px-6 py-3 text-xs">
          <dt class="font-bold text-marino-600 uppercase tracking-wider w-32 flex-shrink-0">Estado</dt>
          <dd>
            <% const estadoBadge = {pendiente:'bg-marino-50 text-marino-800 border border-marino-200',procesando:'bg-marino-100 text-marino-900 border border-marino-300',revision:'bg-ocre-100 text-ocre-800 border border-ocre-200',validado:'bg-bosque-100 text-bosque-800 border border-bosque-200',rechazado:'bg-ladrillo-100 text-ladrillo-800 border border-ladrillo-200'}; %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold <%= estadoBadge[job.estado] || 'bg-hueso-100 text-marino-700' %>">
              <%= job.estado %>
            </span>
          </dd>
        </div>
        <div class="flex items-center px-6 py-3 text-xs">
          <dt class="font-bold text-marino-600 uppercase tracking-wider w-32 flex-shrink-0">Fecha de Carga</dt>
          <dd class="text-marino-800"><%= new Date(job.created_at).toLocaleDateString('es-GT', {day:'2-digit',month:'long',year:'numeric'}) %></dd>
        </div>
      </dl>
    </div>

    <!-- Rechazar -->
    <div class="bg-white rounded-2xl border border-red-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-3.5 border-b border-red-100 bg-red-50/50">
        <h2 class="text-xs font-bold text-red-700 uppercase tracking-wider">Rechazar Documento</h2>
      </div>
      <form method="POST" action="/ocr/revision/<%= job.id %>/rechazar" class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Motivo del Rechazo</label>
          <textarea name="notas" rows="2"
            placeholder="Describa el motivo del rechazo (ej. documento ilegible, incompleto o no corresponde a cuadro PRIM)..."
            class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-red-400 transition-all outline-none resize-none"></textarea>
        </div>
        <button type="button"
          class="w-full h-10 bg-white border border-red-200 text-red-600 hover:bg-red-50 text-xs font-semibold rounded-xl transition-all flex items-center justify-center gap-2"
          data-confirm="¿Rechazar este documento OCR? No se creará ningún registro en el archivo de cuadros.">
          <i class="bi bi-x-circle text-sm"></i> Rechazar y Descartar Trabajo
        </button>
      </form>
    </div>

  </div><!-- fin formulario -->
</div>
