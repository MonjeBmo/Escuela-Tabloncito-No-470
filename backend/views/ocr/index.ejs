<!-- Header -->
<div class="flex items-start sm:items-center justify-between gap-3 mb-6">
  <div class="min-w-0">
    <h1 class="text-xl font-semibold text-slate-900 truncate">Digitalización OCR</h1>
    <p class="text-sm text-slate-500 mt-0.5">Reconocimiento óptico de caracteres</p>
  </div>
  <a href="/ocr/subir" aria-label="Subir documento"
    class="inline-flex items-center gap-2 px-3 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex-shrink-0">
    <i class="bi bi-cloud-upload"></i>
    <span class="hidden sm:inline">Subir documento</span>
  </a>
</div>

<!-- Stat cards -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
  <div class="bg-white rounded-xl border border-slate-200/70 p-4 flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center flex-shrink-0">
      <i class="bi bi-hourglass-split"></i>
    </div>
    <div class="min-w-0">
      <div class="text-2xl font-bold text-slate-900 leading-none"><%= conteo.revision || 0 %></div>
      <div class="text-xs text-slate-500 mt-1 truncate">En revisión</div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-slate-200/70 p-4 flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-500 flex items-center justify-center flex-shrink-0">
      <i class="bi bi-cpu"></i>
    </div>
    <div class="min-w-0">
      <div class="text-2xl font-bold text-slate-900 leading-none"><%= conteo.pendiente || 0 %></div>
      <div class="text-xs text-slate-500 mt-1 truncate">Pendientes</div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-slate-200/70 p-4 flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-500 flex items-center justify-center flex-shrink-0">
      <i class="bi bi-check-circle"></i>
    </div>
    <div class="min-w-0">
      <div class="text-2xl font-bold text-slate-900 leading-none"><%= conteo.validado || 0 %></div>
      <div class="text-xs text-slate-500 mt-1 truncate">Validados</div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-slate-200/70 p-4 flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-red-50 text-red-500 flex items-center justify-center flex-shrink-0">
      <i class="bi bi-x-circle"></i>
    </div>
    <div class="min-w-0">
      <div class="text-2xl font-bold text-slate-900 leading-none"><%= conteo.rechazado || 0 %></div>
      <div class="text-xs text-slate-500 mt-1 truncate">Rechazados</div>
    </div>
  </div>
</div>

<div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
  <% if (jobs.length === 0) { %>
  <div class="py-16 text-center px-4">
    <i class="bi bi-cpu text-5xl text-slate-200 block mb-3"></i>
    <p class="text-sm text-slate-400 mb-4">No hay trabajos OCR registrados.</p>
    <a href="/ocr/subir" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
      <i class="bi bi-cloud-upload"></i> Subir primer documento
    </a>
  </div>
  <% } else { %>
  <% const estadoBadge = {pendiente:'bg-blue-50 text-blue-700',procesando:'bg-violet-50 text-violet-700',revision:'bg-amber-50 text-amber-700',validado:'bg-emerald-50 text-emerald-700',rechazado:'bg-red-50 text-red-600',error:'bg-red-50 text-red-600'}; %>

  <!-- ── Desktop table (md+) ──────────────────────────── -->
  <div class="hidden md:block table-wrap">
    <table class="w-full text-sm">
      <thead class="bg-slate-50/80">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">#</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Documento</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Estado</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Subido por</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Fecha</th>
          <th class="px-4 py-3 w-28"></th>
        </tr>
      </thead>
      <tbody>
        <% jobs.forEach(j => { %>
        <tr class="border-t border-slate-100 hover:bg-slate-50/60 transition-colors">
          <td class="px-5 py-3.5 text-slate-400 text-xs font-mono">#<%= j.id %></td>
          <td class="px-4 py-3.5">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-violet-50 text-violet-600 flex items-center justify-center flex-shrink-0">
                <i class="bi bi-file-earmark-text text-sm"></i>
              </div>
              <span class="text-slate-700 text-xs max-w-[180px] truncate"><%= j.documento_nombre || j.documento_key %></span>
            </div>
          </td>
          <td class="px-4 py-3.5">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= estadoBadge[j.estado] || 'bg-slate-100 text-slate-600' %>">
              <%= j.estado %>
            </span>
          </td>
          <td class="px-4 py-3.5 text-slate-500 text-xs"><%= j.subido_por_nombre || '—' %></td>
          <td class="px-4 py-3.5 text-slate-500 text-xs"><%= new Date(j.created_at).toLocaleDateString('es-GT') %></td>
          <td class="px-4 py-3.5 text-right">
            <% if (j.estado === 'revision') { %>
            <a href="/ocr/revision/<%= j.id %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-500 text-white text-xs font-medium rounded-lg hover:bg-amber-600 transition-colors">
              <i class="bi bi-pencil-square"></i> Revisar
            </a>
            <% } else if (j.estado === 'validado' && j.cuadro_id) { %>
            <a href="/cuadros/<%= j.cuadro_id %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-600 text-xs font-medium rounded-lg hover:bg-slate-50 transition-colors">
              <i class="bi bi-eye"></i> Ver
            </a>
            <% } else { %>
            <span class="text-slate-300 text-xs">—</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- ── Mobile card list (< md) ──────────────────────── -->
  <div class="md:hidden divide-y divide-slate-100">
    <% jobs.forEach(j => { %>
    <div class="px-4 py-3.5">
      <div class="flex items-start justify-between gap-2">
        <div class="flex items-center gap-3 min-w-0 flex-1">
          <div class="w-10 h-10 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center flex-shrink-0">
            <i class="bi bi-file-earmark-text"></i>
          </div>
          <div class="min-w-0">
            <div class="text-sm font-medium text-slate-800 truncate"><%= j.documento_nombre || j.documento_key %></div>
            <div class="text-xs text-slate-500 mt-0.5"><%= new Date(j.created_at).toLocaleDateString('es-GT') %> · #<%= j.id %></div>
          </div>
        </div>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium flex-shrink-0 mt-0.5 <%= estadoBadge[j.estado] || 'bg-slate-100 text-slate-600' %>">
          <%= j.estado %>
        </span>
      </div>
      <% if (j.estado === 'revision' || (j.estado === 'validado' && j.cuadro_id)) { %>
      <div class="mt-2.5 ml-[52px]">
        <% if (j.estado === 'revision') { %>
        <a href="/ocr/revision/<%= j.id %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-500 text-white text-xs font-medium rounded-lg hover:bg-amber-600 transition-colors">
          <i class="bi bi-pencil-square"></i> Revisar documento
        </a>
        <% } else { %>
        <a href="/cuadros/<%= j.cuadro_id %>" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-600 text-xs font-medium rounded-lg hover:bg-slate-50 transition-colors">
          <i class="bi bi-eye"></i> Ver cuadro
        </a>
        <% } %>
      </div>
      <% } %>
    </div>
    <% }) %>
  </div>

  <!-- Pagination bar -->
  <% if (jobs.length > 0) { %>
  <div class="flex items-center justify-between gap-3 px-4 py-3 border-t border-slate-100">
    <div class="flex items-center gap-2 text-xs text-slate-500">
      <span class="hidden sm:inline">Mostrar</span>
      <% [10, 20].forEach(n => { %>
        <a href="?pagina=1&limit=<%= n %>"
          class="w-9 h-8 flex items-center justify-center rounded-lg border text-xs font-medium transition-colors
            <%= limit === n ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
          <%= n %>
        </a>
      <% }) %>
    </div>
    <% if (totalPaginas > 1) { %>
    <div class="flex items-center gap-1">
      <% if (pagina > 1) { %>
        <a href="?pagina=<%= pagina-1 %>&limit=<%= limit %>" class="w-9 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 text-sm"><i class="bi bi-chevron-left"></i></a>
      <% } %>
      <% for(let p=1;p<=totalPaginas;p++){%>
        <% if(p===pagina){%><span class="w-9 h-8 flex items-center justify-center rounded-lg bg-blue-600 text-white text-sm font-medium"><%= p %></span>
        <%}else{%><a href="?pagina=<%= p %>&limit=<%= limit %>" class="w-9 h-8 flex items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 text-sm"><%= p %></a><%}%>
      <% } %>
      <% if (pagina < totalPaginas) { %>
        <a href="?pagina=<%= pagina+1 %>&limit=<%= limit %>" class="w-9 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 text-sm"><i class="bi bi-chevron-right"></i></a>
      <% } %>
    </div>
    <% } else { %>
    <span></span>
    <% } %>
  </div>
  <% } %>

  <% } %>
</div>
