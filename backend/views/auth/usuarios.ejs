<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Gestión de usuarios</h1>
    <p class="text-sm text-slate-500 mt-0.5">Administre las cuentas de acceso al sistema</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <!-- Lista de usuarios (2/3) -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-800">Usuarios registrados</h2>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700"><%= usuarios.length %></span>
      </div>
      <% if (usuarios.length === 0) { %>
      <div class="py-16 text-center">
        <i class="bi bi-people text-5xl text-slate-200 block mb-3"></i>
        <p class="text-sm text-slate-400">No hay usuarios registrados.</p>
      </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[420px]">
          <thead class="bg-slate-50/80">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Nombre</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Usuario</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Rol</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Estado</th>
            </tr>
          </thead>
          <tbody>
            <% const rolColors = {director:'bg-purple-50 text-purple-700',administrativo:'bg-blue-50 text-blue-700',validador_ocr:'bg-amber-50 text-amber-700',docente:'bg-green-50 text-green-700'}; %>
            <% usuarios.forEach(u => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/60 transition-colors">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">
                    <%= u.nombre.charAt(0).toUpperCase() %>
                  </div>
                  <span class="font-medium text-slate-800"><%= u.nombre %></span>
                </div>
              </td>
              <td class="px-4 py-3.5 text-slate-500 text-xs font-mono">@<%= u.username %></td>
              <td class="px-4 py-3.5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= rolColors[u.rol] || 'bg-slate-100 text-slate-600' %>">
                  <%= u.rol %>
                </span>
              </td>
              <td class="px-4 py-3.5">
                <% if (u.activo) { %>
                <span class="inline-flex items-center gap-1.5 text-xs text-emerald-700">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Activo
                </span>
                <% } else { %>
                <span class="inline-flex items-center gap-1.5 text-xs text-red-600">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span> Inactivo
                </span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Crear usuario (1/3) -->
  <div>
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-800">Nuevo usuario</h2>
      </div>
      <form method="POST" action="/auth/usuarios" class="p-5 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre completo <span class="text-red-400">*</span></label>
          <input type="text" name="nombre" required
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre de usuario <span class="text-red-400">*</span></label>
          <input type="text" name="username" required autocomplete="off"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Contraseña inicial <span class="text-red-400">*</span></label>
          <input type="password" name="password" required minlength="8"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Rol <span class="text-red-400">*</span></label>
          <select name="rol" required
            class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
            <option value="docente">Docente</option>
            <option value="administrativo">Administrativo</option>
            <option value="validador_ocr">Validador OCR</option>
            <option value="director">Director</option>
          </select>
        </div>
        <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
          <i class="bi bi-person-plus"></i> Crear usuario
        </button>
      </form>
    </div>
  </div>

</div>
