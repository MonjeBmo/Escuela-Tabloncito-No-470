<div class="login-box">
  <div class="login-logo">
    <i class="bi bi-mortarboard-fill"></i>
  </div>
  <h1 class="login-title">Escuela El Tabloncito</h1>
  <p class="login-sub">No. 470 — Sistema de gestión documental</p>

  <% if (locals.flash) { %>
    <div class="flash-alert flash-<%= flash.tipo %>" style="margin-bottom:16px;">
      <i class="bi bi-exclamation-circle"></i> <%= flash.mensaje %>
    </div>
  <% } %>

  <form method="POST" action="/auth/login">
    <div class="mb-3">
      <label class="form-label fw-semibold" style="font-size:13px;">Usuario</label>
      <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
          <i class="bi bi-person text-muted"></i>
        </span>
        <input type="text" name="username" class="form-control border-start-0"
          placeholder="nombre.usuario" required autofocus autocomplete="username">
      </div>
    </div>
    <div class="mb-4">
      <label class="form-label fw-semibold" style="font-size:13px;">Contraseña</label>
      <div class="input-group">
        <span class="input-group-text bg-white border-end-0">
          <i class="bi bi-lock text-muted"></i>
        </span>
        <input type="password" name="password" class="form-control border-start-0"
          placeholder="••••••••" required autocomplete="current-password">
      </div>
    </div>
    <button type="submit" class="btn-primary-app w-100 justify-content-center" style="padding:10px;">
      <i class="bi bi-box-arrow-in-right"></i> Iniciar sesión
    </button>
  </form>
</div>
