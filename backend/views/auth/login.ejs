<%# login.ejs — visual only, backend/logic unchanged %>
<%# Illustrations: original SVGs inspired by unDraw editorial style (blue palette) %>

<div class="w-full max-w-5xl mx-auto">
  <div class="flex items-center justify-center gap-8 xl:gap-14">

    <!-- ── Decoración izquierda — estudio / lectura ─────────── -->
    <div class="hidden xl:flex flex-col items-center gap-6 w-52 flex-shrink-0 select-none" aria-hidden="true">

      <!-- Illustration: open book / studying -->
      <div class="opacity-90">
        <img src="/img/study.svg" alt="" width="180" height="153" class="drop-shadow-sm">
      </div>

      <!-- Small floating caption chip -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm px-4 py-2.5 text-center">
        <p class="text-xs font-semibold text-slate-700">Escuela El Tabloncito</p>
        <p class="text-[11px] text-slate-400 mt-0.5">Educación para todos</p>
      </div>

    </div>

    <!-- ── Tarjeta principal ─────────────────────────────────── -->
    <div class="w-full max-w-[440px] flex-shrink-0">

      <div class="bg-white rounded-3xl border border-slate-200/60 shadow-sm p-8 md:p-10">

        <!-- Encabezado -->
        <div class="text-center mb-8">
          <div class="w-12 h-12 bg-blue-600 rounded-2xl flex items-center justify-center shadow-sm shadow-blue-600/25 mx-auto mb-5">
            <i class="bi bi-mortarboard-fill text-white text-xl"></i>
          </div>
          <h1 class="text-2xl font-semibold tracking-tight text-slate-900 mb-1.5">Bienvenido de nuevo</h1>
          <p class="text-sm font-medium text-slate-700">Escuela El Tabloncito</p>
          <p class="text-sm text-slate-500 mt-0.5">No. 470 · Sistema de gestión documental</p>
        </div>

        <!-- Flash error -->
        <% if (locals.flash) { %>
        <div class="flex items-center gap-2.5 px-3.5 py-3 rounded-xl text-sm text-red-600 bg-red-50 border border-red-100 mb-6">
          <i class="bi bi-exclamation-circle flex-shrink-0"></i>
          <span><%= flash.mensaje %></span>
        </div>
        <% } %>

        <!-- Formulario -->
        <form method="POST" action="/auth/login" class="space-y-4">

          <!-- Usuario -->
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">
              Usuario
            </label>
            <div class="relative">
              <i class="bi bi-person absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
              <input type="text" name="username" required autofocus autocomplete="username"
                placeholder="nombre.usuario"
                class="w-full h-11 pl-10 pr-4 text-base rounded-xl border border-slate-200 bg-white text-slate-900 placeholder-slate-400 focus:border-blue-400 transition-all">
            </div>
          </div>

          <!-- Contraseña -->
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">
              Contraseña
            </label>
            <div class="relative">
              <i class="bi bi-lock absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
              <input type="password" id="pw-input" name="password" required autocomplete="current-password"
                placeholder="••••••••"
                class="w-full h-11 pl-10 pr-10 text-base rounded-xl border border-slate-200 bg-white text-slate-900 placeholder-slate-400 focus:border-blue-400 transition-all">
              <button type="button" id="toggle-pw" aria-label="Mostrar u ocultar contraseña"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 transition-colors p-1 rounded-lg hover:bg-slate-100">
                <i id="toggle-pw-icon" class="bi bi-eye text-sm"></i>
              </button>
            </div>
          </div>

          <!-- Botón -->
          <div class="pt-1">
            <button type="submit"
              class="w-full h-11 bg-blue-600 text-white text-sm font-medium rounded-xl hover:bg-blue-700 active:bg-blue-800 transition-all flex items-center justify-center gap-2">
              <i class="bi bi-box-arrow-in-right text-sm"></i>
              Iniciar sesión
            </button>
          </div>

        </form>
      </div>

      <p class="text-center text-xs text-slate-400 mt-5">
        Escuela El Tabloncito No. 470 &copy; <%= new Date().getFullYear() %>
      </p>
    </div>

    <!-- ── Decoración derecha — documentos / gestión ─────────── -->
    <div class="hidden xl:flex flex-col items-center gap-6 w-52 flex-shrink-0 select-none" aria-hidden="true">

      <!-- Small caption chip -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm px-4 py-2.5 text-center">
        <p class="text-xs font-semibold text-slate-700">Gestión documental</p>
        <p class="text-[11px] text-slate-400 mt-0.5">Cuadros PRIM digitalizados</p>
      </div>

      <!-- Illustration: documents / digital management -->
      <div class="opacity-90">
        <img src="/img/documents.svg" alt="" width="180" height="153" class="drop-shadow-sm">
      </div>

    </div>

  </div>
</div>
