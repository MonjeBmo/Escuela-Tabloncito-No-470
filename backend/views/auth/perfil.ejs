<div class="flex items-center gap-3 mb-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Mi perfil</h1>
    <p class="text-sm text-slate-500 mt-0.5">Información de su cuenta y cambio de contraseña</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <!-- Datos de cuenta -->
  <div class="lg:col-span-1">
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-800">Datos de cuenta</h2>
      </div>
      <div class="p-5">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-14 h-14 rounded-2xl bg-blue-600 text-white flex items-center justify-center text-xl font-bold flex-shrink-0">
            <%= usuario.nombre.charAt(0).toUpperCase() %>
          </div>
          <div>
            <div class="font-semibold text-slate-900 text-base"><%= usuario.nombre %></div>
            <div class="text-sm text-slate-400 mt-0.5">@<%= usuario.username %></div>
          </div>
        </div>
        <dl class="space-y-3">
          <div>
            <dt class="text-xs text-slate-400 mb-0.5">Rol</dt>
            <dd>
              <% const rolColors = {director:'bg-purple-50 text-purple-700',administrativo:'bg-blue-50 text-blue-700',validador_ocr:'bg-amber-50 text-amber-700',docente:'bg-green-50 text-green-700'}; %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= rolColors[usuario.rol] || 'bg-slate-100 text-slate-600' %>">
                <%= usuario.rol %>
              </span>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <!-- Cambiar contraseña -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-hueso-200 bg-hueso-50/50 flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-marino-100 text-marino-700 flex items-center justify-center font-bold text-sm">
          <i class="bi bi-key"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-marino-950 font-serif">Cambiar Contraseña</h2>
          <p class="text-[11px] text-marino-600/70">Actualizar clave de acceso personal</p>
        </div>
      </div>
      <form method="POST" action="/auth/perfil" class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">
            Contraseña Actual <span class="text-ladrillo-600">*</span>
          </label>
          <input type="password" name="old_password" required placeholder="Ingrese su clave actual"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">
            Nueva Contraseña <span class="text-ladrillo-600">*</span>
          </label>
          <input type="password" name="new_password" required minlength="8" placeholder="Mínimo 8 caracteres"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
          <p class="text-[11px] text-marino-500 mt-1">Mínimo 8 caracteres con letras y números.</p>
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">
            Confirmar Nueva Contraseña <span class="text-ladrillo-600">*</span>
          </label>
          <input type="password" name="new_password_confirm" required minlength="8" placeholder="Repita la nueva contraseña"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <div class="pt-2">
          <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 bg-marino-700 hover:bg-marino-800 text-white text-xs font-semibold rounded-xl shadow-xs transition-all">
            <i class="bi bi-floppy"></i> Guardar Nueva Contraseña
          </button>
        </div>
      </form>
    </div>
  </div>

</div>
