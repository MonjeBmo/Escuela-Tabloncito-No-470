<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-bold font-serif text-marino-950">Gestión de Usuarios</h1>
    <p class="text-xs text-marino-600/80 mt-0.5">Administración de cuentas y credenciales de acceso institucional</p>
  </div>
  <button type="button" onclick="document.getElementById('import-modal-usuarios').showModal()"
    class="inline-flex items-center gap-2 px-3.5 py-2 bg-bosque-600 hover:bg-bosque-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all">
    <i class="bi bi-file-earmark-spreadsheet text-sm"></i>
    <span>Importar Usuarios</span>
  </button>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Lista de usuarios (2/3) -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-hueso-200 bg-hueso-50/50 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-marino-100 text-marino-700 flex items-center justify-center font-bold text-sm">
            <i class="bi bi-people"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-marino-950 font-serif">Usuarios Registrados</h2>
            <p class="text-[11px] text-marino-600/70">Personal con credenciales activas</p>
          </div>
        </div>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-marino-100 text-marino-800 border border-marino-200">
          <%= usuarios.length %> cuentas
        </span>
      </div>
      <% if (usuarios.length === 0) { %>
      <div class="py-16 text-center">
        <div class="w-14 h-14 rounded-2xl bg-hueso-100 text-marino-300 flex items-center justify-center mx-auto mb-3">
          <i class="bi bi-people text-2xl"></i>
        </div>
        <p class="text-xs text-marino-500">No hay usuarios registrados.</p>
      </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[480px]">
          <thead class="bg-hueso-100/60 border-b border-hueso-200 text-marino-700">
            <tr>
              <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Nombre Completo</th>
              <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Usuario</th>
              <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Rol Asignado</th>
              <th class="px-6 py-3.5 text-right text-xs font-bold uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hueso-100">
            <% const rolColors = {
              director: 'bg-ladrillo-100 text-ladrillo-800 border border-ladrillo-200',
              administrativo: 'bg-marino-100 text-marino-800 border border-marino-200',
              validador_ocr: 'bg-ocre-100 text-ocre-800 border border-ocre-200',
              docente: 'bg-bosque-100 text-bosque-800 border border-bosque-200'
            }; %>
            <% usuarios.forEach(u => { %>
            <tr class="hover:bg-hueso-50/50 transition-colors">
              <td class="px-6 py-3.5">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-xl bg-marino-700 text-white flex items-center justify-center text-xs font-bold font-serif flex-shrink-0 shadow-xs">
                    <%= u.nombre.charAt(0).toUpperCase() %>
                  </div>
                  <span class="font-bold text-marino-950 text-xs"><%= u.nombre %></span>
                </div>
              </td>
              <td class="px-4 py-3.5 text-marino-600 text-xs font-mono">@<%= u.username %></td>
              <td class="px-4 py-3.5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold <%= rolColors[u.rol] || 'bg-hueso-200 text-marino-700' %>">
                  <%= u.rol || '—' %>
                </span>
              </td>
              <td class="px-6 py-3.5">
                <div class="flex items-center justify-end gap-2">
                  <% if (u.username !== 'admin') { %>
                  <button type="button" onclick="toggleEdit('usuario-<%= u.id %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl border border-hueso-300 bg-white text-marino-700 hover:bg-hueso-100 transition-all shadow-xs">
                    <i class="bi bi-pencil text-bosque-600"></i> Editar
                  </button>
                  <form method="POST" action="/admin/usuarios/<%= u.id %>/toggle">
                    <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl border transition-all shadow-xs
                      <%= u.activo ? 'border-bosque-200 bg-bosque-50 text-bosque-700 hover:bg-bosque-100' : 'border-red-200 bg-red-50 text-red-600 hover:bg-red-100' %>">
                      <i class="bi bi-toggle-<%= u.activo ? 'on' : 'off' %>"></i>
                      <%= u.activo ? 'Activo' : 'Inactivo' %>
                    </button>
                  </form>
                  <% } else { %>
                  <span class="text-xs text-marino-400 italic font-mono">protegido</span>
                  <% } %>
                </div>
              </td>
            </tr>
            <% if (u.username !== 'admin') { %>
            <tr id="edit-row-usuario-<%= u.id %>" class="hidden bg-hueso-100/60 border-t border-hueso-200">
              <td colspan="4" class="px-6 py-4">
                <form method="POST" action="/admin/usuarios/<%= u.id %>" class="flex flex-wrap items-end gap-3">
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Nombre Completo</label>
                    <input type="text" name="nombre" value="<%= u.nombre %>" required
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-48 outline-none">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Rol</label>
                    <select name="role_id" class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-900 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-36 outline-none">
                      <% roles.forEach(r => { %>
                      <option value="<%= r.id %>" <%= u.role_id === r.id ? 'selected' : '' %>><%= r.nombre %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Nueva Contraseña <span class="text-marino-400 normal-case font-normal">(opcional)</span></label>
                    <input type="password" name="password" minlength="8" placeholder="Dejar en blanco para no cambiar"
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 placeholder-marino-300 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-56 outline-none">
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="submit" class="h-10 px-4 bg-marino-700 hover:bg-marino-800 text-white text-xs font-semibold rounded-xl shadow-xs transition-all">Guardar</button>
                    <button type="button" onclick="toggleEdit('usuario-<%= u.id %>')"
                      class="h-10 px-3 text-xs text-marino-600 rounded-xl hover:bg-hueso-200 transition-colors">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
            <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/admin-pagination', { pagina, totalPaginas, total, limit, baseUrl: '/admin/usuarios' }) %>
      <% } %>
    </div>
  </div>

  <!-- Crear usuario (1/3) -->
  <div>
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-hueso-200 bg-hueso-50/50 flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-bosque-100 text-bosque-700 flex items-center justify-center font-bold text-sm">
          <i class="bi bi-person-plus"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-marino-950 font-serif">Nuevo Usuario</h2>
          <p class="text-[11px] text-marino-600/70">Registrar cuenta de acceso</p>
        </div>
      </div>
      <form method="POST" action="/admin/usuarios" class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Nombre Completo <span class="text-ladrillo-600">*</span></label>
          <input type="text" name="nombre" required placeholder="Nombre del colaborador"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Nombre de Usuario <span class="text-ladrillo-600">*</span></label>
          <input type="text" name="username" required autocomplete="off" placeholder="ej. jdoe"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none font-mono">
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Contraseña Inicial <span class="text-ladrillo-600">*</span></label>
          <input type="password" name="password" required minlength="8" placeholder="Mínimo 8 caracteres"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Rol de Sistema <span class="text-ladrillo-600">*</span></label>
          <select name="role_id" required
            class="w-full h-10 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 px-3 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
            <% roles.forEach(r => { %>
            <option value="<%= r.id %>"><%= r.nombre %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="w-full h-11 bg-marino-700 hover:bg-marino-800 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2">
          <i class="bi bi-person-check text-sm"></i> Crear Usuario
        </button>
      </form>
    </div>
  </div>

</div>

<script>
function toggleEdit(key) {
  const row = document.getElementById('edit-row-' + key);
  if (row) row.classList.toggle('hidden');
}
</script>

<%- include('../partials/import-modal', { modulo: 'usuarios', moduloLabel: 'Usuarios' }) %>
