<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Gestión de usuarios</h1>
    <p class="text-sm text-slate-500 mt-0.5">Administre las cuentas de acceso al sistema</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <!-- Lista de usuarios (2/3) -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-800">Usuarios registrados</h2>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700"><%= usuarios.length %></span>
      </div>
      <% if (usuarios.length === 0) { %>
      <div class="py-16 text-center">
        <i class="bi bi-people text-5xl text-slate-200 block mb-3"></i>
        <p class="text-sm text-slate-400">No hay usuarios registrados.</p>
      </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[480px]">
          <thead class="bg-slate-50/80">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Nombre</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Usuario</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Rol</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wide">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% const rolColors = {director:'bg-purple-50 text-purple-700',administrativo:'bg-blue-50 text-blue-700',validador_ocr:'bg-amber-50 text-amber-700',docente:'bg-green-50 text-green-700'}; %>
            <% usuarios.forEach(u => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/40 transition-colors">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">
                    <%= u.nombre.charAt(0).toUpperCase() %>
                  </div>
                  <span class="font-medium text-slate-800"><%= u.nombre %></span>
                </div>
              </td>
              <td class="px-4 py-3.5 text-slate-500 text-xs font-mono">@<%= u.username %></td>
              <td class="px-4 py-3.5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= rolColors[u.rol] || 'bg-slate-100 text-slate-600' %>">
                  <%= u.rol || '—' %>
                </span>
              </td>
              <td class="px-4 py-3.5">
                <div class="flex items-center justify-end gap-2">
                  <% if (u.username !== 'admin') { %>
                  <button type="button" onclick="toggleEdit('usuario-<%= u.id %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors">
                    <i class="bi bi-pencil"></i> Editar
                  </button>
                  <form method="POST" action="/admin/usuarios/<%= u.id %>/toggle">
                    <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors
                      <%= u.activo ? 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' : 'border-red-200 bg-red-50 text-red-600 hover:bg-red-100' %>">
                      <i class="bi bi-toggle-<%= u.activo ? 'on' : 'off' %>"></i>
                      <%= u.activo ? 'Activo' : 'Inactivo' %>
                    </button>
                  </form>
                  <% } else { %>
                  <span class="text-xs text-slate-400 italic">cuenta protegida</span>
                  <% } %>
                </div>
              </td>
            </tr>
            <% if (u.username !== 'admin') { %>
            <tr id="edit-row-usuario-<%= u.id %>" class="hidden bg-blue-50/40 border-t border-blue-100">
              <td colspan="4" class="px-5 py-4">
                <form method="POST" action="/admin/usuarios/<%= u.id %>" class="flex flex-wrap items-end gap-3">
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Nombre completo</label>
                    <input type="text" name="nombre" value="<%= u.nombre %>" required
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-48">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Rol</label>
                    <select name="role_id" class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-700 focus:border-blue-400 w-36">
                      <% roles.forEach(r => { %>
                      <option value="<%= r.id %>" <%= u.role_id === r.id ? 'selected' : '' %>><%= r.nombre %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Nueva contraseña <span class="text-slate-400 normal-case font-normal">(opcional)</span></label>
                    <input type="password" name="password" minlength="8" placeholder="dejar vacío para no cambiar"
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-52">
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="submit" class="h-9 px-4 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">Guardar</button>
                    <button type="button" onclick="toggleEdit('usuario-<%= u.id %>')"
                      class="h-9 px-3 text-sm text-slate-500 rounded-lg hover:bg-slate-100 transition-colors">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
            <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Crear usuario (1/3) -->
  <div>
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-800">Nuevo usuario</h2>
      </div>
      <form method="POST" action="/admin/usuarios" class="p-5 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre completo <span class="text-red-400">*</span></label>
          <input type="text" name="nombre" required
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre de usuario <span class="text-red-400">*</span></label>
          <input type="text" name="username" required autocomplete="off"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Contraseña inicial <span class="text-red-400">*</span></label>
          <input type="password" name="password" required minlength="8"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Rol <span class="text-red-400">*</span></label>
          <select name="role_id" required
            class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
            <% roles.forEach(r => { %>
            <option value="<%= r.id %>"><%= r.nombre %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
          <i class="bi bi-person-plus"></i> Crear usuario
        </button>
      </form>
    </div>
  </div>

</div>

<script>
function toggleEdit(key) {
  const row = document.getElementById('edit-row-' + key);
  if (row) row.classList.toggle('hidden');
}
</script>
