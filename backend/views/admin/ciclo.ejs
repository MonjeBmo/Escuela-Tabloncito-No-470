<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-bold font-serif text-marino-950">Promoción de Ciclo Escolar</h1>
    <p class="text-xs text-marino-600/80 mt-0.5">Avance general de estudiantes al siguiente grado académico para el nuevo ciclo lectivo</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Preview table (2/3) -->
  <div class="lg:col-span-2 space-y-4">
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-4 bg-hueso-50/50 border-b border-hueso-200 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-marino-100 text-marino-700 flex items-center justify-center font-bold text-sm">
            <i class="bi bi-arrow-up-circle"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-marino-950 font-serif">Vista Previa de la Promoción</h2>
            <p class="text-[11px] text-marino-600/70">Cálculo de transiciones de grado</p>
          </div>
        </div>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-marino-100 text-marino-800 border border-marino-200 font-mono">
          <%= preview.total %> alumnos
        </span>
      </div>
      <% if (preview.porGrado.length === 0) { %>
      <div class="py-14 text-center px-4">
        <div class="w-14 h-14 rounded-2xl bg-hueso-100 text-marino-300 flex items-center justify-center mx-auto mb-3">
          <i class="bi bi-people text-2xl"></i>
        </div>
        <p class="text-xs text-marino-500">No hay alumnos con sección asignada para promover.</p>
      </div>
      <% } else { %>
      <table class="w-full text-sm">
        <thead class="bg-hueso-100/60 border-b border-hueso-200 text-marino-700">
          <tr>
            <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Ubicación Actual</th>
            <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Estudiantes</th>
            <th class="px-6 py-3.5 text-right text-xs font-bold uppercase tracking-wider">Destino en Nuevo Ciclo</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hueso-100">
          <% preview.porGrado.forEach(row => { %>
          <tr class="hover:bg-hueso-50/50 transition-colors">
            <td class="px-6 py-3.5">
              <span class="font-bold text-marino-950 text-xs"><%= row.grade_nombre %></span>
              <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-lg bg-hueso-200 text-marino-800 text-[11px] font-bold border border-hueso-300"><%= row.section_nombre %></span>
            </td>
            <td class="px-4 py-3.5 text-marino-900 font-bold text-xs"><%= row.count %> estudiantes</td>
            <td class="px-6 py-3.5 text-right">
              <% if (row.siguiente === 'Egresado') { %>
              <span class="inline-flex items-center gap-1.5 text-xs font-bold text-ocre-800 bg-ocre-100 px-3 py-1 rounded-full border border-ocre-200">
                <i class="bi bi-mortarboard text-sm"></i> Egresado Institucional
              </span>
              <% } else if (row.siguiente) { %>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-bosque-800 bg-bosque-50 px-3 py-1 rounded-full border border-bosque-200">
                <i class="bi bi-arrow-right text-xs text-bosque-600"></i> <%= row.siguiente %>
              </span>
              <% } else { %>
              <span class="text-xs text-marino-400 italic">Sin sección destino</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
          <% if (preview.sinSeccion > 0) { %>
          <tr class="bg-ocre-50/40 border-t border-ocre-100">
            <td class="px-6 py-3.5 text-ocre-900 font-medium text-xs italic">Sin sección asignada</td>
            <td class="px-4 py-3.5 text-ocre-900 font-bold text-xs"><%= preview.sinSeccion %></td>
            <td class="px-6 py-3.5 text-right text-xs text-ocre-700">Se mantienen sin cambios</td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <!-- Action panel (1/3) -->
  <div class="space-y-5">
    <div class="bg-white rounded-2xl border border-hueso-200/80 p-6 shadow-sm">
      <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-hueso-100">
        <div class="w-8 h-8 rounded-lg bg-ladrillo-100 text-ladrillo-700 flex items-center justify-center font-bold text-sm">
          <i class="bi bi-calendar-event"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-marino-950 font-serif">Ejecutar Promoción</h2>
          <p class="text-[11px] text-marino-600/70">Apertura del nuevo ciclo</p>
        </div>
      </div>
      <p class="text-xs text-marino-600/90 mb-5 leading-relaxed">
        Esta acción promoverá a <strong class="text-marino-950 font-bold"><%= preview.total - preview.sinSeccion %> estudiantes</strong>
        al grado superior inmediato. Los alumnos de sexto primaria pasarán al estado de egresados.
      </p>

      <% if (preview.porGrado.length === 0) { %>
      <div class="p-3.5 rounded-xl bg-hueso-100 border border-hueso-200 text-xs text-marino-500 text-center">
        No hay alumnos para promover.
      </div>
      <% } else { %>
      <button type="button" onclick="document.getElementById('confirm-rollover').showModal()"
        class="w-full h-11 bg-ladrillo-600 hover:bg-ladrillo-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2">
        <i class="bi bi-arrow-up-circle text-base"></i> Iniciar Promoción General
      </button>
      <% } %>
    </div>

    <div class="bg-ocre-50/80 border border-ocre-200/80 rounded-2xl p-5 shadow-xs">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-ocre-100 text-ocre-800 flex items-center justify-center flex-shrink-0 mt-0.5">
          <i class="bi bi-exclamation-triangle text-sm"></i>
        </div>
        <div class="text-xs text-ocre-900 leading-relaxed space-y-1.5">
          <p class="font-bold font-serif text-sm">Puntos de Control Previos</p>
          <ul class="list-disc list-inside space-y-1 text-ocre-800 ml-0.5 text-[11px]">
            <li>Verificar que las notas del ciclo actual estén validadas.</li>
            <li>Comprobar que las secciones del nuevo ciclo estén creadas.</li>
            <li>Esta operación institucional es permanente.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

</div>

<!-- Confirm dialog -->
<dialog id="confirm-rollover"
  class="w-full max-w-md rounded-2xl shadow-2xl border border-hueso-300 p-0 backdrop:bg-marino-950/60 backdrop:backdrop-blur-sm bg-white overflow-hidden">
  <div class="p-6">
    <div class="flex items-center gap-3.5 mb-4">
      <div class="w-12 h-12 rounded-xl bg-ocre-100 text-ocre-700 flex items-center justify-center flex-shrink-0 text-xl font-bold">
        <i class="bi bi-exclamation-triangle"></i>
      </div>
      <div>
        <h3 class="text-sm font-bold font-serif text-marino-950">Confirmar Promoción de Ciclo</h3>
        <p class="text-[11px] text-marino-600/80">Esta acción modificará las asignaciones de grado</p>
      </div>
    </div>
    <p class="text-xs text-marino-700 mb-6 leading-relaxed bg-hueso-50 p-3.5 rounded-xl border border-hueso-200">
      ¿Está completamente seguro de promover a <strong><%= preview.total - preview.sinSeccion %> alumnos</strong> al siguiente grado?
      Los alumnos del último grado quedarán catalogados como egresados.
    </p>
    <div class="flex items-center gap-3">
      <form method="POST" action="/admin/ciclo/promover" class="flex-1">
        <button type="submit"
          class="w-full h-11 bg-ladrillo-600 hover:bg-ladrillo-700 text-white text-xs font-semibold rounded-xl transition-all shadow-sm">
          Sí, ejecutar promoción
        </button>
      </form>
      <button type="button" onclick="document.getElementById('confirm-rollover').close()"
        class="flex-1 h-11 bg-white border border-hueso-300 text-marino-700 text-xs font-semibold rounded-xl hover:bg-hueso-100 transition-all shadow-xs">
        Cancelar
      </button>
    </div>
  </div>
</dialog>
