<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Maestros</h1>
    <p class="text-sm text-slate-500 mt-0.5">Registro de docentes y asignaciones por sección</p>
  </div>
  <div class="flex gap-2">
    <button type="button" onclick="document.getElementById('import-modal-maestros').showModal()"
      class="inline-flex items-center gap-1.5 px-3 py-2 bg-green-600 text-white text-xs font-medium rounded-lg hover:bg-green-700 transition-colors">
      <i class="bi bi-file-earmark-excel"></i>
      <span class="hidden sm:inline">Importar maestros</span>
    </button>
    <button type="button" onclick="document.getElementById('import-modal-asignaciones').showModal()"
      class="inline-flex items-center gap-1.5 px-3 py-2 bg-green-600 text-white text-xs font-medium rounded-lg hover:bg-green-700 transition-colors">
      <i class="bi bi-file-earmark-excel"></i>
      <span class="hidden sm:inline">Importar asignaciones</span>
    </button>
  </div>
</div>

<!-- Tabs -->
<div class="flex border-b border-slate-200 mb-5">
  <button type="button" data-tab="lista"
    class="tab-btn px-4 py-2.5 text-sm font-medium text-blue-600 border-b-2 border-blue-600 -mb-px">
    Maestros
  </button>
  <button type="button" data-tab="asignaciones"
    class="tab-btn px-4 py-2.5 text-sm font-medium text-slate-500 hover:text-slate-700 border-b-2 border-transparent -mb-px transition-colors">
    Asignaciones
  </button>
  <button type="button" data-tab="nueva-asignacion"
    class="tab-btn px-4 py-2.5 text-sm font-medium text-slate-500 hover:text-slate-700 border-b-2 border-transparent -mb-px transition-colors">
    Nueva asignación
  </button>
</div>

<!-- ── Lista de maestros ─────────────────────────────────────── -->
<div id="tab-lista" class="grid grid-cols-1 lg:grid-cols-3 gap-5">
  <div class="lg:col-span-2 space-y-4">
    <!-- Buscador -->
    <form method="GET" action="/admin/maestros" class="flex gap-2">
      <div class="relative flex-1">
        <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
        <input type="text" name="q" value="<%= q %>" placeholder="Buscar por nombre, correo o teléfono..."
          class="w-full h-9 pl-9 pr-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 transition-colors">
      </div>
      <button type="submit" class="h-9 px-4 bg-slate-100 text-slate-600 text-sm font-medium rounded-lg hover:bg-slate-200 transition-colors">
        Buscar
      </button>
      <% if (q) { %>
      <a href="/admin/maestros" class="h-9 px-3 flex items-center text-sm text-slate-400 rounded-lg hover:bg-slate-100 transition-colors">
        <i class="bi bi-x-lg"></i>
      </a>
      <% } %>
    </form>

    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <% if (teachers.length === 0) { %>
      <div class="py-14 text-center px-4">
        <i class="bi bi-person-workspace text-4xl text-slate-200 block mb-3"></i>
        <p class="text-sm text-slate-400"><%= q ? 'Sin resultados para "' + q + '".' : 'No hay maestros registrados.' %></p>
      </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[520px]">
          <thead class="bg-slate-50/80">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Nombre</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Contacto</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wide">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% teachers.forEach(t => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/40 transition-colors">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold flex-shrink-0">
                    <%= t.full_name.charAt(0).toUpperCase() %>
                  </div>
                  <div class="min-w-0">
                    <div class="font-medium text-slate-800 truncate"><%= t.full_name %></div>
                    <% if (t.username) { %><div class="text-xs text-slate-400">@<%= t.username %></div><% } %>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3.5">
                <% if (t.email) { %><div class="text-xs text-slate-600 truncate max-w-[150px]"><i class="bi bi-envelope mr-1 text-slate-300"></i><%= t.email %></div><% } %>
                <% if (t.phone) { %><div class="text-xs text-slate-400"><i class="bi bi-telephone mr-1 text-slate-300"></i><%= t.phone %></div><% } %>
                <% if (!t.email && !t.phone) { %><span class="text-slate-300 text-xs">—</span><% } %>
              </td>
              <td class="px-4 py-3.5">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick="toggleEdit('maestro-<%= t.id %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors">
                    <i class="bi bi-pencil"></i> Editar
                  </button>
                  <form method="POST" action="/admin/maestros/<%= t.id %>/toggle">
                    <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors
                      <%= t.is_active ? 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' : 'border-slate-200 bg-slate-50 text-slate-500 hover:bg-slate-100' %>">
                      <i class="bi bi-toggle-<%= t.is_active ? 'on' : 'off' %>"></i>
                      <%= t.is_active ? 'Activo' : 'Inactivo' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <tr id="edit-row-maestro-<%= t.id %>" class="hidden bg-blue-50/40 border-t border-blue-100">
              <td colspan="3" class="px-5 py-4">
                <form method="POST" action="/admin/maestros/<%= t.id %>" class="flex flex-wrap items-end gap-3">
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Nombre completo</label>
                    <input type="text" name="full_name" value="<%= t.full_name %>" required
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-48">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Correo</label>
                    <input type="email" name="email" value="<%= t.email || '' %>"
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-44">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Teléfono</label>
                    <input type="tel" name="phone" value="<%= t.phone || '' %>" placeholder="####-####"
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-32">
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="submit" class="h-9 px-4 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">Guardar</button>
                    <button type="button" onclick="toggleEdit('maestro-<%= t.id %>')"
                      class="h-9 px-3 text-sm text-slate-500 rounded-lg hover:bg-slate-100 transition-colors">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/admin-pagination', { pagina: paginaT, totalPaginas: totalPaginasT, total: totalTeachers, limit, baseUrl: '/admin/maestros' + (q ? '?q=' + encodeURIComponent(q) : ''), pageParam: 'pt' }) %>
      <% } %>
    </div>
  </div>

  <div>
    <div class="bg-white rounded-xl border border-slate-200/70 p-5">
      <h2 class="text-sm font-semibold text-slate-800 mb-4">Registrar maestro</h2>
      <form method="POST" action="/admin/maestros" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre completo <span class="text-red-400">*</span></label>
          <input type="text" name="full_name" required
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Correo electrónico</label>
          <input type="email" name="email"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Teléfono</label>
          <input type="tel" name="phone" placeholder="####-####"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
          <i class="bi bi-person-plus"></i> Registrar maestro
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ── Asignaciones ──────────────────────────────────────────── -->
<div id="tab-asignaciones" class="hidden">
  <% if (totalAssignments === 0) { %>
  <div class="bg-white rounded-xl border border-slate-200/70 py-16 text-center">
    <i class="bi bi-calendar2-check text-4xl text-slate-200 block mb-3"></i>
    <p class="text-sm text-slate-400">No hay asignaciones registradas.</p>
  </div>
  <% } else { %>
  <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
    <div class="px-5 py-3 bg-slate-50/80 border-b border-slate-100 flex items-center gap-2">
      <i class="bi bi-calendar2-check text-slate-400 text-sm"></i>
      <span class="text-sm font-semibold text-slate-700">Asignaciones docentes</span>
      <span class="ml-auto inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700"><%= totalAssignments %></span>
    </div>
    <div class="table-wrap">
      <table class="w-full text-sm min-w-[560px]">
        <thead class="bg-slate-50/50">
          <tr>
            <th class="px-5 py-2.5 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Maestro</th>
            <th class="px-4 py-2.5 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Curso</th>
            <th class="px-4 py-2.5 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Grado / Sección</th>
            <th class="px-4 py-2.5 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Año</th>
            <th class="px-4 py-2.5 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Estado</th>
          </tr>
        </thead>
        <tbody>
          <% assignments.forEach(a => { %>
          <tr class="border-t border-slate-100 hover:bg-slate-50/40 transition-colors">
            <td class="px-5 py-3 font-medium text-slate-800"><%= a.teacher_name %></td>
            <td class="px-4 py-3 text-slate-600 text-sm"><%= a.course_nombre %></td>
            <td class="px-4 py-3">
              <span class="text-slate-700 text-xs"><%= a.grade_nombre %></span>
              <span class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 text-xs"><%= a.section_display %></span>
            </td>
            <td class="px-4 py-3 text-slate-500 text-xs"><%= a.school_year %></td>
            <td class="px-4 py-3">
              <% if (a.is_active) { %>
              <span class="inline-flex items-center gap-1 text-xs text-emerald-700"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Activa</span>
              <% } else { %>
              <span class="inline-flex items-center gap-1 text-xs text-slate-400"><span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>Inactiva</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/admin-pagination', { pagina: paginaA, totalPaginas: totalPaginasA, total: totalAssignments, limit, baseUrl: '/admin/maestros' + (q ? '?q=' + encodeURIComponent(q) : ''), pageParam: 'pa' }) %>
  </div>
  <% } %>
</div>

<!-- ── Nueva asignación ─────────────────────────────────────── -->
<div id="tab-nueva-asignacion" class="hidden">
  <% if (teachers.filter(t => t.is_active).length === 0) { %>
  <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-700">
    <i class="bi bi-exclamation-triangle mr-2"></i>Debe registrar maestros activos primero.
  </div>
  <% } else { %>
  <script id="sections-data" type="application/json"><%- JSON.stringify(sections) %></script>
  <div class="max-w-lg">
    <div class="bg-white rounded-xl border border-slate-200/70 p-5">
      <h2 class="text-sm font-semibold text-slate-800 mb-4">Nueva asignación docente</h2>
      <form method="POST" action="/admin/maestros/asignacion" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Maestro <span class="text-red-400">*</span></label>
          <select name="teacher_id" required class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
            <option value="">Seleccione...</option>
            <% teachers.filter(t => t.is_active).forEach(t => { %><option value="<%= t.id %>"><%= t.full_name %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Curso <span class="text-red-400">*</span></label>
          <select name="course_id" required class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
            <option value="">Seleccione...</option>
            <% courses.forEach(c => { %><option value="<%= c.id %>"><%= c.nombre %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Grado <span class="text-red-400">*</span></label>
          <select name="grade_id" id="asig-grade" required class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
            <option value="">Seleccione...</option>
            <% grades.forEach(g => { %><option value="<%= g.id %>"><%= g.nombre %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Sección <span class="text-red-400">*</span></label>
          <select name="section_id" id="asig-section" required class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
            <option value="">Seleccione...</option>
            <% sections.forEach(s => { %><option value="<%= s.id %>" data-grade="<%= s.grade_id %>"><%= s.display_name %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Año escolar <span class="text-red-400">*</span></label>
          <input type="number" name="school_year" required value="<%= new Date().getFullYear() %>"
            min="2000" max="<%= new Date().getFullYear() + 1 %>"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
          <i class="bi bi-person-plus"></i> Crear asignación
        </button>
      </form>
    </div>
  </div>
  <% } %>
</div>

<script>
function toggleEdit(key) {
  const row = document.getElementById('edit-row-' + key);
  if (row) row.classList.toggle('hidden');
}

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.classList.remove('text-blue-600','border-blue-600');
      b.classList.add('text-slate-500','border-transparent');
    });
    this.classList.add('text-blue-600','border-blue-600');
    this.classList.remove('text-slate-500','border-transparent');
    document.getElementById('tab-lista').classList.toggle('hidden', this.dataset.tab !== 'lista');
    document.getElementById('tab-asignaciones').classList.toggle('hidden', this.dataset.tab !== 'asignaciones');
    document.getElementById('tab-nueva-asignacion').classList.toggle('hidden', this.dataset.tab !== 'nueva-asignacion');
  });
});

(function () {
  const sdEl = document.getElementById('sections-data');
  if (!sdEl) return;
  const allSections = JSON.parse(sdEl.textContent);
  const gradeSel = document.getElementById('asig-grade');
  const secSel   = document.getElementById('asig-section');
  if (!gradeSel || !secSel) return;

  gradeSel.addEventListener('change', function () {
    const gradeId = parseInt(this.value) || 0;
    secSel.innerHTML = '<option value="">Seleccione...</option>';
    allSections
      .filter(s => s.is_active && (!gradeId || s.grade_id === gradeId))
      .forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.display_name || s.nombre;
        secSel.appendChild(opt);
      });
  });
})();
</script>

<%- include('../partials/import-modal', { modulo: 'maestros', moduloLabel: 'Maestros' }) %>
<%- include('../partials/import-modal', { modulo: 'asignaciones', moduloLabel: 'Asignaciones' }) %>
