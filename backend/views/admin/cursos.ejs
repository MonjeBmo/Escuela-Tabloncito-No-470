<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Cursos</h1>
    <p class="text-sm text-slate-500 mt-0.5">Catálogo de asignaturas del establecimiento</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100 flex items-center gap-3">
        <h2 class="text-sm font-semibold text-slate-800 flex-1">Asignaturas registradas</h2>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700"><%= courses.length %></span>
      </div>
      <div class="px-5 py-3 border-b border-slate-100">
        <form method="GET" action="/admin/cursos" class="flex gap-2">
          <div class="relative flex-1">
            <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
            <input type="text" name="q" value="<%= q %>" placeholder="Buscar por nombre o abreviatura..."
              class="w-full h-8 pl-9 pr-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <button type="submit" class="h-8 px-3 bg-slate-100 text-slate-600 text-xs font-medium rounded-lg hover:bg-slate-200 transition-colors">Buscar</button>
          <% if (q) { %>
          <a href="/admin/cursos" class="h-8 w-8 flex items-center justify-center text-sm text-slate-400 rounded-lg hover:bg-slate-100 transition-colors"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </form>
      </div>
      <% if (courses.length === 0) { %>
      <div class="py-12 text-center">
        <i class="bi bi-journal-bookmark text-4xl text-slate-200 block mb-3"></i>
        <p class="text-sm text-slate-400"><%= q ? 'Sin resultados para "' + q + '".' : 'No hay cursos registrados.' %></p>
      </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[500px]">
          <thead class="bg-slate-50/80">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Nombre</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Abrev.</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Orden</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wide">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach(c => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/40 transition-colors">
              <td class="px-5 py-3 font-medium text-slate-800"><%= c.nombre %></td>
              <td class="px-4 py-3 text-slate-500 text-xs font-mono"><%= c.nombre_corto || '—' %></td>
              <td class="px-4 py-3 text-slate-500 text-xs"><%= c.sort_order %></td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick="toggleEdit('curso-<%= c.id %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors">
                    <i class="bi bi-pencil"></i> Editar
                  </button>
                  <form method="POST" action="/admin/cursos/<%= c.id %>/toggle">
                    <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors
                      <%= c.is_active ? 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' : 'border-slate-200 bg-slate-50 text-slate-500 hover:bg-slate-100' %>">
                      <i class="bi bi-toggle-<%= c.is_active ? 'on' : 'off' %>"></i>
                      <%= c.is_active ? 'Activo' : 'Inactivo' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <tr id="edit-row-curso-<%= c.id %>" class="hidden bg-blue-50/40 border-t border-blue-100">
              <td colspan="4" class="px-5 py-4">
                <form method="POST" action="/admin/cursos/<%= c.id %>" class="flex flex-wrap items-end gap-3">
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Nombre</label>
                    <input type="text" name="nombre" value="<%= c.nombre %>" required
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-44">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Abreviatura</label>
                    <input type="text" name="nombre_corto" value="<%= c.nombre_corto || '' %>"
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-24">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Orden</label>
                    <input type="number" name="sort_order" value="<%= c.sort_order %>" min="0"
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-20">
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="submit" class="h-9 px-4 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">Guardar</button>
                    <button type="button" onclick="toggleEdit('curso-<%= c.id %>')"
                      class="h-9 px-3 text-sm text-slate-500 rounded-lg hover:bg-slate-100 transition-colors">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </div>

  <div>
    <div class="bg-white rounded-xl border border-slate-200/70 p-5">
      <h2 class="text-sm font-semibold text-slate-800 mb-4">Nuevo curso</h2>
      <form method="POST" action="/admin/cursos" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre <span class="text-red-400">*</span></label>
          <input type="text" name="nombre" required placeholder="ej. Historia"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Abreviatura</label>
          <input type="text" name="nombre_corto" placeholder="ej. HIST"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Orden</label>
          <input type="number" name="sort_order" value="<%= courses.length + 1 %>" min="0"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
          <i class="bi bi-plus-lg"></i> Crear curso
        </button>
      </form>
    </div>
  </div>

</div>

<script>
function toggleEdit(key) {
  const row = document.getElementById('edit-row-' + key);
  if (row) row.classList.toggle('hidden');
}
</script>
