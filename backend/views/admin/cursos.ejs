<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-bold font-serif text-marino-950">Catálogo de Cursos y Asignaturas</h1>
    <p class="text-xs text-marino-600/80 mt-0.5">Materias y áreas curriculares del pensum educativo</p>
  </div>
  <button type="button" onclick="document.getElementById('import-modal-cursos').showModal()"
    class="inline-flex items-center gap-2 px-3.5 py-2 bg-bosque-600 hover:bg-bosque-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all">
    <i class="bi bi-file-earmark-spreadsheet text-sm"></i>
    <span>Importar Cursos</span>
  </button>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <div class="lg:col-span-2">
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-hueso-200 bg-hueso-50/50 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-marino-100 text-marino-700 flex items-center justify-center font-bold text-sm">
            <i class="bi bi-journal-bookmark"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-marino-950 font-serif">Asignaturas Registradas</h2>
            <p class="text-[11px] text-marino-600/70">Materias impartidas en el centro educativo</p>
          </div>
        </div>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-marino-100 text-marino-800 border border-marino-200">
          <%= courses.length %> cursos
        </span>
      </div>
      <div class="px-6 py-3 border-b border-hueso-200 bg-white">
        <form method="GET" action="/admin/cursos" class="flex gap-2">
          <div class="relative flex-1">
            <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-marino-400 text-xs pointer-events-none"></i>
            <input type="text" name="q" value="<%= q %>" placeholder="Buscar por nombre o abreviatura..."
              class="w-full h-9 pl-9 pr-3 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
          </div>
          <button type="submit" class="h-9 px-3.5 bg-marino-700 hover:bg-marino-800 text-white text-xs font-semibold rounded-xl shadow-xs transition-all">Buscar</button>
          <% if (q) { %>
          <a href="/admin/cursos" class="h-9 w-9 flex items-center justify-center text-xs text-marino-500 bg-hueso-100 rounded-xl hover:bg-hueso-200 transition-colors"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </form>
      </div>
      <% if (courses.length === 0) { %>
      <div class="py-14 text-center px-4">
        <div class="w-14 h-14 rounded-2xl bg-hueso-100 text-marino-300 flex items-center justify-center mx-auto mb-3">
          <i class="bi bi-journal-bookmark text-2xl"></i>
        </div>
        <p class="text-xs text-marino-500"><%= q ? 'Sin resultados para "' + q + '".' : 'No hay cursos registrados.' %></p>
      </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[500px]">
          <thead class="bg-hueso-100/60 border-b border-hueso-200 text-marino-700">
            <tr>
              <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Nombre del Curso</th>
              <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Abrev.</th>
              <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Orden</th>
              <th class="px-6 py-3.5 text-right text-xs font-bold uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hueso-100">
            <% courses.forEach(c => { %>
            <tr class="hover:bg-hueso-50/50 transition-colors">
              <td class="px-6 py-3.5 font-bold text-marino-950 text-xs"><%= c.nombre %></td>
              <td class="px-4 py-3.5 text-marino-600 text-xs font-mono"><%= c.nombre_corto || '—' %></td>
              <td class="px-4 py-3.5 text-ladrillo-700 font-bold text-xs"><%= c.sort_order %></td>
              <td class="px-6 py-3.5">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick="toggleEdit('curso-<%= c.id %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl border border-hueso-300 bg-white text-marino-700 hover:bg-hueso-100 transition-all shadow-xs">
                    <i class="bi bi-pencil text-bosque-600"></i> Editar
                  </button>
                  <form method="POST" action="/admin/cursos/<%= c.id %>/toggle">
                    <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl border transition-all shadow-xs
                      <%= c.is_active ? 'border-bosque-200 bg-bosque-50 text-bosque-700 hover:bg-bosque-100' : 'border-hueso-300 bg-hueso-100 text-marino-500 hover:bg-hueso-200' %>">
                      <i class="bi bi-toggle-<%= c.is_active ? 'on' : 'off' %>"></i>
                      <%= c.is_active ? 'Activo' : 'Inactivo' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <tr id="edit-row-curso-<%= c.id %>" class="hidden bg-hueso-100/60 border-t border-hueso-200">
              <td colspan="4" class="px-6 py-4">
                <form method="POST" action="/admin/cursos/<%= c.id %>" class="flex flex-wrap items-end gap-3">
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Nombre</label>
                    <input type="text" name="nombre" value="<%= c.nombre %>" required
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-48 outline-none">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Abreviatura</label>
                    <input type="text" name="nombre_corto" value="<%= c.nombre_corto || '' %>"
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-24 outline-none">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Orden</label>
                    <input type="number" name="sort_order" value="<%= c.sort_order %>" min="0"
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-20 outline-none">
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="submit" class="h-10 px-4 bg-marino-700 hover:bg-marino-800 text-white text-xs font-semibold rounded-xl shadow-xs transition-all">Guardar</button>
                    <button type="button" onclick="toggleEdit('curso-<%= c.id %>')"
                      class="h-10 px-3 text-xs text-marino-600 rounded-xl hover:bg-hueso-200 transition-colors">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/admin-pagination', { pagina, totalPaginas, total, limit, baseUrl: '/admin/cursos' + (q ? '?q=' + encodeURIComponent(q) : '') }) %>
      <% } %>
    </div>
  </div>

  <div>
    <div class="bg-white rounded-2xl border border-hueso-200/80 p-6 shadow-sm">
      <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-hueso-100">
        <div class="w-8 h-8 rounded-lg bg-marino-100 text-marino-700 flex items-center justify-center font-bold text-sm">
          <i class="bi bi-plus-lg"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-marino-950 font-serif">Nuevo Curso</h2>
          <p class="text-[11px] text-marino-600/70">Agregar materia al catálogo</p>
        </div>
      </div>
      <form method="POST" action="/admin/cursos" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Nombre de la Asignatura <span class="text-ladrillo-600">*</span></label>
          <input type="text" name="nombre" required placeholder="ej. Comunicación y Lenguaje"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Abreviatura / Código</label>
          <input type="text" name="nombre_corto" placeholder="ej. CYL"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Orden de Visualización</label>
          <input type="number" name="sort_order" value="<%= courses.length + 1 %>" min="0"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <button type="submit" class="w-full h-11 bg-marino-700 hover:bg-marino-800 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2">
          <i class="bi bi-plus-circle text-sm"></i> Crear Curso
        </button>
      </form>
    </div>
  </div>

</div>

<script>
function toggleEdit(key) {
  const row = document.getElementById('edit-row-' + key);
  if (row) row.classList.toggle('hidden');
}
</script>

<%- include('../partials/import-modal', { modulo: 'cursos', moduloLabel: 'Cursos' }) %>
