<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Grados y secciones</h1>
    <p class="text-sm text-slate-500 mt-0.5">Administre la estructura académica del establecimiento</p>
  </div>
</div>

<!-- Tabs -->
<div class="flex border-b border-slate-200 mb-5" id="tab-nav">
  <button type="button" data-tab="grados"
    class="tab-btn px-4 py-2.5 text-sm font-medium text-blue-600 border-b-2 border-blue-600 -mb-px">
    Grados
  </button>
  <button type="button" data-tab="secciones"
    class="tab-btn px-4 py-2.5 text-sm font-medium text-slate-500 hover:text-slate-700 border-b-2 border-transparent -mb-px transition-colors">
    Secciones
  </button>
</div>

<!-- Grados tab -->
<div id="tab-grados" class="grid grid-cols-1 lg:grid-cols-3 gap-5">
  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[480px]">
          <thead class="bg-slate-50/80">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Grado</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Abrev.</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Orden</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wide">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% grades.forEach(g => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/40 transition-colors">
              <td class="px-5 py-3 font-medium text-slate-800"><%= g.nombre %></td>
              <td class="px-4 py-3 text-slate-500 text-xs"><%= g.nombre_corto || '—' %></td>
              <td class="px-4 py-3 text-slate-500 text-xs"><%= g.sort_order %></td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick="toggleEdit('grado-<%= g.id %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors">
                    <i class="bi bi-pencil"></i> Editar
                  </button>
                  <form method="POST" action="/admin/grados/grade/<%= g.id %>/toggle">
                    <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors
                      <%= g.is_active ? 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' : 'border-slate-200 bg-slate-50 text-slate-500 hover:bg-slate-100' %>">
                      <i class="bi bi-toggle-<%= g.is_active ? 'on' : 'off' %>"></i>
                      <%= g.is_active ? 'Activo' : 'Inactivo' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <tr id="edit-row-grado-<%= g.id %>" class="hidden bg-blue-50/40 border-t border-blue-100">
              <td colspan="4" class="px-5 py-4">
                <form method="POST" action="/admin/grados/grade/<%= g.id %>" class="flex flex-wrap items-end gap-3">
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Nombre</label>
                    <input type="text" name="nombre" value="<%= g.nombre %>" required
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-40">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Abreviatura</label>
                    <input type="text" name="nombre_corto" value="<%= g.nombre_corto || '' %>"
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-20">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Orden</label>
                    <input type="number" name="sort_order" value="<%= g.sort_order %>" min="0"
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-20">
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="submit" class="h-9 px-4 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">Guardar</button>
                    <button type="button" onclick="toggleEdit('grado-<%= g.id %>')"
                      class="h-9 px-3 text-sm text-slate-500 rounded-lg hover:bg-slate-100 transition-colors">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div>
    <div class="bg-white rounded-xl border border-slate-200/70 p-5">
      <h2 class="text-sm font-semibold text-slate-800 mb-4">Nuevo grado</h2>
      <form method="POST" action="/admin/grados/grade" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre <span class="text-red-400">*</span></label>
          <input type="text" name="nombre" required placeholder="ej. Séptimo"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Abreviatura</label>
          <input type="text" name="nombre_corto" placeholder="ej. 7°"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Orden</label>
          <input type="number" name="sort_order" value="<%= grades.length + 1 %>" min="0"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
          <i class="bi bi-plus-lg"></i> Crear grado
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Secciones tab -->
<div id="tab-secciones" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-5">
  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[480px]">
          <thead class="bg-slate-50/80">
            <tr>
              <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Sección</th>
              <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Nombre completo</th>
              <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wide">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% sections.forEach(s => { %>
            <tr class="border-t border-slate-100 hover:bg-slate-50/40 transition-colors">
              <td class="px-5 py-3">
                <span class="font-medium text-slate-800"><%= s.grade_nombre %></span>
                <span class="ml-1.5 inline-flex items-center px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-xs font-medium"><%= s.nombre %></span>
              </td>
              <td class="px-4 py-3 text-slate-500 text-sm"><%= s.display_name || '—' %></td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick="toggleEdit('seccion-<%= s.id %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition-colors">
                    <i class="bi bi-pencil"></i> Editar
                  </button>
                  <form method="POST" action="/admin/grados/seccion/<%= s.id %>/toggle">
                    <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-lg border transition-colors
                      <%= s.is_active ? 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' : 'border-slate-200 bg-slate-50 text-slate-500 hover:bg-slate-100' %>">
                      <i class="bi bi-toggle-<%= s.is_active ? 'on' : 'off' %>"></i>
                      <%= s.is_active ? 'Activa' : 'Inactiva' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <tr id="edit-row-seccion-<%= s.id %>" class="hidden bg-blue-50/40 border-t border-blue-100">
              <td colspan="3" class="px-5 py-4">
                <form method="POST" action="/admin/grados/seccion/<%= s.id %>" class="flex flex-wrap items-end gap-3">
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Nombre de sección</label>
                    <input type="text" name="nombre" value="<%= s.nombre %>" required
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-24">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Nombre completo</label>
                    <input type="text" name="display_name" value="<%= s.display_name || '' %>"
                      class="h-9 px-3 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 focus:border-blue-400 w-48">
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="submit" class="h-9 px-4 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">Guardar</button>
                    <button type="button" onclick="toggleEdit('seccion-<%= s.id %>')"
                      class="h-9 px-3 text-sm text-slate-500 rounded-lg hover:bg-slate-100 transition-colors">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div>
    <div class="bg-white rounded-xl border border-slate-200/70 p-5">
      <h2 class="text-sm font-semibold text-slate-800 mb-4">Nueva sección</h2>
      <form method="POST" action="/admin/grados/seccion" class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Grado <span class="text-red-400">*</span></label>
          <select name="grade_id" required class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
            <option value="">Seleccione...</option>
            <% grades.filter(g => g.is_active).forEach(g => { %><option value="<%= g.id %>"><%= g.nombre %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre de sección <span class="text-red-400">*</span></label>
          <input type="text" name="nombre" required placeholder="ej. C"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
          <i class="bi bi-plus-lg"></i> Crear sección
        </button>
      </form>
    </div>
  </div>
</div>

<script>
function toggleEdit(key) {
  const row = document.getElementById('edit-row-' + key);
  if (row) row.classList.toggle('hidden');
}

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.classList.remove('text-blue-600','border-blue-600');
      b.classList.add('text-slate-500','border-transparent');
    });
    this.classList.add('text-blue-600','border-blue-600');
    this.classList.remove('text-slate-500','border-transparent');
    document.getElementById('tab-grados').classList.toggle('hidden', this.dataset.tab !== 'grados');
    document.getElementById('tab-secciones').classList.toggle('hidden', this.dataset.tab !== 'secciones');
  });
});
</script>
