<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-bold font-serif text-marino-950">Estructura de Grados y Secciones</h1>
    <p class="text-xs text-marino-600/80 mt-0.5">Organización académica del nivel primario y secciones activas</p>
  </div>
  <div class="flex items-center gap-2 flex-wrap">
    <button type="button" onclick="document.getElementById('import-modal-grados').showModal()"
      class="inline-flex items-center gap-2 px-3.5 py-2 bg-bosque-600 hover:bg-bosque-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all">
      <i class="bi bi-file-earmark-spreadsheet text-sm"></i>
      <span>Importar Grados</span>
    </button>
    <button type="button" onclick="document.getElementById('import-modal-secciones').showModal()"
      class="inline-flex items-center gap-2 px-3.5 py-2 bg-white border border-hueso-300 text-marino-800 hover:bg-hueso-100 text-xs font-semibold rounded-xl shadow-sm transition-all">
      <i class="bi bi-file-earmark-spreadsheet text-sm text-bosque-600"></i>
      <span>Importar Secciones</span>
    </button>
  </div>
</div>

<!-- Tabs -->
<div class="flex border-b border-hueso-200 mb-6 gap-2" id="tab-nav">
  <button type="button" data-tab="grados"
    class="tab-btn px-4 py-2.5 text-xs font-bold font-serif text-marino-950 border-b-2 border-ladrillo-600 -mb-px transition-colors">
    <i class="bi bi-mortarboard mr-1.5 text-ladrillo-600"></i> Grados Académicos
  </button>
  <button type="button" data-tab="secciones"
    class="tab-btn px-4 py-2.5 text-xs font-bold font-serif text-marino-500 hover:text-marino-800 border-b-2 border-transparent -mb-px transition-colors">
    <i class="bi bi-grid mr-1.5"></i> Secciones
  </button>
</div>

<!-- Grados tab -->
<div id="tab-grados" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[480px]">
          <thead class="bg-hueso-100/60 border-b border-hueso-200 text-marino-700">
            <tr>
              <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Nombre del Grado</th>
              <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Abrev.</th>
              <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Orden</th>
              <th class="px-6 py-3.5 text-right text-xs font-bold uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hueso-100">
            <% grades.forEach(g => { %>
            <tr class="hover:bg-hueso-50/50 transition-colors">
              <td class="px-6 py-3.5 font-bold text-marino-950 text-xs"><%= g.nombre %></td>
              <td class="px-4 py-3.5 text-marino-600 text-xs font-mono"><%= g.nombre_corto || '—' %></td>
              <td class="px-4 py-3.5 text-ladrillo-700 font-bold text-xs"><%= g.sort_order %></td>
              <td class="px-6 py-3.5">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick="toggleEdit('grado-<%= g.id %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl border border-hueso-300 bg-white text-marino-700 hover:bg-hueso-100 transition-all shadow-xs">
                    <i class="bi bi-pencil text-bosque-600"></i> Editar
                  </button>
                  <form method="POST" action="/admin/grados/grade/<%= g.id %>/toggle">
                    <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl border transition-all shadow-xs
                      <%= g.is_active ? 'border-bosque-200 bg-bosque-50 text-bosque-700 hover:bg-bosque-100' : 'border-hueso-300 bg-hueso-100 text-marino-500 hover:bg-hueso-200' %>">
                      <i class="bi bi-toggle-<%= g.is_active ? 'on' : 'off' %>"></i>
                      <%= g.is_active ? 'Activo' : 'Inactivo' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <tr id="edit-row-grado-<%= g.id %>" class="hidden bg-hueso-100/60 border-t border-hueso-200">
              <td colspan="4" class="px-6 py-4">
                <form method="POST" action="/admin/grados/grade/<%= g.id %>" class="flex flex-wrap items-end gap-3">
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Nombre</label>
                    <input type="text" name="nombre" value="<%= g.nombre %>" required
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-40 outline-none">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Abreviatura</label>
                    <input type="text" name="nombre_corto" value="<%= g.nombre_corto || '' %>"
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-24 outline-none">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Orden</label>
                    <input type="number" name="sort_order" value="<%= g.sort_order %>" min="0"
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-20 outline-none">
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="submit" class="h-10 px-4 bg-marino-700 hover:bg-marino-800 text-white text-xs font-semibold rounded-xl shadow-xs transition-all">Guardar</button>
                    <button type="button" onclick="toggleEdit('grado-<%= g.id %>')"
                      class="h-10 px-3 text-xs text-marino-600 rounded-xl hover:bg-hueso-200 transition-colors">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/admin-pagination', { pagina: paginaG, totalPaginas: totalPaginasG, total: totalGrades, limit, baseUrl: '/admin/grados?ps=' + paginaS, pageParam: 'pg' }) %>
    </div>
  </div>
  <div>
    <div class="bg-white rounded-2xl border border-hueso-200/80 p-6 shadow-sm">
      <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-hueso-100">
        <div class="w-8 h-8 rounded-lg bg-ladrillo-100 text-ladrillo-700 flex items-center justify-center font-bold text-sm">
          <i class="bi bi-plus-lg"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-marino-950 font-serif">Nuevo Grado</h2>
          <p class="text-[11px] text-marino-600/70">Agregar nivel al pensum</p>
        </div>
      </div>
      <form method="POST" action="/admin/grados/grade" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Nombre <span class="text-ladrillo-600">*</span></label>
          <input type="text" name="nombre" required placeholder="ej. Primero Primaria"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Abreviatura</label>
          <input type="text" name="nombre_corto" placeholder="ej. 1° Primaria"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Orden de Visualización</label>
          <input type="number" name="sort_order" value="<%= grades.length + 1 %>" min="0"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <button type="submit" class="w-full h-11 bg-ladrillo-600 hover:bg-ladrillo-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2">
          <i class="bi bi-plus-circle text-sm"></i> Crear Grado
        </button>
      </form>
    </div>
  </div>
</div>

<!-- Secciones tab -->
<div id="tab-secciones" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2">
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="table-wrap">
        <table class="w-full text-sm min-w-[480px]">
          <thead class="bg-hueso-100/60 border-b border-hueso-200 text-marino-700">
            <tr>
              <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Sección</th>
              <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider">Nombre Completo</th>
              <th class="px-6 py-3.5 text-right text-xs font-bold uppercase tracking-wider">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hueso-100">
            <% sections.forEach(s => { %>
            <tr class="hover:bg-hueso-50/50 transition-colors">
              <td class="px-6 py-3.5">
                <span class="font-bold text-marino-950 text-xs"><%= s.grade_nombre %></span>
                <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-lg bg-hueso-200 text-marino-800 text-[11px] font-bold border border-hueso-300"><%= s.nombre %></span>
              </td>
              <td class="px-4 py-3.5 text-marino-700 text-xs font-medium"><%= s.display_name || '—' %></td>
              <td class="px-6 py-3.5">
                <div class="flex items-center justify-end gap-2">
                  <button type="button" onclick="toggleEdit('seccion-<%= s.id %>')"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl border border-hueso-300 bg-white text-marino-700 hover:bg-hueso-100 transition-all shadow-xs">
                    <i class="bi bi-pencil text-bosque-600"></i> Editar
                  </button>
                  <form method="POST" action="/admin/grados/seccion/<%= s.id %>/toggle">
                    <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-xl border transition-all shadow-xs
                      <%= s.is_active ? 'border-bosque-200 bg-bosque-50 text-bosque-700 hover:bg-bosque-100' : 'border-hueso-300 bg-hueso-100 text-marino-500 hover:bg-hueso-200' %>">
                      <i class="bi bi-toggle-<%= s.is_active ? 'on' : 'off' %>"></i>
                      <%= s.is_active ? 'Activa' : 'Inactiva' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
            <tr id="edit-row-seccion-<%= s.id %>" class="hidden bg-hueso-100/60 border-t border-hueso-200">
              <td colspan="3" class="px-6 py-4">
                <form method="POST" action="/admin/grados/seccion/<%= s.id %>" class="flex flex-wrap items-end gap-3">
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Letra / Código</label>
                    <input type="text" name="nombre" value="<%= s.nombre %>" required
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-24 outline-none">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1">Nombre Completo</label>
                    <input type="text" name="display_name" value="<%= s.display_name || '' %>"
                      class="h-10 px-3 text-xs rounded-xl border border-hueso-300 bg-white text-marino-950 focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 w-52 outline-none">
                  </div>
                  <div class="flex items-center gap-2">
                    <button type="submit" class="h-10 px-4 bg-marino-700 hover:bg-marino-800 text-white text-xs font-semibold rounded-xl shadow-xs transition-all">Guardar</button>
                    <button type="button" onclick="toggleEdit('seccion-<%= s.id %>')"
                      class="h-10 px-3 text-xs text-marino-600 rounded-xl hover:bg-hueso-200 transition-colors">Cancelar</button>
                  </div>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../partials/admin-pagination', { pagina: paginaS, totalPaginas: totalPaginasS, total: totalSections, limit, baseUrl: '/admin/grados?pg=' + paginaG, pageParam: 'ps' }) %>
    </div>
  </div>
  <div>
    <div class="bg-white rounded-2xl border border-hueso-200/80 p-6 shadow-sm">
      <div class="flex items-center gap-2.5 pb-4 mb-4 border-b border-hueso-100">
        <div class="w-8 h-8 rounded-lg bg-marino-100 text-marino-700 flex items-center justify-center font-bold text-sm">
          <i class="bi bi-grid-plus"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-marino-950 font-serif">Nueva Sección</h2>
          <p class="text-[11px] text-marino-600/70">Apertura de sección en grado</p>
        </div>
      </div>
      <form method="POST" action="/admin/grados/seccion" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Grado Correspondiente <span class="text-ladrillo-600">*</span></label>
          <select name="grade_id" required class="w-full h-10 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 px-3 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
            <option value="">Seleccione...</option>
            <% grades.filter(g => g.is_active).forEach(g => { %><option value="<%= g.id %>"><%= g.nombre %></option><% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Identificador de Sección <span class="text-ladrillo-600">*</span></label>
          <input type="text" name="nombre" required placeholder="ej. A, B o C"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <button type="submit" class="w-full h-11 bg-marino-700 hover:bg-marino-800 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2">
          <i class="bi bi-plus-circle text-sm"></i> Crear Sección
        </button>
      </form>
    </div>
  </div>
</div>

<script>
function toggleEdit(key) {
  const row = document.getElementById('edit-row-' + key);
  if (row) row.classList.toggle('hidden');
}

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.tab-btn').forEach(b => {
      b.classList.remove('text-marino-950','border-ladrillo-600');
      b.classList.add('text-marino-500','border-transparent');
    });
    this.classList.add('text-marino-950','border-ladrillo-600');
    this.classList.remove('text-marino-500','border-transparent');
    document.getElementById('tab-grados').classList.toggle('hidden', this.dataset.tab !== 'grados');
    document.getElementById('tab-secciones').classList.toggle('hidden', this.dataset.tab !== 'secciones');
  });
});
</script>

<%- include('../partials/import-modal', { modulo: 'grados', moduloLabel: 'Grados' }) %>
<%- include('../partials/import-modal', { modulo: 'secciones', moduloLabel: 'Secciones' }) %>
