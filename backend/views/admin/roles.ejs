<div class="flex items-center justify-between mb-4">
  <div>
    <h1 class="text-xl font-bold font-serif text-marino-950">Roles y Matriz de Permisos</h1>
    <p class="text-xs text-marino-600/80 mt-0.5">Definición de perfiles de seguridad y alcance de acceso al sistema</p>
  </div>
</div>

<!-- Guía de Seguridad -->
<div class="mb-5 p-4 rounded-xl bg-marino-50/80 border border-marino-200/80 flex items-start gap-3 text-xs text-marino-800">
  <i class="bi bi-shield-check text-marino-700 text-base flex-shrink-0 mt-0.5"></i>
  <div class="flex-1 leading-relaxed">
    <strong class="font-semibold text-marino-900">Perfiles de Acceso Institucional:</strong>
    Los roles predeterminados son: 
    <span class="font-semibold text-marino-900">Administrador / Director</span> (acceso total a archivo, reportes y configuración), 
    <span class="font-semibold text-marino-900">Docente</span> (consulta de cuadros y gestión de sus grados) y 
    <span class="font-semibold text-marino-900">Digitador</span> (carga y revisión de escaneos OCR).
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Lista de roles -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-hueso-200 bg-hueso-50/50 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-marino-100 text-marino-700 flex items-center justify-center font-bold text-sm">
            <i class="bi bi-shield-lock"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-marino-950 font-serif">Roles Configurados</h2>
            <p class="text-[11px] text-marino-600/70">Perfiles con control granular de módulos</p>
          </div>
        </div>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-marino-100 text-marino-800 border border-marino-200">
          <%= roles.length %> roles
        </span>
      </div>
      <div class="divide-y divide-hueso-100">
        <% roles.forEach(r => { %>
        <div class="px-6 py-4 flex items-center justify-between gap-4 hover:bg-hueso-50/50 transition-colors">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-marino-950 text-xs"><%= r.nombre %></span>
              <% if (r.is_system) { %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-hueso-200 text-marino-700 uppercase tracking-wider border border-hueso-300">Sistema</span>
              <% } %>
            </div>
            <p class="text-[11px] text-marino-600/80 mt-0.5 truncate"><%= r.descripcion || 'Sin descripción detallada' %></p>
          </div>
          <a href="/admin/roles/<%= r.id %>/editar"
            class="flex-shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-white border border-hueso-300 text-marino-800 hover:bg-hueso-100 text-xs font-semibold rounded-xl shadow-xs transition-all">
            <i class="bi bi-sliders text-bosque-600"></i> Editar Permisos
          </a>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Crear rol -->
  <div>
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-4 border-b border-hueso-200 bg-hueso-50/50 flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-ladrillo-100 text-ladrillo-700 flex items-center justify-center font-bold text-sm">
          <i class="bi bi-shield-plus"></i>
        </div>
        <div>
          <h2 class="text-sm font-bold text-marino-950 font-serif">Nuevo Rol</h2>
          <p class="text-[11px] text-marino-600/70">Crear perfil personalizado</p>
        </div>
      </div>
      <form method="POST" action="/admin/roles" class="p-6 space-y-4">
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Identificador del Rol <span class="text-ladrillo-600">*</span></label>
          <input type="text" name="nombre" required placeholder="ej. secretaria_auxiliar"
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none font-mono">
        </div>
        <div>
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider mb-1.5">Descripción de Funciones</label>
          <input type="text" name="descripcion" placeholder="Responsabilidades asignadas..."
            class="w-full h-10 px-3.5 text-xs rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-950 placeholder-marino-300 focus:bg-white focus:border-marino-600 focus:ring-2 focus:ring-marino-500/20 transition-all outline-none">
        </div>
        <button type="submit" class="w-full h-11 bg-ladrillo-600 hover:bg-ladrillo-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2">
          <i class="bi bi-shield-check text-sm"></i> Guardar Rol
        </button>
      </form>
    </div>

    <!-- Permisos disponibles (referencia) -->
    <div class="mt-5 bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm">
      <div class="px-6 py-3.5 border-b border-hueso-200 bg-hueso-50/50">
        <h2 class="text-xs font-bold text-marino-600 uppercase tracking-wider">Módulos del Sistema</h2>
      </div>
      <div class="p-5 space-y-2">
        <% const modulos = [...new Set(allPerms.map(p => p.modulo))]; %>
        <% modulos.forEach(m => { %>
        <div class="flex items-center justify-between text-xs py-1 border-b border-hueso-100 last:border-0">
          <span class="font-bold text-marino-900 uppercase text-[11px]"><%= m %></span>
          <span class="text-marino-500 font-mono text-[11px] bg-hueso-100 px-2 py-0.5 rounded-md"><%= allPerms.filter(p => p.modulo === m).length %> permisos</span>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

</div>
