<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Roles y permisos</h1>
    <p class="text-sm text-slate-500 mt-0.5">Gestione los roles del sistema y sus permisos de acceso</p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <!-- Lista de roles -->
  <div class="lg:col-span-2">
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-800">Roles registrados</h2>
      </div>
      <div class="divide-y divide-slate-100">
        <% roles.forEach(r => { %>
        <div class="px-5 py-4 flex items-center justify-between gap-3">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-medium text-slate-800 text-sm"><%= r.nombre %></span>
              <% if (r.is_system) { %>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-500">sistema</span>
              <% } %>
            </div>
            <p class="text-xs text-slate-400 mt-0.5 truncate"><%= r.descripcion || '—' %></p>
          </div>
          <a href="/admin/roles/<%= r.id %>/editar"
            class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 text-slate-600 text-xs font-medium rounded-lg hover:bg-slate-50 transition-colors">
            <i class="bi bi-pencil"></i> Editar permisos
          </a>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Crear rol -->
  <div>
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-800">Nuevo rol</h2>
      </div>
      <form method="POST" action="/admin/roles" class="p-5 space-y-4">
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Nombre <span class="text-red-400">*</span></label>
          <input type="text" name="nombre" required placeholder="ej. coordinador"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Descripción</label>
          <input type="text" name="descripcion"
            class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
        <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
          <i class="bi bi-shield-plus"></i> Crear rol
        </button>
      </form>
    </div>

    <!-- Permisos disponibles (referencia) -->
    <div class="mt-4 bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-800">Módulos disponibles</h2>
      </div>
      <div class="p-4 space-y-1">
        <% const modulos = [...new Set(allPerms.map(p => p.modulo))]; %>
        <% modulos.forEach(m => { %>
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <i class="bi bi-dot text-slate-300"></i>
          <span class="font-medium text-slate-600"><%= m %></span>
          <span class="text-slate-400">(<%= allPerms.filter(p => p.modulo === m).length %> permisos)</span>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

</div>
