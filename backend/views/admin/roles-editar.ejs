<div class="flex items-center gap-3 mb-6">
  <a href="/admin/roles" class="w-9 h-9 flex items-center justify-center rounded-xl border border-hueso-300 bg-white text-marino-700 hover:bg-hueso-100 hover:border-marino-400 transition-all shadow-sm flex-shrink-0">
    <i class="bi bi-arrow-left text-sm font-bold"></i>
  </a>
  <div class="flex-1 min-w-0">
    <h1 class="text-xl font-bold font-serif text-marino-950">Matriz de Permisos: <span class="text-ladrillo-700"><%= role.nombre %></span></h1>
    <p class="text-xs text-marino-600/80 mt-0.5">Asigne permisos de lectura, escritura y alcance operativo para este rol</p>
  </div>
  <div id="perm-counter" class="text-right bg-white px-4 py-2 rounded-xl border border-hueso-200 shadow-xs">
    <span id="perm-count" class="text-xl font-bold font-mono text-bosque-700">0</span>
    <div class="text-[11px] text-marino-500 font-semibold">permisos activos</div>
  </div>
</div>

<form method="POST" action="/admin/roles/<%= role.id %>/permisos" id="perms-form">

  <%
    const scopeLabels = { none: 'Sin acceso', own: 'Propios', assigned: 'Asignados', all: 'Todos' };
    const scopeColors = { none: 'text-marino-400', own: 'text-ocre-700 font-bold', assigned: 'text-marino-800 font-bold', all: 'text-bosque-700 font-bold' };
    const modulos = [...new Set(permisos.map(p => p.modulo))];
  %>

  <div class="space-y-5 mb-8">
    <% modulos.forEach(modulo => { %>
    <%
      const modPerms = permisos.filter(p => p.modulo === modulo);
      const activeCount = modPerms.filter(p => p.scope && p.scope !== 'none').length;
    %>
    <div class="bg-white rounded-2xl border border-hueso-200/80 overflow-hidden shadow-sm" data-module-block>
      <!-- Module header -->
      <div class="px-6 py-3.5 bg-hueso-50/70 border-b border-hueso-200 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="text-xs font-bold font-serif text-marino-950 uppercase tracking-wider"><%= modulo %></span>
          <span class="module-counter inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-marino-100 text-marino-800 border border-marino-200">
            <%= activeCount %> / <%= modPerms.length %>
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" class="text-xs text-bosque-700 hover:text-bosque-800 font-bold module-check-all" data-action="all">
            Habilitar todos
          </button>
          <span class="text-hueso-300">|</span>
          <button type="button" class="text-xs text-marino-400 hover:text-marino-600 font-medium module-check-all" data-action="none">
            Ninguno
          </button>
        </div>
      </div>

      <!-- Permissions grid -->
      <div class="divide-y divide-hueso-100">
        <% modPerms.forEach(p => { %>
        <%
          const isChecked = !!(p.scope && p.scope !== 'none');
          const currentScope = p.scope || 'all';
        %>
        <div class="perm-row flex items-center gap-4 px-6 py-3.5 transition-colors <%= isChecked ? 'bg-white' : 'bg-hueso-50/20' %>"
             data-module="<%= modulo %>">
          <!-- Checkbox + label -->
          <label class="flex items-center gap-3 cursor-pointer flex-1 min-w-0">
            <div class="relative flex-shrink-0">
              <input type="checkbox" name="perms" value="<%= p.id %>"
                <%= isChecked ? 'checked' : '' %>
                class="perm-checkbox w-4 h-4 rounded-md border-hueso-300 text-bosque-600 focus:ring-bosque-500/20 cursor-pointer">
            </div>
            <div class="min-w-0">
              <div class="text-xs font-bold text-marino-950 leading-tight"><%= p.label || p.codigo %></div>
              <div class="text-[11px] text-marino-500 font-mono mt-0.5"><%= p.codigo %></div>
            </div>
          </label>

          <!-- Scope selector -->
          <div class="flex-shrink-0">
            <select name="scopes[<%= p.id %>]"
              class="perm-scope h-8 text-xs rounded-xl border px-3 focus:ring-2 focus:ring-marino-500/20 focus:border-marino-600 transition-all cursor-pointer font-sans outline-none
                <%= isChecked ? 'border-hueso-300 bg-hueso-50/50 text-marino-900' : 'border-transparent bg-hueso-100 text-marino-400' %>">
              <% ['none','own','assigned','all'].forEach(s => { %>
              <option value="<%= s %>" <%= currentScope === s ? 'selected' : '' %>
                class="<%= scopeColors[s] %>">
                <%= scopeLabels[s] %>
              </option>
              <% }) %>
            </select>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Sticky save bar -->
  <div class="sticky bottom-4 flex items-center gap-3 bg-white/95 backdrop-blur-md p-4 rounded-2xl border border-hueso-300 shadow-xl">
    <button type="submit" class="px-6 h-11 bg-bosque-600 hover:bg-bosque-700 text-white text-xs font-semibold rounded-xl transition-all flex items-center gap-2 shadow-sm hover:shadow">
      <i class="bi bi-shield-check text-sm"></i> Guardar Configuración de Permisos
    </button>
    <a href="/admin/roles" class="px-5 h-11 flex items-center bg-white border border-hueso-300 text-marino-700 text-xs font-semibold rounded-xl hover:bg-hueso-100 transition-all shadow-xs">
      Cancelar
    </a>
    <span class="ml-auto text-xs text-marino-500 hidden sm:block font-sans">Los cambios surtirán efecto en el próximo inicio de sesión</span>
  </div>
</form>

<script>
(function () {
  // Counter update
  function updateCounter() {
    const total = document.querySelectorAll('.perm-checkbox:checked').length;
    document.getElementById('perm-count').textContent = total;

    // Update per-module counters
    document.querySelectorAll('[data-module-block]').forEach(block => {
      const all   = block.querySelectorAll('.perm-checkbox').length;
      const active = block.querySelectorAll('.perm-checkbox:checked').length;
      block.querySelector('.module-counter').textContent = active + ' / ' + all;
    });
  }

  // Checkbox ↔ scope row styling
  function syncRow(checkbox) {
    const row   = checkbox.closest('.perm-row');
    const scope = row.querySelector('.perm-scope');
    if (checkbox.checked) {
      row.classList.remove('bg-hueso-50/20');
      row.classList.add('bg-white');
      scope.classList.remove('border-transparent', 'bg-hueso-100', 'text-marino-400');
      scope.classList.add('border-hueso-300', 'bg-hueso-50/50', 'text-marino-900');
      if (scope.value === 'none') scope.value = 'all';
    } else {
      row.classList.add('bg-hueso-50/20');
      row.classList.remove('bg-white');
      scope.classList.add('border-transparent', 'bg-hueso-100', 'text-marino-400');
      scope.classList.remove('border-hueso-300', 'bg-hueso-50/50', 'text-marino-900');
      scope.value = 'none';
    }
  }

  // Scope change → auto-check if was unchecked
  document.querySelectorAll('.perm-scope').forEach(sel => {
    sel.addEventListener('change', function () {
      const row = this.closest('.perm-row');
      const cb  = row.querySelector('.perm-checkbox');
      if (this.value !== 'none' && !cb.checked) {
        cb.checked = true;
      } else if (this.value === 'none') {
        cb.checked = false;
      }
      syncRow(cb);
      updateCounter();
    });
  });

  document.querySelectorAll('.perm-checkbox').forEach(cb => {
    cb.addEventListener('change', function () {
      syncRow(this);
      updateCounter();
    });
  });

  // "Todos / Ninguno" per module
  document.querySelectorAll('.module-check-all').forEach(btn => {
    btn.addEventListener('click', function () {
      const action = this.dataset.action;
      const block  = this.closest('[data-module-block]');
      block.querySelectorAll('.perm-checkbox').forEach(cb => {
        cb.checked = (action === 'all');
        syncRow(cb);
      });
      updateCounter();
    });
  });

  // Init
  document.querySelectorAll('.perm-checkbox').forEach(cb => syncRow(cb));
  updateCounter();
})();
</script>
