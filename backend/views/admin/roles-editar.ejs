<div class="flex items-center gap-3 mb-6">
  <a href="/admin/roles" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 transition-colors">
    <i class="bi bi-arrow-left text-sm"></i>
  </a>
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Editar rol: <span class="text-blue-600"><%= role.nombre %></span></h1>
    <p class="text-sm text-slate-500 mt-0.5">Seleccione los permisos y alcance (scope) para este rol</p>
  </div>
</div>

<form method="POST" action="/admin/roles/<%= role.id %>/permisos">
  <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden mb-5">
    <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-sm font-semibold text-slate-800">Permisos del rol</h2>
      <span class="text-xs text-slate-400">scope: none | own | assigned | all</span>
    </div>

    <% const modulos = [...new Set(permisos.map(p => p.modulo))]; %>
    <% modulos.forEach(modulo => { %>
    <div class="px-5 py-4 border-b border-slate-50 last:border-0">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3"><%= modulo %></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% permisos.filter(p => p.modulo === modulo).forEach(p => { %>
        <div class="flex items-center justify-between gap-3 p-3 rounded-lg border border-slate-100 hover:border-slate-200 transition-colors">
          <label class="flex items-center gap-2.5 cursor-pointer min-w-0">
            <input type="checkbox" name="perms" value="<%= p.id %>"
              <%= p.scope ? 'checked' : '' %>
              class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 flex-shrink-0">
            <div class="min-w-0">
              <div class="text-sm font-medium text-slate-700 truncate"><%= p.label || p.codigo %></div>
              <div class="text-xs text-slate-400 font-mono"><%= p.codigo %></div>
            </div>
          </label>
          <select name="scopes[<%= p.id %>]"
            class="flex-shrink-0 h-8 text-xs rounded-lg border border-slate-200 bg-slate-50 text-slate-600 px-2 focus:border-blue-400 transition-colors">
            <% ['none','own','assigned','all'].forEach(s => { %>
            <option value="<%= s %>" <%= (p.scope || 'all') === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <% }) %>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="flex items-center gap-3">
    <button type="submit" class="px-5 h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center gap-2">
      <i class="bi bi-floppy"></i> Guardar permisos
    </button>
    <a href="/admin/roles" class="px-5 h-10 flex items-center bg-white border border-slate-200 text-slate-600 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors">
      Cancelar
    </a>
  </div>
</form>
