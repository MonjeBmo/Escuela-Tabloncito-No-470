<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' — ' : '' %>Tabloncito 470</title>

  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%232563eb'/><text y='.9em' font-size='68' x='14'>🎓</text></svg>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
        extend: {
          colors: { brand: '#2563eb' },
          borderColor: { DEFAULT: 'rgb(226 232 240 / .7)' },
        }
      }
    }
  </script>

  <link rel="stylesheet" href="/css/app.css">
  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="h-full bg-slate-100 font-sans antialiased">

<!-- Mobile sidebar overlay -->
<div id="sidebar-overlay" aria-hidden="true"></div>

<div class="min-h-dvh flex flex-col">

  <!-- ══ TOPBAR ══════════════════════════════════════════════ -->
  <header class="h-14 bg-white border-b border-slate-200/70 flex items-center px-3 sm:px-4 gap-2 sticky top-0 z-40 flex-shrink-0">

    <!-- Mobile hamburger -->
    <button id="sidebar-toggle"
      class="lg:hidden w-9 h-9 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 transition-colors flex-shrink-0"
      aria-label="Abrir menú lateral">
      <i class="bi bi-list text-xl"></i>
    </button>

    <!-- Brand -->
    <a href="/dashboard" class="flex items-center gap-2 flex-shrink-0 mr-1 sm:mr-2">
      <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
        <i class="bi bi-mortarboard-fill text-white text-sm"></i>
      </div>
      <span class="text-sm font-semibold text-slate-800 hidden sm:block">Tabloncito 470</span>
    </a>

    <div class="w-px h-5 bg-slate-200 hidden md:block flex-shrink-0"></div>

    <span class="text-sm text-slate-500 hidden md:block min-w-0 truncate">
      <%= typeof titulo !== 'undefined' ? titulo : 'Panel' %>
    </span>

    <div class="flex-1 min-w-0"></div>

    <!-- Global search (sm+) -->
    <div class="relative hidden sm:flex items-center flex-shrink-0">
      <i class="bi bi-search absolute left-3 text-slate-400 text-xs pointer-events-none"></i>
      <input id="global-search" type="search" placeholder="Buscar cuadros..." autocomplete="off"
        class="h-8 pl-8 pr-3 text-sm bg-slate-50 border border-slate-200 rounded-lg w-40 lg:w-52 focus:w-52 lg:focus:w-64 focus:border-blue-400 focus:bg-white transition-all outline-none placeholder-slate-400">
    </div>

    <div class="flex items-center gap-1 flex-shrink-0">
      <a href="/cuadros/crear" title="Registrar cuadro" aria-label="Registrar cuadro"
        class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition-colors">
        <i class="bi bi-plus-lg text-base"></i>
      </a>

      <% if (usuario) { %>
      <div class="relative ml-0.5">
        <button data-dd-trigger
          class="flex items-center gap-1.5 sm:gap-2 pl-1.5 sm:pl-2 pr-2 sm:pr-3 h-9 rounded-lg hover:bg-slate-100 transition-colors">
          <div class="w-7 h-7 rounded-full bg-blue-600 flex items-center justify-center text-white text-xs font-semibold flex-shrink-0">
            <%= usuario.nombre.charAt(0).toUpperCase() %>
          </div>
          <span class="text-sm font-medium text-slate-700 hidden md:block max-w-[90px] truncate"><%= usuario.nombre.split(' ')[0] %></span>
          <i class="bi bi-chevron-down text-slate-400 text-[10px] hidden md:block"></i>
        </button>

        <div data-dd-menu
          class="dropdown-menu closed absolute right-0 top-full mt-1.5 w-52 bg-white rounded-xl border border-slate-200 shadow-lg shadow-slate-900/5 p-1.5 z-50">
          <div class="px-3 py-2 border-b border-slate-100 mb-1">
            <div class="text-xs font-semibold text-slate-800 truncate"><%= usuario.nombre %></div>
            <div class="text-[11px] text-slate-500 mt-0.5">
              <span class="inline-flex items-center px-1.5 py-0.5 rounded-md bg-blue-50 text-blue-600 font-medium"><%= usuario.rol %></span>
            </div>
          </div>
          <a href="/auth/perfil" class="flex items-center gap-2.5 px-3 py-2 text-sm text-slate-600 rounded-lg hover:bg-slate-50 hover:text-slate-900 transition-colors">
            <i class="bi bi-person-circle text-base w-4"></i> Mi perfil
          </a>
          <% if (usuario.rol === 'director') { %>
          <a href="/auth/usuarios" class="flex items-center gap-2.5 px-3 py-2 text-sm text-slate-600 rounded-lg hover:bg-slate-50 hover:text-slate-900 transition-colors">
            <i class="bi bi-people text-base w-4"></i> Usuarios
          </a>
          <% } %>
          <div class="border-t border-slate-100 mt-1 pt-1">
            <a href="/auth/logout" class="flex items-center gap-2.5 px-3 py-2 text-sm text-red-500 rounded-lg hover:bg-red-50 transition-colors">
              <i class="bi bi-box-arrow-right text-base w-4"></i> Cerrar sesión
            </a>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </header>

  <!-- ══ BODY ════════════════════════════════════════════════ -->
  <div class="flex flex-1 min-h-0">

    <%- include('../partials/sidebar') %>

    <main class="flex-1 min-w-0 overflow-y-auto">
      <div class="p-4 md:p-6 max-w-screen-xl mx-auto">

        <% if (flash) { %>
        <div id="flash-msg" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium mb-5 border
          <%= flash.tipo === 'success' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
             flash.tipo === 'danger'  ? 'bg-red-50 text-red-700 border-red-200' :
             flash.tipo === 'warning' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                                        'bg-blue-50 text-blue-700 border-blue-200' %>">
          <i class="bi bi-<%= flash.tipo === 'success' ? 'check-circle' : flash.tipo === 'danger' ? 'x-circle' : flash.tipo === 'warning' ? 'exclamation-triangle' : 'info-circle' %> text-base flex-shrink-0"></i>
          <span class="min-w-0 flex-1"><%= flash.mensaje %></span>
          <button onclick="document.getElementById('flash-msg').remove()"
            class="ml-auto flex-shrink-0 w-7 h-7 flex items-center justify-center text-current opacity-50 hover:opacity-100">
            <i class="bi bi-x text-lg"></i>
          </button>
        </div>
        <% } %>

        <%- body %>
      </div>
    </main>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
<script src="/js/app.js"></script>
<%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
