<!-- Page header -->
<div class="mb-6">
  <h1 class="text-xl font-semibold text-slate-900">Panel principal</h1>
  <p class="text-sm text-slate-500 mt-0.5">Bienvenido, <span class="font-medium text-slate-700"><%= usuario.nombre.split(' ')[0] %></span>. Aquí está el resumen del sistema.</p>
</div>

<!-- Stats -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
  <div class="bg-white rounded-xl border border-slate-200/70 p-4 flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0">
      <i class="bi bi-folder2 text-lg"></i>
    </div>
    <div>
      <div class="text-2xl font-bold text-slate-900 leading-none"><%= totalCuadros %></div>
      <div class="text-xs text-slate-500 mt-1">Cuadros PRIM</div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-slate-200/70 p-4 flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
      <i class="bi bi-people text-lg"></i>
    </div>
    <div>
      <div class="text-2xl font-bold text-slate-900 leading-none"><%= totalAlumnos %></div>
      <div class="text-xs text-slate-500 mt-1">Alumnos</div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-slate-200/70 p-4 flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center flex-shrink-0">
      <i class="bi bi-hourglass-split text-lg"></i>
    </div>
    <div>
      <div class="text-2xl font-bold text-slate-900 leading-none"><%= ocrEstados.revision || 0 %></div>
      <div class="text-xs text-slate-500 mt-1">Pendientes OCR</div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-slate-200/70 p-4 flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center flex-shrink-0">
      <i class="bi bi-cpu text-lg"></i>
    </div>
    <div>
      <div class="text-2xl font-bold text-slate-900 leading-none"><%= Object.values(ocrEstados).reduce((a,b)=>a+b,0) %></div>
      <div class="text-xs text-slate-500 mt-1">Trabajos OCR</div>
    </div>
  </div>
</div>

<!-- Quick access -->
<div class="mb-6">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-sm font-semibold text-slate-800">Acceso rápido</h2>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <a href="/cuadros/crear" class="bg-white border border-slate-200/70 rounded-xl p-4 flex items-center gap-3 hover:border-blue-200 hover:shadow-sm hover:-translate-y-px transition-all duration-150 group">
      <div class="w-9 h-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center flex-shrink-0 group-hover:bg-blue-100 transition-colors">
        <i class="bi bi-file-earmark-plus text-base"></i>
      </div>
      <div><div class="text-sm font-medium text-slate-800">Registrar</div><div class="text-xs text-slate-500">Cuadro PRIM</div></div>
    </a>
    <a href="/alumnos/crear" class="bg-white border border-slate-200/70 rounded-xl p-4 flex items-center gap-3 hover:border-emerald-200 hover:shadow-sm hover:-translate-y-px transition-all duration-150 group">
      <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0 group-hover:bg-emerald-100 transition-colors">
        <i class="bi bi-person-plus text-base"></i>
      </div>
      <div><div class="text-sm font-medium text-slate-800">Nuevo</div><div class="text-xs text-slate-500">Alumno</div></div>
    </a>
    <a href="/ocr/subir" class="bg-white border border-slate-200/70 rounded-xl p-4 flex items-center gap-3 hover:border-purple-200 hover:shadow-sm hover:-translate-y-px transition-all duration-150 group">
      <div class="w-9 h-9 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center flex-shrink-0 group-hover:bg-purple-100 transition-colors">
        <i class="bi bi-cloud-upload text-base"></i>
      </div>
      <div><div class="text-sm font-medium text-slate-800">Subir</div><div class="text-xs text-slate-500">Digitalizar OCR</div></div>
    </a>
    <a href="/cuadros/busqueda" class="bg-white border border-slate-200/70 rounded-xl p-4 flex items-center gap-3 hover:border-slate-300 hover:shadow-sm hover:-translate-y-px transition-all duration-150 group">
      <div class="w-9 h-9 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center flex-shrink-0 group-hover:bg-slate-200 transition-colors">
        <i class="bi bi-search text-base"></i>
      </div>
      <div><div class="text-sm font-medium text-slate-800">Buscar</div><div class="text-xs text-slate-500">Cuadros</div></div>
    </a>
  </div>
</div>

<% if (ocrEstados.revision > 0) { %>
<div class="flex items-center gap-3 px-4 py-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 text-sm mb-6">
  <i class="bi bi-exclamation-triangle flex-shrink-0"></i>
  <span>Hay <strong><%= ocrEstados.revision %></strong> documento(s) esperando revisión OCR.</span>
  <a href="/ocr" class="ml-auto text-amber-700 font-medium underline underline-offset-2 hover:no-underline flex-shrink-0">Revisar</a>
</div>
<% } %>

<!-- Cuadros recientes -->
<div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
  <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-100">
    <h2 class="text-sm font-semibold text-slate-800">Cuadros recientes</h2>
    <a href="/cuadros" class="text-xs text-blue-600 hover:text-blue-700 font-medium">Ver todos <i class="bi bi-arrow-right"></i></a>
  </div>

  <% if (ultimosCuadros.length === 0) { %>
  <div class="py-14 text-center">
    <i class="bi bi-folder2-open text-4xl text-slate-200 block mb-3"></i>
    <p class="text-sm text-slate-400">No hay cuadros registrados aún.</p>
    <a href="/cuadros/crear" class="inline-flex items-center gap-2 mt-4 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
      <i class="bi bi-plus-lg"></i> Registrar el primero
    </a>
  </div>
  <% } else { %>
  <div class="table-wrap">
    <table class="w-full text-sm min-w-[520px]">
      <thead class="bg-slate-50/80">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Código</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Grado</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Año</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Origen</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Validado</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% ultimosCuadros.forEach(c => { %>
        <tr class="border-t border-slate-100 hover:bg-slate-50/60 transition-colors">
          <td class="px-5 py-3">
            <div class="flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
                <i class="bi bi-file-earmark-text text-blue-500 text-xs"></i>
              </div>
              <span class="font-medium text-slate-800"><%= c.codigo %></span>
            </div>
          </td>
          <td class="px-4 py-3 text-slate-500"><%= c.grado_nombre || '—' %></td>
          <td class="px-4 py-3 text-slate-600 font-medium"><%= c.anio %></td>
          <td class="px-4 py-3">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= c.origen === 'ocr' ? 'bg-purple-50 text-purple-700' : 'bg-blue-50 text-blue-700' %>">
              <%= c.origen %>
            </span>
          </td>
          <td class="px-4 py-3">
            <% if (c.validado_por) { %>
              <span class="text-emerald-600 text-xs font-medium"><i class="bi bi-check-circle-fill mr-1"></i>Validado</span>
            <% } else { %>
              <span class="text-slate-400 text-xs">Pendiente</span>
            <% } %>
          </td>
          <td class="px-4 py-3 text-right">
            <a href="/cuadros/<%= c.id %>" class="text-xs text-blue-600 hover:text-blue-700 font-medium">Ver</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
