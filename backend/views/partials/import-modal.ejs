<%#
  Params:
    modulo     - string: 'alumnos' | 'maestros' | 'usuarios' | 'grados' | 'secciones' | 'cursos' | 'asignaciones'
    moduloLabel - string: etiqueta legible, ej: 'Alumnos'
%>
<dialog id="import-modal-<%= modulo %>"
  class="w-full max-w-md rounded-2xl shadow-2xl border border-hueso-300 p-0 backdrop:bg-marino-950/60 backdrop:backdrop-blur-sm bg-white overflow-hidden">

  <div class="flex items-center justify-between px-6 py-4 border-b border-hueso-200 bg-hueso-50/60">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-bosque-100 text-bosque-700 flex items-center justify-center font-bold text-sm">
        <i class="bi bi-file-earmark-spreadsheet"></i>
      </div>
      <div>
        <h3 class="text-sm font-bold font-serif text-marino-950">Importar <%= moduloLabel %></h3>
        <p class="text-[11px] text-marino-600/70">Carga masiva desde archivo de datos</p>
      </div>
    </div>
    <button type="button" onclick="document.getElementById('import-modal-<%= modulo %>').close()"
      class="w-8 h-8 flex items-center justify-center rounded-xl text-marino-500 hover:bg-hueso-200 hover:text-marino-800 transition-colors">
      <i class="bi bi-x-lg text-xs"></i>
    </button>
  </div>

  <div class="p-6 space-y-5">
    <!-- Step 1 -->
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="w-5 h-5 rounded-full bg-marino-700 text-white text-[11px] font-bold flex items-center justify-center flex-shrink-0">1</span>
        <span class="text-xs font-bold text-marino-900 uppercase tracking-wider">Descargue el Formato Oficial</span>
      </div>
      <a href="/admin/importar/plantilla/<%= modulo %>"
        class="flex items-center gap-2.5 w-full h-11 px-4 rounded-xl border-2 border-dashed border-bosque-300 bg-bosque-50/60 text-bosque-800 text-xs font-bold hover:bg-bosque-100 transition-colors">
        <i class="bi bi-file-earmark-arrow-down text-base"></i>
        <span>Descargar plantilla_<%= modulo %>.xlsx</span>
      </a>
      <p class="text-[11px] text-marino-600/80 mt-1.5 leading-relaxed">Complete los datos en las columnas indicadas sin modificar los encabezados.</p>
    </div>

    <!-- Step 2 -->
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="w-5 h-5 rounded-full bg-marino-700 text-white text-[11px] font-bold flex items-center justify-center flex-shrink-0">2</span>
        <span class="text-xs font-bold text-marino-900 uppercase tracking-wider">Subir Archivo Diligenciado</span>
      </div>
      <form method="POST" action="/admin/importar/<%= modulo %>" enctype="multipart/form-data" class="space-y-3">
        <label id="drop-<%= modulo %>"
          class="flex flex-col items-center justify-center h-28 border-2 border-dashed border-hueso-300 rounded-xl cursor-pointer hover:border-marino-500 hover:bg-marino-50/20 bg-hueso-50/40 transition-all group">
          <i class="bi bi-cloud-arrow-up text-2xl text-marino-400 group-hover:text-marino-600 transition-colors mb-1"></i>
          <span id="drop-label-<%= modulo %>" class="text-xs font-semibold text-marino-700 group-hover:text-marino-900 transition-colors">
            Clic para seleccionar archivo
          </span>
          <span class="text-[11px] text-marino-400 mt-0.5">.xlsx, .xls, .csv &bull; máx. 5 MB</span>
          <input type="file" name="archivo" accept=".xlsx,.xls,.csv" required
            class="sr-only"
            onchange="document.getElementById('drop-label-<%= modulo %>').textContent = this.files[0]?.name ?? 'Clic para seleccionar'">
        </label>
        <button type="submit"
          class="w-full h-11 bg-bosque-600 hover:bg-bosque-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all flex items-center justify-center gap-2">
          <i class="bi bi-upload text-sm"></i> Procesar e Importar <%= moduloLabel %>
        </button>
      </form>
    </div>
  </div>

  <div class="px-6 pb-4 bg-hueso-50/50 pt-3 border-t border-hueso-200 text-center">
    <p class="text-[11px] text-marino-600/80">
      <i class="bi bi-shield-check text-bosque-600 mr-1"></i>
      Validación por fila: los registros correctos se importan automáticamente.
    </p>
  </div>
</dialog>
