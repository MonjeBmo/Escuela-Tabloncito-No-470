<aside id="sidebar" class="w-64 bg-white/95 backdrop-blur border-r border-hueso-200 flex flex-col flex-shrink-0 sticky top-14 h-[calc(100vh-56px)] sidebar-scroll overflow-y-auto">

  <!-- Mobile header: brand + close (lg: hidden) -->
  <div class="flex items-center justify-between px-4 py-3 border-b border-hueso-200 lg:hidden flex-shrink-0 bg-hueso-50">
    <div class="flex items-center gap-2.5 min-w-0">
      <div class="w-7 h-7 bg-gradient-to-br from-ladrillo-600 to-ladrillo-700 rounded-xl flex items-center justify-center flex-shrink-0 shadow-xs">
        <i class="bi bi-mortarboard-fill text-white text-xs"></i>
      </div>
      <span class="text-sm font-display font-bold text-marino-800 truncate">Tabloncito 470</span>
    </div>
    <button id="sidebar-close"
      class="w-8 h-8 flex items-center justify-center rounded-lg text-marino-500 hover:bg-hueso-200 transition-colors flex-shrink-0"
      aria-label="Cerrar menú">
      <i class="bi bi-x-lg text-sm"></i>
    </button>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 p-3 space-y-1 overflow-y-auto">

    <!-- Principal -->
    <div class="px-3 pb-1 pt-1">
      <span class="text-[10px] font-bold text-marino-400 uppercase tracking-wider font-display">General</span>
    </div>
    <a href="/dashboard" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-grid-1x2 w-4 text-center text-marino-400 group-hover:text-ladrillo-600 transition-colors flex-shrink-0"></i>
      <div class="flex-1 min-w-0">
        <div class="leading-snug">Panel Principal</div>
      </div>
    </a>

    <!-- Gestión Académica -->
    <% if (can('documents.view') || can('students.view') || can('ocr.view')) { %>
    <div class="px-3 pb-1 pt-3">
      <span class="text-[10px] font-bold text-ladrillo-700 uppercase tracking-wider font-display flex items-center gap-1.5">
        <i class="bi bi-mortarboard-fill text-[9px] text-ladrillo-500"></i> Gestión Académica
      </span>
    </div>

    <% if (can('documents.view')) { %>
    <a href="/cuadros" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-folder2-open w-4 text-center text-marino-400 group-hover:text-ladrillo-600 transition-colors flex-shrink-0"></i>
      <div class="flex-1 min-w-0">
        <div class="leading-snug">Cuadros Históricos</div>
      </div>
    </a>
    <a href="/cuadros/busqueda" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-search w-4 text-center text-marino-400 group-hover:text-ladrillo-600 transition-colors flex-shrink-0"></i>
      <div class="flex-1 min-w-0">
        <div class="leading-snug">Búsqueda Avanzada</div>
      </div>
    </a>
    <% } %>

    <% if (can('students.view')) { %>
    <a href="/alumnos" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-people w-4 text-center text-marino-400 group-hover:text-bosque-600 transition-colors flex-shrink-0"></i>
      <div class="flex-1 min-w-0">
        <div class="leading-snug">Registro de Alumnos</div>
      </div>
    </a>
    <% } %>

    <% if (can('ocr.view')) { %>
    <a href="/ocr" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-lightning-charge w-4 text-center text-marino-400 group-hover:text-ocre-600 transition-colors flex-shrink-0"></i>
      <div class="flex-1 min-w-0">
        <div class="leading-snug">Digitalización OCR</div>
      </div>
    </a>
    <% } %>
    <% } %>

    <!-- Administración -->
    <% if (can('admin.users') || can('admin.roles') || can('admin.grades') || can('admin.courses') || can('admin.teachers')) { %>
    <div class="px-3 pb-1 pt-3">
      <span class="text-[10px] font-bold text-bosque-700 uppercase tracking-wider font-display flex items-center gap-1.5">
        <i class="bi bi-gear-wide-connected text-[9px] text-bosque-600"></i> Administración
      </span>
    </div>
    <% if (can('admin.teachers')) { %>
    <a href="/admin/maestros" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-person-workspace w-4 text-center text-marino-400 group-hover:text-bosque-600 transition-colors flex-shrink-0"></i>
      <span>Docentes y Asignaciones</span>
    </a>
    <% } %>
    <% if (can('admin.grades')) { %>
    <a href="/admin/grados" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-mortarboard w-4 text-center text-marino-400 group-hover:text-bosque-600 transition-colors flex-shrink-0"></i>
      <span>Grados y Secciones</span>
    </a>
    <% } %>
    <% if (can('admin.courses')) { %>
    <a href="/admin/cursos" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-journal-bookmark w-4 text-center text-marino-400 group-hover:text-bosque-600 transition-colors flex-shrink-0"></i>
      <span>Cursos y Materias</span>
    </a>
    <% } %>
    <% if (can('admin.users')) { %>
    <a href="/admin/usuarios" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-person-badge w-4 text-center text-marino-400 group-hover:text-bosque-600 transition-colors flex-shrink-0"></i>
      <span>Usuarios y Accesos</span>
    </a>
    <% } %>
    <% if (can('admin.roles')) { %>
    <a href="/admin/roles" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-shield-check w-4 text-center text-marino-400 group-hover:text-bosque-600 transition-colors flex-shrink-0"></i>
      <span>Roles y Permisos</span>
    </a>
    <% } %>
    <% if (can('admin.users')) { %>
    <a href="/admin/ciclo" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-700 hover:bg-hueso-100 hover:text-marino-900 transition-colors group">
      <i class="bi bi-arrow-up-circle w-4 text-center text-marino-400 group-hover:text-bosque-600 transition-colors flex-shrink-0"></i>
      <span>Promoción de Ciclo</span>
    </a>
    <% } %>
    <% } %>

  </nav>

  <!-- Bottom actions -->
  <div class="p-2 border-t border-hueso-200 pb-safe flex-shrink-0 bg-hueso-50/50">
    <a href="/auth/perfil" class="js-nav-link flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-marino-600 hover:bg-hueso-100 hover:text-marino-900 transition-colors">
      <i class="bi bi-person-circle w-4 text-center text-marino-400 flex-shrink-0"></i>
      <span>Mi Cuenta</span>
    </a>
    <a href="/auth/logout" class="flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium text-ladrillo-600 hover:bg-ladrillo-50 transition-colors">
      <i class="bi bi-box-arrow-right w-4 text-center flex-shrink-0"></i>
      <span>Cerrar sesión</span>
    </a>
  </div>

</aside>

