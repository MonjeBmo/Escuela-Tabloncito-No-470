<!-- Header -->
<div class="mb-5">
  <div class="flex items-center gap-2 mb-1">
    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-ladrillo-100 text-ladrillo-800 border border-ladrillo-200/60">
      <i class="bi bi-search text-[10px]"></i> Motor de Búsqueda
    </span>
  </div>
  <h1 class="text-2xl font-display font-bold text-marino-900 tracking-tight">Buscar Cuadros PRIM</h1>
  <p class="text-sm text-marino-500 mt-0.5">Búsqueda avanzada por texto, año, grado y origen en el repositorio histórico.</p>
</div>

<!-- Tip de Búsqueda -->
<div class="mb-5 p-3.5 rounded-xl bg-hueso-100/80 border border-hueso-300/80 flex items-center gap-2.5 text-xs text-marino-700">
  <i class="bi bi-lightbulb-fill text-ocre-600 text-sm flex-shrink-0"></i>
  <span><strong>Consejo:</strong> Puede combinar filtros para encontrar registros específicos (ej. Año 2021 + Quinto Grado o escribir el nombre del maestro en "Texto libre").</span>
</div>

<!-- Search form -->
<div class="bg-white rounded-2xl border border-hueso-200 p-5 mb-6 shadow-xs">
  <form method="GET" action="/cuadros/busqueda">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5">
      <div class="sm:col-span-2 lg:col-span-2">
        <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">Texto libre</label>
        <div class="relative">
          <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-marino-400 text-xs pointer-events-none"></i>
          <input type="text" name="q" value="<%= filtros.q || '' %>" placeholder="Código, docente, notas..."
            class="w-full h-10 pl-9 pr-3 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 placeholder-marino-400 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-medium">
        </div>
      </div>
      <div>
        <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">Año</label>
        <select name="anio" class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-700 px-3 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-medium">
          <option value="">Todos los años</option>
          <% anios.forEach(a => { %><option value="<%= a %>" <%= filtros.anio == a ? 'selected' : '' %>><%= a %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">Grado / Sección</label>
        <select name="section_id" class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-700 px-3 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-medium">
          <option value="">Todas las secciones</option>
          <% secciones.forEach(s => { %><option value="<%= s.id %>" <%= filtros.section_id == s.id ? 'selected' : '' %>><%= s.display_name || s.nombre %></option><% }) %>
        </select>
      </div>
      <div class="flex items-end gap-2">
        <div class="flex-1 min-w-0">
          <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">Origen</label>
          <select name="origen" class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-700 px-3 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-medium">
            <option value="">Todos</option>
            <option value="manual" <%= filtros.origen === 'manual' ? 'selected' : '' %>>Manual</option>
            <option value="ocr" <%= filtros.origen === 'ocr' ? 'selected' : '' %>>OCR</option>
          </select>
        </div>
        <button type="submit" aria-label="Buscar"
          class="h-10 px-4 bg-ladrillo-600 text-white text-sm font-semibold rounded-xl hover:bg-ladrillo-700 shadow-xs transition-colors flex-shrink-0">
          <i class="bi bi-search"></i>
        </button>
      </div>
    </div>
  </form>
</div>

<!-- Results -->
<div class="bg-white rounded-2xl border border-hueso-200 shadow-sm overflow-hidden">
  <div class="flex items-center justify-between px-6 py-4 border-b border-hueso-200 bg-hueso-50/50">
    <h2 class="text-sm font-display font-bold text-marino-900 uppercase tracking-wider">
      <% if (hayFiltros) { %><%= cuadros.length %> resultado(s) encontrado(s)<% } else { %>Resultados de Búsqueda<% } %>
    </h2>
    <% if (hayFiltros && cuadros.length > 0) { %>
    <span class="text-xs text-marino-500 font-medium hidden sm:block">Usa los filtros superiores para refinar</span>
    <% } %>
  </div>

  <% if (!hayFiltros) { %>
  <div class="py-16 text-center px-4">
    <div class="w-16 h-16 rounded-2xl bg-hueso-100 text-marino-300 flex items-center justify-center mx-auto mb-3">
      <i class="bi bi-search text-3xl"></i>
    </div>
    <p class="text-sm font-medium text-marino-500">Ingrese criterios de búsqueda para comenzar.</p>
  </div>
  <% } else if (cuadros.length === 0) { %>
  <div class="py-16 text-center px-4">
    <div class="w-16 h-16 rounded-2xl bg-hueso-100 text-marino-300 flex items-center justify-center mx-auto mb-3">
      <i class="bi bi-inbox text-3xl"></i>
    </div>
    <p class="text-sm font-medium text-marino-500">No se encontraron cuadros con los criterios especificados.</p>
  </div>
  <% } else { %>

  <!-- ── Desktop table (md+) ──────────────────────────── -->
  <div class="hidden md:block table-wrap">
    <table class="w-full text-sm">
      <thead class="bg-hueso-100/70 border-b border-hueso-200 text-marino-600">
        <tr>
          <th class="px-6 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Código</th>
          <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Año</th>
          <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Grado</th>
          <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Docente</th>
          <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Origen</th>
          <th class="px-4 py-3.5 text-left text-xs font-bold uppercase tracking-wider font-display">Documento</th>
          <th class="px-6 py-3.5 w-16"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-hueso-200/70">
        <% cuadros.forEach(c => { %>
        <tr class="hover:bg-hueso-50/80 transition-colors">
          <td class="px-6 py-3.5">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-xl bg-ladrillo-50 border border-ladrillo-100 text-ladrillo-700 flex items-center justify-center flex-shrink-0">
                <i class="bi bi-file-earmark-text text-sm"></i>
              </div>
              <span class="font-bold text-marino-900"><%= c.codigo %></span>
            </div>
          </td>
          <td class="px-4 py-3.5 text-marino-800 font-semibold font-display"><%= c.anio %></td>
          <td class="px-4 py-3.5 text-marino-600 font-medium"><%= c.grado_nombre || '—' %></td>
          <td class="px-4 py-3.5 text-marino-600 max-w-[150px]"><span class="truncate block font-medium"><%= c.docente || '—' %></span></td>
          <td class="px-4 py-3.5">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold <%= c.origen === 'ocr' ? 'bg-marino-100 text-marino-800 border border-marino-200' : 'bg-hueso-200 text-marino-700' %>"><%= c.origen %></span>
          </td>
          <td class="px-4 py-3.5">
            <% if (c.documento_key) { %>
              <span class="inline-flex items-center gap-1 text-xs text-bosque-700 font-semibold"><i class="bi bi-check-circle-fill"></i> Adjunto</span>
            <% } else { %>
              <span class="text-xs text-marino-300">—</span>
            <% } %>
          </td>
          <td class="px-6 py-3.5 text-right">
            <a href="/cuadros/<%= c.id %>" class="inline-flex items-center gap-1 text-xs text-ladrillo-600 hover:text-ladrillo-800 font-bold px-2.5 py-1 rounded-lg hover:bg-ladrillo-50 transition-colors">
              Ver <i class="bi bi-arrow-right text-[10px]"></i>
            </a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- ── Mobile card list (< md) ──────────────────────── -->
  <div class="md:hidden divide-y divide-hueso-200/70">
    <% cuadros.forEach(c => { %>
    <a href="/cuadros/<%= c.id %>" class="flex items-start gap-3 px-4 py-4 hover:bg-hueso-50 transition-colors">
      <div class="w-10 h-10 rounded-xl bg-ladrillo-50 border border-ladrillo-100 text-ladrillo-700 flex items-center justify-center flex-shrink-0 mt-0.5">
        <i class="bi bi-file-earmark-text text-lg"></i>
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-center justify-between gap-2">
          <span class="font-bold text-marino-900 truncate"><%= c.codigo %></span>
          <span class="text-xs font-display font-semibold text-marino-800 flex-shrink-0"><%= c.anio %></span>
        </div>
        <div class="mt-1 flex flex-wrap gap-x-2 gap-y-0.5 text-xs">
          <% if (c.grado_nombre) { %><span class="text-marino-600 font-medium"><%= c.grado_nombre %></span><% } %>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-semibold <%= c.origen === 'ocr' ? 'bg-marino-100 text-marino-800' : 'bg-hueso-200 text-marino-700' %>"><%= c.origen %></span>
          <% if (c.documento_key) { %><span class="text-[10px] text-bosque-700 font-semibold"><i class="bi bi-check-circle-fill mr-0.5"></i>Doc.</span><% } %>
        </div>
        <% if (c.docente) { %><p class="text-xs text-marino-400 mt-0.5 truncate"><%= c.docente %></p><% } %>
      </div>
      <i class="bi bi-chevron-right text-marino-300 text-xs flex-shrink-0 mt-1"></i>
    </a>
    <% }) %>
  </div>

  <% } %>
</div>
