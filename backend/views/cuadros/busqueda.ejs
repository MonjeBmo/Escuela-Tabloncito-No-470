<!-- Header -->
<div class="mb-6">
  <h1 class="text-xl font-semibold text-slate-900">Buscar cuadros</h1>
  <p class="text-sm text-slate-500 mt-0.5">Motor de búsqueda avanzada en el repositorio PRIM</p>
</div>

<!-- Search form -->
<div class="bg-white rounded-xl border border-slate-200/70 p-4 sm:p-5 mb-5">
  <form method="GET" action="/cuadros/busqueda">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      <div class="sm:col-span-2 lg:col-span-2">
        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Texto</label>
        <div class="relative">
          <i class="bi bi-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
          <input type="text" name="q" value="<%= filtros.q || '' %>" placeholder="Código, docente..."
            class="w-full h-10 pl-8 pr-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white focus:border-blue-400 transition-colors">
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Año</label>
        <select name="anio" class="w-full h-10 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
          <option value="">Todos</option>
          <% anios.forEach(a => { %><option value="<%= a %>" <%= filtros.anio == a ? 'selected' : '' %>><%= a %></option><% }) %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Grado / Sección</label>
        <select name="section_id" class="w-full h-10 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
          <option value="">Todos</option>
          <% secciones.forEach(s => { %><option value="<%= s.id %>" <%= filtros.section_id == s.id ? 'selected' : '' %>><%= s.display_name || s.nombre %></option><% }) %>
        </select>
      </div>
      <div class="flex items-end gap-2">
        <div class="flex-1 min-w-0">
          <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Origen</label>
          <select name="origen" class="w-full h-10 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
            <option value="">Todos</option>
            <option value="manual" <%= filtros.origen === 'manual' ? 'selected' : '' %>>Manual</option>
            <option value="ocr" <%= filtros.origen === 'ocr' ? 'selected' : '' %>>OCR</option>
          </select>
        </div>
        <button type="submit" aria-label="Buscar"
          class="h-10 px-4 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex-shrink-0">
          <i class="bi bi-search"></i>
        </button>
      </div>
    </div>
  </form>
</div>

<!-- Results -->
<div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
  <div class="flex items-center justify-between px-4 sm:px-5 py-3.5 border-b border-slate-100">
    <h2 class="text-sm font-semibold text-slate-800">
      <% if (hayFiltros) { %><%= cuadros.length %> resultado(s)<% } else { %>Resultados<% } %>
    </h2>
    <% if (hayFiltros && cuadros.length > 0) { %>
    <span class="text-xs text-slate-400 hidden sm:block">Usa los filtros para refinar</span>
    <% } %>
  </div>

  <% if (!hayFiltros) { %>
  <div class="py-16 text-center px-4">
    <i class="bi bi-search text-5xl text-slate-200 block mb-3"></i>
    <p class="text-sm text-slate-400">Ingrese criterios de búsqueda para comenzar.</p>
  </div>
  <% } else if (cuadros.length === 0) { %>
  <div class="py-16 text-center px-4">
    <i class="bi bi-inbox text-5xl text-slate-200 block mb-3"></i>
    <p class="text-sm text-slate-400">No se encontraron cuadros con esos criterios.</p>
  </div>
  <% } else { %>

  <!-- ── Desktop table (md+) ──────────────────────────── -->
  <div class="hidden md:block table-wrap">
    <table class="w-full text-sm">
      <thead class="bg-slate-50/80">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Código</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Año</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Grado</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Docente</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Origen</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Doc.</th>
          <th class="px-4 py-3 w-16"></th>
        </tr>
      </thead>
      <tbody>
        <% cuadros.forEach(c => { %>
        <tr class="border-t border-slate-100 hover:bg-slate-50/60 transition-colors">
          <td class="px-5 py-3.5">
            <div class="flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
                <i class="bi bi-file-earmark-text text-blue-500 text-xs"></i>
              </div>
              <span class="font-medium text-slate-800"><%= c.codigo %></span>
            </div>
          </td>
          <td class="px-4 py-3.5 text-slate-600 font-medium"><%= c.anio %></td>
          <td class="px-4 py-3.5 text-slate-500"><%= c.grado_nombre || '—' %></td>
          <td class="px-4 py-3.5 text-slate-500 max-w-[140px]"><span class="truncate block"><%= c.docente || '—' %></span></td>
          <td class="px-4 py-3.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= c.origen === 'ocr' ? 'bg-purple-50 text-purple-700' : 'bg-blue-50 text-blue-700' %>"><%= c.origen %></span>
          </td>
          <td class="px-4 py-3.5">
            <% if (c.documento_key) { %>
              <span class="text-xs text-emerald-600 font-medium"><i class="bi bi-check-circle-fill mr-1"></i>Adjunto</span>
            <% } else { %>
              <span class="text-xs text-slate-400">—</span>
            <% } %>
          </td>
          <td class="px-4 py-3.5 text-right">
            <a href="/cuadros/<%= c.id %>" class="text-xs text-blue-600 hover:text-blue-700 font-medium">Ver <i class="bi bi-arrow-right"></i></a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- ── Mobile card list (< md) ──────────────────────── -->
  <div class="md:hidden divide-y divide-slate-100">
    <% cuadros.forEach(c => { %>
    <a href="/cuadros/<%= c.id %>" class="flex items-start gap-3 px-4 py-3.5 hover:bg-slate-50/60 transition-colors">
      <div class="w-10 h-10 rounded-xl <%= c.origen === 'ocr' ? 'bg-purple-50' : 'bg-blue-50' %> flex items-center justify-center flex-shrink-0 mt-0.5">
        <i class="bi bi-file-earmark-text <%= c.origen === 'ocr' ? 'text-purple-500' : 'text-blue-500' %>"></i>
      </div>
      <div class="min-w-0 flex-1">
        <div class="flex items-center justify-between gap-2">
          <span class="font-medium text-slate-800 truncate"><%= c.codigo %></span>
          <span class="text-xs text-slate-500 flex-shrink-0"><%= c.anio %></span>
        </div>
        <div class="mt-1 flex flex-wrap gap-x-2 gap-y-0.5">
          <% if (c.grado_nombre) { %><span class="text-xs text-slate-500"><%= c.grado_nombre %></span><% } %>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium <%= c.origen === 'ocr' ? 'bg-purple-50 text-purple-700' : 'bg-blue-50 text-blue-700' %>"><%= c.origen %></span>
          <% if (c.documento_key) { %><span class="text-[10px] text-emerald-600 font-medium"><i class="bi bi-check-circle-fill mr-0.5"></i>Doc.</span><% } %>
        </div>
        <% if (c.docente) { %><p class="text-xs text-slate-400 mt-0.5 truncate"><%= c.docente %></p><% } %>
      </div>
      <i class="bi bi-chevron-right text-slate-300 text-xs flex-shrink-0 mt-1"></i>
    </a>
    <% }) %>
  </div>

  <% } %>
</div>
