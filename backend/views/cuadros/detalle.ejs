<div class="d-flex align-items-center gap-3 mb-4">
  <a href="/cuadros" class="btn-secondary-app" style="padding:6px 12px;font-size:12.5px;">
    <i class="bi bi-arrow-left"></i>
  </a>
  <div class="flex-grow-1">
    <div class="page-title"><%= cuadro.codigo %></div>
    <div class="page-subtitle">Cuadro PRIM — Año <%= cuadro.anio %></div>
  </div>
  <div class="d-flex gap-2">
    <% if (!cuadro.validado_por && ['director','administrativo','validador_ocr'].includes(usuario.rol)) { %>
    <form method="POST" action="/cuadros/<%= cuadro.id %>/validar">
      <button type="button" class="btn-primary-app"
        data-confirm="¿Confirmar la validación del cuadro <%= cuadro.codigo %>?">
        <i class="bi bi-check-circle-fill"></i> Validar cuadro
      </button>
    </form>
    <% } %>
    <% if (urlDescarga) { %>
    <a href="<%= urlDescarga %>" target="_blank" class="btn-secondary-app">
      <i class="bi bi-download"></i> Descargar original
    </a>
    <% } %>
    <% if (usuario.rol === 'director') { %>
    <form method="POST" action="/cuadros/<%= cuadro.id %>/eliminar">
      <button type="button" class="btn-secondary-app" style="color:#b91c1c;border-color:#fecaca;"
        data-confirm="¿Eliminar el cuadro <%= cuadro.codigo %>? Esta acción eliminará también el documento guardado.">
        <i class="bi bi-trash"></i> Eliminar
      </button>
    </form>
    <% } %>
  </div>
</div>

<div class="row g-4">
  <!-- Metadatos -->
  <div class="col-lg-7">
    <div class="card-panel">
      <div class="card-panel-header">
        <h2 class="card-panel-title"><i class="bi bi-info-circle me-2"></i>Información del cuadro</h2>
        <span class="badge-app badge-<%= cuadro.origen %>"><%= cuadro.origen %></span>
      </div>
      <div class="p-4">
        <div class="detail-row">
          <div class="detail-label">Código</div>
          <div class="detail-value fw-bold"><%= cuadro.codigo %></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Año</div>
          <div class="detail-value"><%= cuadro.anio %></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Grado / sección</div>
          <div class="detail-value"><%= cuadro.grado_nombre || '—' %></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Docente</div>
          <div class="detail-value"><%= cuadro.docente || '—' %></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Total alumnos</div>
          <div class="detail-value"><%= cuadro.total_alumnos ?? '—' %></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Registrado por</div>
          <div class="detail-value"><%= cuadro.subido_por_nombre || '—' %></div>
        </div>
        <div class="detail-row">
          <div class="detail-label">Fecha de registro</div>
          <div class="detail-value"><%= new Date(cuadro.created_at).toLocaleDateString('es-GT', {day:'2-digit',month:'long',year:'numeric'}) %></div>
        </div>
        <% if (Object.keys(cuadro.datos_extra).length > 0) { %>
        <div class="detail-row">
          <div class="detail-label">Datos adicionales</div>
          <div class="detail-value">
            <% Object.entries(cuadro.datos_extra).forEach(([k,v]) => { %>
              <div style="font-size:12.5px;"><strong><%= k %>:</strong> <%= v %></div>
            <% }) %>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Validación y documento -->
  <div class="col-lg-5">
    <!-- Estado de validación -->
    <div class="card-panel mb-4">
      <div class="card-panel-header">
        <h2 class="card-panel-title"><i class="bi bi-shield-check me-2"></i>Validación</h2>
      </div>
      <div class="p-4">
        <% if (cuadro.validado_por) { %>
          <div class="d-flex align-items-center gap-3">
            <div class="stat-icon green" style="width:40px;height:40px;font-size:18px;">
              <i class="bi bi-check-lg"></i>
            </div>
            <div>
              <div class="fw-semibold" style="color:#15803d;">Cuadro validado</div>
              <div class="text-muted" style="font-size:12.5px;">
                <%= new Date(cuadro.validado_en).toLocaleDateString('es-GT', {day:'2-digit',month:'long',year:'numeric'}) %>
              </div>
            </div>
          </div>
        <% } else { %>
          <div class="d-flex align-items-center gap-3">
            <div class="stat-icon amber" style="width:40px;height:40px;font-size:18px;">
              <i class="bi bi-hourglass"></i>
            </div>
            <div>
              <div class="fw-semibold" style="color:#92400e;">Pendiente de validación</div>
              <div class="text-muted" style="font-size:12.5px;">Sin validar aún</div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Documento Capa 1 -->
    <div class="card-panel">
      <div class="card-panel-header">
        <h2 class="card-panel-title"><i class="bi bi-file-earmark-text me-2"></i>Documento fuente</h2>
      </div>
      <div class="p-4">
        <% if (cuadro.documento_nombre) { %>
          <div class="d-flex align-items-center gap-3">
            <div style="width:44px;height:44px;border-radius:10px;background:#eff6ff;display:flex;align-items:center;justify-content:center;">
              <i class="bi bi-file-earmark-pdf" style="font-size:22px;color:#1d4ed8;"></i>
            </div>
            <div style="flex:1;min-width:0;">
              <div class="fw-semibold" style="font-size:13.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= cuadro.documento_nombre %></div>
              <div class="text-muted" style="font-size:12px;"><%= cuadro.documento_mime || 'Archivo adjunto' %></div>
            </div>
          </div>
          <% if (urlDescarga) { %>
          <a href="<%= urlDescarga %>" target="_blank" class="btn-primary-app w-100 justify-content-center mt-3">
            <i class="bi bi-download"></i> Descargar documento original
          </a>
          <% } %>
          <div class="mt-3 p-2 rounded" style="background:#f0fdf4;border:1px solid #bbf7d0;font-size:11.5px;color:#15803d;">
            <i class="bi bi-lock-fill"></i> Documento Capa 1 — Original con validez legal
          </div>
        <% } else { %>
          <div class="text-muted text-center py-3" style="font-size:13px;">
            <i class="bi bi-file-earmark-x" style="font-size:32px;opacity:.3;display:block;margin-bottom:8px;"></i>
            Sin documento adjunto
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
