<!-- Header -->
<div class="flex items-center gap-3 mb-6">
  <a href="/cuadros" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 transition-colors flex-shrink-0">
    <i class="bi bi-arrow-left text-sm"></i>
  </a>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2">
      <h1 class="text-xl font-semibold text-slate-900 truncate"><%= cuadro.codigo %></h1>
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium flex-shrink-0 <%= cuadro.origen === 'ocr' ? 'bg-purple-50 text-purple-700' : 'bg-blue-50 text-blue-700' %>">
        <i class="bi bi-<%= cuadro.origen === 'ocr' ? 'cpu' : 'pencil' %> mr-1 text-[10px]"></i><%= cuadro.origen %>
      </span>
    </div>
    <p class="text-sm text-slate-500 mt-0.5">Cuadro PRIM — Año <%= cuadro.anio %></p>
  </div>
  <!-- Actions -->
  <div class="flex items-center gap-2 flex-shrink-0">
    <% if (!cuadro.validado_por && ['director','administrativo','validador_ocr'].includes(usuario.rol)) { %>
    <form method="POST" action="/cuadros/<%= cuadro.id %>/validar">
      <button type="button" class="inline-flex items-center gap-2 px-3 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition-colors"
        data-confirm="¿Confirmar la validación del cuadro <%= cuadro.codigo %>?">
        <i class="bi bi-check-circle"></i> Validar
      </button>
    </form>
    <% } %>
    <% if (urlDescarga) { %>
    <a href="<%= urlDescarga %>" target="_blank" class="inline-flex items-center gap-2 px-3 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors">
      <i class="bi bi-download"></i> Descargar
    </a>
    <% } %>
    <% if (usuario.rol === 'director') { %>
    <form method="POST" action="/cuadros/<%= cuadro.id %>/eliminar">
      <button type="button" class="inline-flex items-center gap-2 px-3 py-2 bg-white border border-red-200 text-red-500 text-sm font-medium rounded-lg hover:bg-red-50 transition-colors"
        data-confirm="¿Eliminar el cuadro <%= cuadro.codigo %>? Esta acción no se puede deshacer.">
        <i class="bi bi-trash"></i>
      </button>
    </form>
    <% } %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <!-- Metadatos (2/3) -->
  <div class="lg:col-span-2 space-y-5">
    <div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
      <div class="px-5 py-3.5 border-b border-slate-100">
        <h2 class="text-sm font-semibold text-slate-800">Información del cuadro</h2>
      </div>
      <dl class="divide-y divide-slate-100">
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Código</dt>
          <dd class="text-sm font-medium text-slate-800"><%= cuadro.codigo %></dd>
        </div>
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Año</dt>
          <dd class="text-sm text-slate-700"><%= cuadro.anio %></dd>
        </div>
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Grado / Sección</dt>
          <dd class="text-sm text-slate-700"><%= cuadro.grado_nombre || '—' %></dd>
        </div>
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Docente</dt>
          <dd class="text-sm text-slate-700"><%= cuadro.docente || '—' %></dd>
        </div>
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Total alumnos</dt>
          <dd class="text-sm text-slate-700"><%= cuadro.total_alumnos ?? '—' %></dd>
        </div>
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Registrado por</dt>
          <dd class="text-sm text-slate-700"><%= cuadro.subido_por_nombre || '—' %></dd>
        </div>
        <div class="flex items-center px-5 py-3">
          <dt class="text-xs font-semibold text-slate-500 uppercase tracking-wide w-40 flex-shrink-0">Fecha registro</dt>
          <dd class="text-sm text-slate-700"><%= new Date(cuadro.created_at).toLocaleDateString('es-GT',{day:'2-digit',month:'long',year:'numeric'}) %></dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Panel derecho (1/3) -->
  <div class="space-y-4">
    <!-- Validación -->
    <div class="bg-white rounded-xl border border-slate-200/70 p-5">
      <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Validación</h2>
      <% if (cuadro.validado_por) { %>
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center flex-shrink-0">
          <i class="bi bi-check-lg"></i>
        </div>
        <div>
          <div class="text-sm font-medium text-emerald-700">Cuadro validado</div>
          <div class="text-xs text-slate-400 mt-0.5"><%= new Date(cuadro.validado_en).toLocaleDateString('es-GT',{day:'2-digit',month:'short',year:'numeric'}) %></div>
        </div>
      </div>
      <% } else { %>
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-amber-50 text-amber-500 flex items-center justify-center flex-shrink-0">
          <i class="bi bi-hourglass"></i>
        </div>
        <div>
          <div class="text-sm font-medium text-amber-700">Pendiente de validación</div>
          <div class="text-xs text-slate-400 mt-0.5">Sin validar aún</div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Documento Capa 1 -->
    <div class="bg-white rounded-xl border border-slate-200/70 p-5">
      <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Documento fuente</h2>
      <% if (cuadro.documento_nombre) { %>
      <div class="flex items-center gap-3 mb-3">
        <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0">
          <i class="bi bi-file-earmark-pdf text-blue-500 text-lg"></i>
        </div>
        <div class="min-w-0">
          <div class="text-sm font-medium text-slate-700 truncate"><%= cuadro.documento_nombre %></div>
          <div class="text-xs text-slate-400 mt-0.5"><%= cuadro.documento_mime || 'Archivo' %></div>
        </div>
      </div>
      <% if (urlDescarga) { %>
      <a href="<%= urlDescarga %>" target="_blank" class="w-full h-9 flex items-center justify-center gap-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
        <i class="bi bi-download"></i> Descargar original
      </a>
      <% } %>
      <div class="flex items-center gap-1.5 mt-3 p-2.5 rounded-lg bg-emerald-50 border border-emerald-100">
        <i class="bi bi-shield-check text-emerald-500 text-xs flex-shrink-0"></i>
        <p class="text-[11px] text-emerald-600">Capa 1 — Documento original con validez legal</p>
      </div>
      <% } else { %>
      <div class="flex flex-col items-center justify-center py-6 text-center">
        <i class="bi bi-file-earmark-x text-3xl text-slate-200 mb-2"></i>
        <p class="text-xs text-slate-400">Sin documento adjunto</p>
      </div>
      <% } %>
    </div>
  </div>
</div>
