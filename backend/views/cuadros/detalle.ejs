<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div class="flex items-center gap-3">
    <a href="/cuadros" class="w-9 h-9 flex items-center justify-center rounded-xl border border-hueso-300 bg-white text-marino-700 hover:bg-hueso-100 hover:border-ladrillo-400 transition-all shadow-sm flex-shrink-0">
      <i class="bi bi-arrow-left text-sm font-bold"></i>
    </a>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2.5 flex-wrap">
        <h1 class="text-xl font-bold font-serif text-marino-950 truncate tracking-tight"><%= cuadro.codigo %></h1>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold flex-shrink-0 <%= cuadro.origen === 'ocr' ? 'bg-marino-100 text-marino-800 border border-marino-200' : 'bg-ladrillo-100 text-ladrillo-800 border border-ladrillo-200' %>">
          <i class="bi bi-<%= cuadro.origen === 'ocr' ? 'cpu' : 'pencil' %> mr-1.5 text-[11px]"></i><%= cuadro.origen === 'ocr' ? 'Digitalizado OCR' : 'Registro Manual' %>
        </span>
      </div>
      <p class="text-xs text-marino-600/80 mt-0.5 font-sans">Cuadro PRIM — Archivo Histórico Escolar (Año <%= cuadro.anio %>)</p>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex items-center gap-2.5 flex-wrap">
    <% if (!cuadro.validado_por && ['director','administrativo','validador_ocr'].includes(usuario.rol)) { %>
    <form method="POST" action="/cuadros/<%= cuadro.id %>/validar">
      <button type="button" class="inline-flex items-center gap-2 px-3.5 py-2 bg-bosque-600 hover:bg-bosque-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all"
        data-confirm="¿Confirmar la validación oficial del cuadro <%= cuadro.codigo %>?">
        <i class="bi bi-check2-circle text-sm"></i> Validar Cuadro
      </button>
    </form>
    <% } %>
    <% if (urlDescarga) { %>
    <a href="<%= urlDescarga %>" target="_blank" class="inline-flex items-center gap-2 px-3.5 py-2 bg-white border border-hueso-300 text-marino-800 hover:bg-hueso-100 text-xs font-semibold rounded-xl shadow-sm transition-all">
      <i class="bi bi-download text-ladrillo-600"></i> Descargar Original
    </a>
    <% } %>
    <% if (usuario.rol === 'director') { %>
    <form method="POST" action="/cuadros/<%= cuadro.id %>/eliminar">
      <button type="button" class="inline-flex items-center gap-2 px-3 py-2 bg-white border border-red-200 text-red-600 text-xs font-semibold rounded-xl hover:bg-red-50 transition-all"
        data-confirm="¿Eliminar el cuadro <%= cuadro.codigo %>? Esta acción no se puede deshacer.">
        <i class="bi bi-trash"></i>
      </button>
    </form>
    <% } %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Metadatos (2/3) -->
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-white rounded-2xl border border-hueso-200/80 shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-hueso-200 bg-hueso-50/50 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-ladrillo-100 text-ladrillo-700 flex items-center justify-center font-bold text-sm">
            <i class="bi bi-journal-text"></i>
          </div>
          <div>
            <h2 class="text-sm font-bold text-marino-950 font-serif">Metadatos e Indexación (Capa 2)</h2>
            <p class="text-[11px] text-marino-600/70">Información estructurada para consulta rápida y búsqueda</p>
          </div>
        </div>
        <span class="text-xs font-mono font-bold text-ladrillo-700 bg-ladrillo-50 px-2.5 py-1 rounded-lg border border-ladrillo-200/60">
          <%= cuadro.codigo %>
        </span>
      </div>

      <dl class="divide-y divide-hueso-100">
        <div class="flex flex-col sm:flex-row sm:items-center px-6 py-3.5 hover:bg-hueso-50/30 transition-colors">
          <dt class="text-xs font-bold text-marino-600 uppercase tracking-wider w-44 flex-shrink-0">Código Registro</dt>
          <dd class="text-sm font-semibold font-mono text-marino-950 mt-1 sm:mt-0"><%= cuadro.codigo %></dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center px-6 py-3.5 hover:bg-hueso-50/30 transition-colors">
          <dt class="text-xs font-bold text-marino-600 uppercase tracking-wider w-44 flex-shrink-0">Año Lectivo</dt>
          <dd class="text-sm font-semibold text-ladrillo-700 mt-1 sm:mt-0"><%= cuadro.anio %></dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center px-6 py-3.5 hover:bg-hueso-50/30 transition-colors">
          <dt class="text-xs font-bold text-marino-600 uppercase tracking-wider w-44 flex-shrink-0">Grado y Sección</dt>
          <dd class="text-sm text-marino-900 mt-1 sm:mt-0"><%= cuadro.grado_nombre || 'No especificado' %></dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center px-6 py-3.5 hover:bg-hueso-50/30 transition-colors">
          <dt class="text-xs font-bold text-marino-600 uppercase tracking-wider w-44 flex-shrink-0">Docente a Cargo</dt>
          <dd class="text-sm font-medium text-marino-900 mt-1 sm:mt-0"><%= cuadro.docente || '—' %></dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center px-6 py-3.5 hover:bg-hueso-50/30 transition-colors">
          <dt class="text-xs font-bold text-marino-600 uppercase tracking-wider w-44 flex-shrink-0">Alumnos Registrados</dt>
          <dd class="text-sm font-semibold text-bosque-700 mt-1 sm:mt-0"><%= cuadro.total_alumnos ?? '—' %> estudiantes</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center px-6 py-3.5 hover:bg-hueso-50/30 transition-colors">
          <dt class="text-xs font-bold text-marino-600 uppercase tracking-wider w-44 flex-shrink-0">Registrado por</dt>
          <dd class="text-sm text-marino-900 mt-1 sm:mt-0"><%= cuadro.subido_por_nombre || 'Sistema' %></dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center px-6 py-3.5 hover:bg-hueso-50/30 transition-colors">
          <dt class="text-xs font-bold text-marino-600 uppercase tracking-wider w-44 flex-shrink-0">Fecha de Registro</dt>
          <dd class="text-sm text-marino-800 mt-1 sm:mt-0"><%= new Date(cuadro.created_at).toLocaleDateString('es-GT',{day:'2-digit',month:'long',year:'numeric'}) %></dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- Panel derecho (1/3) -->
  <div class="space-y-5">
    <!-- Estado de Validación -->
    <div class="bg-white rounded-2xl border border-hueso-200/80 p-5 shadow-sm">
      <h2 class="text-xs font-bold text-marino-500 uppercase tracking-wider mb-3">Estado de Validación</h2>
      <% if (cuadro.validado_por) { %>
      <div class="flex items-start gap-3.5 p-3.5 rounded-xl bg-bosque-50/80 border border-bosque-200/60">
        <div class="w-10 h-10 rounded-xl bg-bosque-100 text-bosque-700 flex items-center justify-center flex-shrink-0">
          <i class="bi bi-shield-check text-lg"></i>
        </div>
        <div>
          <div class="text-sm font-bold text-bosque-900">Cuadro Validado</div>
          <div class="text-xs text-bosque-700/80 mt-0.5">Certificado el <%= new Date(cuadro.validado_en).toLocaleDateString('es-GT',{day:'2-digit',month:'short',year:'numeric'}) %></div>
        </div>
      </div>
      <% } else { %>
      <div class="flex items-start gap-3.5 p-3.5 rounded-xl bg-ocre-50/80 border border-ocre-200/60">
        <div class="w-10 h-10 rounded-xl bg-ocre-100 text-ocre-700 flex items-center justify-center flex-shrink-0">
          <i class="bi bi-hourglass-split text-lg"></i>
        </div>
        <div>
          <div class="text-sm font-bold text-ocre-900">Pendiente de Revisión</div>
          <div class="text-xs text-ocre-700/80 mt-0.5">Aún no ha sido ratificado por dirección</div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Documento Capa 1 Oficial -->
    <div class="bg-white rounded-2xl border border-hueso-200/80 p-5 shadow-sm relative overflow-hidden">
      <div class="absolute top-0 right-0 w-24 h-24 bg-ladrillo-50 rounded-full blur-2xl -mr-8 -mt-8 pointer-events-none"></div>
      <h2 class="text-xs font-bold text-marino-500 uppercase tracking-wider mb-3">Documento Fuente (Capa 1)</h2>
      <% if (cuadro.documento_nombre) { %>
      <div class="flex items-center gap-3 mb-4 p-3 rounded-xl bg-hueso-50/80 border border-hueso-200">
        <div class="w-10 h-10 rounded-lg bg-ladrillo-100 text-ladrillo-700 flex items-center justify-center flex-shrink-0">
          <i class="bi bi-file-earmark-pdf text-xl"></i>
        </div>
        <div class="min-w-0">
          <div class="text-xs font-bold text-marino-950 truncate"><%= cuadro.documento_nombre %></div>
          <div class="text-[11px] text-marino-600/70 mt-0.5"><%= cuadro.documento_mime || 'Documento Digitalizado' %></div>
        </div>
      </div>

      <% if (urlDescarga) { %>
      <a href="<%= urlDescarga %>" target="_blank" class="w-full h-10 flex items-center justify-center gap-2 bg-ladrillo-600 hover:bg-ladrillo-700 text-white text-xs font-semibold rounded-xl shadow-sm hover:shadow transition-all">
        <i class="bi bi-file-earmark-arrow-down text-sm"></i> Descargar Documento Legal
      </a>
      <% } %>

      <div class="flex items-start gap-2 mt-4 p-3 rounded-xl bg-bosque-50/70 border border-bosque-200/60">
        <i class="bi bi-info-circle text-bosque-700 text-xs flex-shrink-0 mt-0.5"></i>
        <p class="text-[11px] text-bosque-800 leading-relaxed font-sans">
          <strong>Validez Oficial:</strong> Este documento digitalizado original (Capa 1) es el único válido para emisión de constancias y cotejo histórico.
        </p>
      </div>
      <% } else { %>
      <div class="flex flex-col items-center justify-center py-6 text-center">
        <div class="w-12 h-12 rounded-xl bg-hueso-100 text-marino-400 flex items-center justify-center mb-2">
          <i class="bi bi-file-earmark-x text-2xl"></i>
        </div>
        <p class="text-xs text-marino-500">Sin archivo escaneado adjunto</p>
      </div>
      <% } %>
    </div>
  </div>
</div>
