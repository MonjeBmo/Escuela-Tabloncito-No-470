<!-- Header -->
<div class="flex items-center gap-3 mb-6">
  <a href="/cuadros" class="w-8 h-8 flex items-center justify-center rounded-lg border border-slate-200 text-slate-500 hover:bg-slate-50 transition-colors">
    <i class="bi bi-arrow-left text-sm"></i>
  </a>
  <div>
    <h1 class="text-xl font-semibold text-slate-900">Registrar cuadro PRIM</h1>
    <p class="text-sm text-slate-500 mt-0.5">Ingrese los metadatos y adjunte el documento escaneado original</p>
  </div>
</div>

<script id="sections-data"  type="application/json"><%- JSON.stringify(sections) %></script>
<script id="teachers-data" type="application/json"><%- JSON.stringify(teachers) %></script>

<form method="POST" action="/cuadros/crear" enctype="multipart/form-data">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

    <!-- Datos del cuadro (2/3) -->
    <div class="lg:col-span-2 space-y-5">
      <div class="bg-white rounded-xl border border-slate-200/70 p-5">
        <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-4">Datos del cuadro</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">
              Código <span class="text-red-400">*</span>
            </label>
            <input type="text" name="codigo" required placeholder="ej. PRIM-2024-001"
              class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">
              Año <span class="text-red-400">*</span>
            </label>
            <input type="number" name="anio" required
              min="1990" max="<%= new Date().getFullYear() %>" value="<%= new Date().getFullYear() %>"
              class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <!-- Grado (selector dependiente) -->
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Grado</label>
            <select id="grade-sel" class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
              <option value="">Sin especificar</option>
              <% grades.forEach(g => { %><option value="<%= g.id %>"><%= g.nombre %></option><% }) %>
            </select>
          </div>
          <!-- Sección (filtrada por grado) -->
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Sección</label>
            <select name="section_id" id="section-sel" class="w-full h-9 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-700 px-3 focus:bg-white focus:border-blue-400 transition-colors">
              <option value="">Sin especificar</option>
              <% sections.forEach(s => { %><option value="<%= s.id %>" data-grade="<%= s.grade_id %>"><%= s.nombre %></option><% }) %>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Total alumnos</label>
            <input type="number" name="total_alumnos" min="0" max="100" placeholder="ej. 35"
              class="w-full h-9 px-3 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white focus:border-blue-400 transition-colors">
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-600 uppercase tracking-wide mb-1.5">Docente</label>
            <div class="relative">
              <i class="bi bi-person absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
              <input type="text" id="docente-input" name="docente"
                placeholder="Buscar maestro o escribir nombre..."
                autocomplete="off"
                class="w-full h-9 pl-8 pr-8 text-sm rounded-lg border border-slate-200 bg-slate-50 text-slate-800 placeholder-slate-400 focus:bg-white focus:border-blue-400 transition-colors">
              <button type="button" id="docente-clear" class="hidden absolute right-2 top-1/2 -translate-y-1/2 text-slate-300 hover:text-slate-500 transition-colors">
                <i class="bi bi-x-circle-fill text-sm"></i>
              </button>
              <div id="docente-dropdown"
                class="hidden absolute z-30 top-full left-0 right-0 mt-1 bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden">
                <div id="docente-list" class="max-h-52 overflow-y-auto"></div>
                <div id="docente-empty" class="hidden px-4 py-3 text-xs text-slate-400 text-center">Sin coincidencias — se guardará el texto ingresado</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Documento fuente (1/3) -->
    <div class="space-y-4">
      <div class="bg-white rounded-xl border border-slate-200/70 p-5">
        <h2 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1">Documento fuente</h2>
        <p class="text-xs text-slate-400 mb-4">Capa 1 — Original con validez legal</p>

        <label for="doc-file" class="flex flex-col items-center justify-center h-32 border-2 border-dashed border-slate-200 rounded-xl cursor-pointer hover:border-blue-300 hover:bg-blue-50/30 transition-all group">
          <i class="bi bi-cloud-upload text-2xl text-slate-300 group-hover:text-blue-400 transition-colors mb-2"></i>
          <span class="text-xs text-slate-400 group-hover:text-blue-500 transition-colors">Clic para seleccionar archivo</span>
          <span class="text-[11px] text-slate-300 mt-0.5">PDF, JPG, PNG, TIFF — máx. 20 MB</span>
        </label>
        <input type="file" id="doc-file" name="documento" accept=".pdf,.jpg,.jpeg,.png,.tiff" class="sr-only">
        <p id="file-preview" class="text-xs text-blue-600 mt-2 min-h-[16px]"></p>

        <div class="mt-4 flex items-start gap-2 p-3 rounded-lg bg-slate-50 border border-slate-100">
          <i class="bi bi-info-circle text-slate-400 flex-shrink-0 mt-0.5"></i>
          <p class="text-xs text-slate-500">El archivo se almacena en MinIO y solo se entrega el original al solicitante.</p>
        </div>
      </div>

      <button type="submit" class="w-full h-10 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors flex items-center justify-center gap-2">
        <i class="bi bi-floppy"></i> Registrar cuadro
      </button>
      <a href="/cuadros" class="w-full h-10 bg-white border border-slate-200 text-slate-600 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors flex items-center justify-center">
        Cancelar
      </a>
    </div>
  </div>
</form>

<script>
(function () {
  const allSections = JSON.parse(document.getElementById('sections-data').textContent);
  const gradeSel   = document.getElementById('grade-sel');
  const sectionSel = document.getElementById('section-sel');

  gradeSel.addEventListener('change', function () {
    const gradeId = parseInt(this.value) || 0;
    const prev = sectionSel.value;
    sectionSel.innerHTML = '<option value="">Sin especificar</option>';
    allSections
      .filter(s => s.is_active && (!gradeId || s.grade_id === gradeId))
      .forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.nombre;
        if (String(s.id) === prev) opt.selected = true;
        sectionSel.appendChild(opt);
      });
  });

  document.getElementById('doc-file').addEventListener('change', function () {
    document.getElementById('file-preview').textContent = this.files[0]?.name ?? '';
  });

  // ── Combobox docente ────────────────────────────────────────
  (function () {
    const teachers = JSON.parse(document.getElementById('teachers-data').textContent);
    const input    = document.getElementById('docente-input');
    const dropdown = document.getElementById('docente-dropdown');
    const list     = document.getElementById('docente-list');
    const empty    = document.getElementById('docente-empty');
    const clearBtn = document.getElementById('docente-clear');
    let open = false;

    function render(q) {
      const lq = q.toLowerCase();
      const filtered = teachers.filter(t =>
        t.full_name.toLowerCase().includes(lq) ||
        (t.email || '').toLowerCase().includes(lq)
      );
      list.innerHTML = '';
      if (filtered.length === 0) {
        empty.classList.remove('hidden');
      } else {
        empty.classList.add('hidden');
        filtered.slice(0, 8).forEach(t => {
          const div = document.createElement('div');
          div.className = 'flex items-center gap-3 px-4 py-2.5 cursor-pointer hover:bg-blue-50 transition-colors';
          div.innerHTML =
            '<div class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold flex-shrink-0">' +
              t.full_name.charAt(0).toUpperCase() +
            '</div>' +
            '<div class="min-w-0">' +
              '<div class="text-sm font-medium text-slate-800 truncate">' + t.full_name + '</div>' +
              (t.email ? '<div class="text-xs text-slate-400 truncate">' + t.email + '</div>' : '') +
            '</div>';
          div.addEventListener('mousedown', function (e) {
            e.preventDefault();
            input.value = t.full_name;
            clearBtn.classList.remove('hidden');
            closeDropdown();
          });
          list.appendChild(div);
        });
      }
    }

    function openDropdown() {
      render(input.value);
      dropdown.classList.remove('hidden');
      open = true;
    }

    function closeDropdown() {
      dropdown.classList.add('hidden');
      open = false;
    }

    input.addEventListener('focus', () => openDropdown());
    input.addEventListener('input', function () {
      clearBtn.classList.toggle('hidden', !this.value);
      render(this.value);
      if (!open) openDropdown();
    });
    input.addEventListener('blur', () => setTimeout(closeDropdown, 150));

    clearBtn.addEventListener('click', function () {
      input.value = '';
      this.classList.add('hidden');
      input.focus();
    });
  })();
})();
</script>
