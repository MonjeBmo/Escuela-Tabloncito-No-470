<!-- Header -->
<div class="flex items-center gap-3 mb-7">
  <a href="/cuadros" class="w-9 h-9 flex items-center justify-center rounded-xl border border-hueso-300 text-marino-600 bg-white hover:bg-hueso-100 transition-colors shadow-xs">
    <i class="bi bi-arrow-left text-sm"></i>
  </a>
  <div>
    <div class="flex items-center gap-2 mb-0.5">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-ladrillo-100 text-ladrillo-800 border border-ladrillo-200/60">
        <i class="bi bi-file-earmark-plus text-[9px]"></i> Nuevo Registro
      </span>
    </div>
    <h1 class="text-2xl font-display font-bold text-marino-900 tracking-tight">Registrar Cuadro PRIM</h1>
    <p class="text-sm text-marino-500">Ingrese los metadatos y adjunte el documento escaneado original (Capa 1).</p>
  </div>
</div>

<script id="sections-data"  type="application/json"><%- JSON.stringify(sections) %></script>
<script id="teachers-data" type="application/json"><%- JSON.stringify(teachers) %></script>

<form method="POST" action="/cuadros/crear" enctype="multipart/form-data">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Datos del cuadro (2/3) -->
    <div class="lg:col-span-2 space-y-5">
      <div class="bg-white rounded-2xl border border-hueso-200 p-6 shadow-sm">
        <div class="flex items-center gap-2 mb-4 pb-3 border-b border-hueso-200">
          <div class="w-2 h-2 rounded-full bg-ladrillo-600"></div>
          <h2 class="text-xs font-bold text-marino-800 uppercase tracking-wider font-display">Metadatos del Cuadro</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">
              Código de Cuadro <span class="text-ladrillo-600">*</span>
            </label>
            <input type="text" name="codigo" required placeholder="ej. PRIM-2024-001"
              class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 placeholder-marino-400 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-medium">
            <p class="text-[11px] text-marino-500 mt-1">Identificador oficial o correlativo impreso en el cuadro.</p>
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">
              Año Escolar <span class="text-ladrillo-600">*</span>
            </label>
            <input type="number" name="anio" required
              min="1990" max="<%= new Date().getFullYear() %>" value="<%= new Date().getFullYear() %>"
              class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-display font-semibold">
            <p class="text-[11px] text-marino-500 mt-1">Ciclo lectivo correspondiente al registro de notas.</p>
          </div>
          <!-- Grado (selector dependiente) -->
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">Grado</label>
            <select id="grade-sel" class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-700 px-3 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-medium">
              <option value="">Sin especificar</option>
              <% grades.forEach(g => { %><option value="<%= g.id %>"><%= g.nombre %></option><% }) %>
            </select>
            <p class="text-[11px] text-marino-500 mt-1">Seleccione el grado para filtrar las secciones disponibles.</p>
          </div>
          <!-- Sección (filtrada por grado) -->
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">Sección</label>
            <select name="section_id" id="section-sel" class="w-full h-10 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-700 px-3 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-medium">
              <option value="">Sin especificar</option>
              <% sections.forEach(s => { %><option value="<%= s.id %>" data-grade="<%= s.grade_id %>"><%= s.nombre %></option><% }) %>
            </select>
            <p class="text-[11px] text-marino-500 mt-1">Sección (A, B, C, etc.) según asignación escolar.</p>
          </div>
          <div>
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">Total Alumnos Evaluados</label>
            <input type="number" name="total_alumnos" min="0" max="100" placeholder="ej. 35"
              class="w-full h-10 px-3.5 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 placeholder-marino-400 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-medium">
            <p class="text-[11px] text-marino-500 mt-1">Cantidad de estudiantes registrados en este cuadro.</p>
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-marino-700 uppercase tracking-wider font-display mb-1.5">Docente Responsable</label>
            <div class="relative">
              <i class="bi bi-person absolute left-3.5 top-1/2 -translate-y-1/2 text-marino-400 text-sm pointer-events-none"></i>
              <input type="text" id="docente-input" name="docente"
                placeholder="Buscar maestro registrado o escribir nombre completo..."
                autocomplete="off"
                class="w-full h-10 pl-9 pr-8 text-sm rounded-xl border border-hueso-300 bg-hueso-50/50 text-marino-900 placeholder-marino-400 focus:bg-white focus:border-ladrillo-500 transition-colors outline-none font-medium">
              <button type="button" id="docente-clear" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-marino-300 hover:text-marino-600 transition-colors">
                <i class="bi bi-x-circle-fill text-sm"></i>
              </button>
              <div id="docente-dropdown"
                class="hidden absolute z-30 top-full left-0 right-0 mt-1.5 bg-white border border-hueso-200 rounded-2xl shadow-xl overflow-hidden p-1.5">
                <div id="docente-list" class="max-h-52 overflow-y-auto space-y-0.5"></div>
                <div id="docente-empty" class="hidden px-4 py-3 text-xs text-marino-400 text-center font-medium">Sin coincidencias — se guardará el texto ingresado</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Documento fuente (1/3) -->
    <div class="space-y-4">
      <div class="bg-white rounded-2xl border border-hueso-200 p-6 shadow-sm">
        <div class="flex items-center gap-2 mb-1">
          <div class="w-2 h-2 rounded-full bg-bosque-600"></div>
          <h2 class="text-xs font-bold text-marino-800 uppercase tracking-wider font-display">Documento Fuente</h2>
        </div>
        <p class="text-xs text-marino-500 mb-4 font-medium">Capa 1 — Original con validez legal y firmas</p>

        <label for="doc-file" class="flex flex-col items-center justify-center h-36 border-2 border-dashed border-hueso-300 rounded-2xl cursor-pointer hover:border-ladrillo-400 hover:bg-ladrillo-50/30 transition-all group bg-hueso-50/30">
          <div class="w-10 h-10 rounded-xl bg-hueso-100 text-marino-400 group-hover:bg-ladrillo-100 group-hover:text-ladrillo-700 flex items-center justify-center transition-colors mb-2">
            <i class="bi bi-cloud-upload text-xl"></i>
          </div>
          <span class="text-xs font-semibold text-marino-700 group-hover:text-ladrillo-700 transition-colors">Clic para adjuntar archivo</span>
          <span class="text-[11px] text-marino-400 mt-0.5">PDF, JPG, PNG, TIFF — máx. 20 MB</span>
        </label>
        <input type="file" id="doc-file" name="documento" accept=".pdf,.jpg,.jpeg,.png,.tiff" class="sr-only">
        <p id="file-preview" class="text-xs font-semibold text-ladrillo-600 mt-2 min-h-[16px] truncate"></p>

        <div class="mt-4 flex items-start gap-2.5 p-3.5 rounded-xl bg-hueso-100/80 border border-hueso-200">
          <i class="bi bi-shield-check text-bosque-600 flex-shrink-0 text-sm mt-0.5"></i>
          <p class="text-xs text-marino-600 leading-relaxed">El archivo se almacena en MinIO y se preserva íntegro para entrega ante trámites oficiales.</p>
        </div>
      </div>

      <button type="submit" class="w-full h-11 bg-gradient-to-r from-ladrillo-600 to-ladrillo-700 text-white text-sm font-bold font-display rounded-xl hover:from-ladrillo-700 hover:to-ladrillo-800 shadow-sm shadow-ladrillo-600/25 transition-all flex items-center justify-center gap-2">
        <i class="bi bi-floppy"></i> Guardar Cuadro
      </button>
      <a href="/cuadros" class="w-full h-10 bg-white border border-hueso-300 text-marino-700 text-sm font-semibold rounded-xl hover:bg-hueso-100 transition-colors flex items-center justify-center">
        Cancelar
      </a>
    </div>
  </div>
</form>

<script>
(function () {
  const allSections = JSON.parse(document.getElementById('sections-data').textContent);
  const gradeSel   = document.getElementById('grade-sel');
  const sectionSel = document.getElementById('section-sel');

  gradeSel.addEventListener('change', function () {
    const gradeId = parseInt(this.value) || 0;
    const prev = sectionSel.value;
    sectionSel.innerHTML = '<option value="">Sin especificar</option>';
    allSections
      .filter(s => s.is_active && (!gradeId || s.grade_id === gradeId))
      .forEach(s => {
        const opt = document.createElement('option');
        opt.value = s.id;
        opt.textContent = s.nombre;
        if (String(s.id) === prev) opt.selected = true;
        sectionSel.appendChild(opt);
      });
  });

  document.getElementById('doc-file').addEventListener('change', function () {
    document.getElementById('file-preview').textContent = this.files[0]?.name ?? '';
  });

  // ── Combobox docente ────────────────────────────────────────
  (function () {
    const teachers = JSON.parse(document.getElementById('teachers-data').textContent);
    const input    = document.getElementById('docente-input');
    const dropdown = document.getElementById('docente-dropdown');
    const list     = document.getElementById('docente-list');
    const empty    = document.getElementById('docente-empty');
    const clearBtn = document.getElementById('docente-clear');
    let open = false;

    function render(q) {
      const lq = q.toLowerCase();
      const filtered = teachers.filter(t =>
        t.full_name.toLowerCase().includes(lq) ||
        (t.email || '').toLowerCase().includes(lq)
      );
      list.innerHTML = '';
      if (filtered.length === 0) {
        empty.classList.remove('hidden');
      } else {
        empty.classList.add('hidden');
        filtered.slice(0, 8).forEach(t => {
          const div = document.createElement('div');
          div.className = 'flex items-center gap-3 px-3.5 py-2 cursor-pointer hover:bg-hueso-100 rounded-xl transition-colors';
          div.innerHTML =
            '<div class="w-7 h-7 rounded-lg bg-ladrillo-100 text-ladrillo-700 flex items-center justify-center text-xs font-bold flex-shrink-0">' +
              t.full_name.charAt(0).toUpperCase() +
            '</div>' +
            '<div class="min-w-0">' +
              '<div class="text-sm font-semibold text-marino-900 truncate">' + t.full_name + '</div>' +
              (t.email ? '<div class="text-xs text-marino-400 truncate">' + t.email + '</div>' : '') +
            '</div>';
          div.addEventListener('mousedown', function (e) {
            e.preventDefault();
            input.value = t.full_name;
            clearBtn.classList.remove('hidden');
            closeDropdown();
          });
          list.appendChild(div);
        });
      }
    }

    function openDropdown() {
      render(input.value);
      dropdown.classList.remove('hidden');
      open = true;
    }

    function closeDropdown() {
      dropdown.classList.add('hidden');
      open = false;
    }

    input.addEventListener('focus', () => openDropdown());
    input.addEventListener('input', function () {
      clearBtn.classList.toggle('hidden', !this.value);
      render(this.value);
      if (!open) openDropdown();
    });
    input.addEventListener('blur', () => setTimeout(closeDropdown, 150));

    clearBtn.addEventListener('click', function () {
      input.value = '';
      this.classList.add('hidden');
      input.focus();
    });
  })();
})();
</script>

