<!-- Header -->
<div class="flex items-start sm:items-center justify-between gap-3 mb-6">
  <div class="min-w-0">
    <h1 class="text-xl font-semibold text-slate-900 truncate">Cuadros PRIM</h1>
    <p class="text-sm text-slate-500 mt-0.5"><%= total %> cuadro(s) en total</p>
  </div>
  <div class="flex items-center gap-2 flex-shrink-0">
    <a href="/cuadros/busqueda" aria-label="Buscar cuadros"
      class="inline-flex items-center gap-2 px-3 py-2 bg-white border border-slate-200 text-slate-700 text-sm font-medium rounded-lg hover:bg-slate-50 transition-colors">
      <i class="bi bi-search"></i>
      <span class="hidden sm:inline">Buscar</span>
    </a>
    <a href="/cuadros/crear" aria-label="Registrar cuadro"
      class="inline-flex items-center gap-2 px-3 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
      <i class="bi bi-plus-lg"></i>
      <span class="hidden sm:inline">Registrar cuadro</span>
    </a>
  </div>
</div>

<div class="bg-white rounded-xl border border-slate-200/70 overflow-hidden">
  <% if (cuadros.length === 0) { %>
  <div class="py-16 text-center px-4">
    <i class="bi bi-folder2-open text-5xl text-slate-200 block mb-3"></i>
    <p class="text-sm text-slate-400 mb-4">No hay cuadros registrados aún.</p>
    <a href="/cuadros/crear" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
      <i class="bi bi-plus-lg"></i> Registrar el primero
    </a>
  </div>
  <% } else { %>

  <!-- ── Desktop table (md+) ──────────────────────────── -->
  <div class="hidden md:block table-wrap">
    <table class="w-full text-sm">
      <thead class="bg-slate-50/80">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Código / Doc.</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Año</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Grado</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Docente</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Origen</th>
          <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wide">Estado</th>
          <th class="px-4 py-3 w-16"></th>
        </tr>
      </thead>
      <tbody>
        <% cuadros.forEach(c => { %>
        <tr class="border-t border-slate-100 hover:bg-slate-50/60 transition-colors">
          <td class="px-5 py-3.5">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg <%= c.origen === 'ocr' ? 'bg-purple-50' : 'bg-blue-50' %> flex items-center justify-center flex-shrink-0">
                <i class="bi bi-file-earmark-text text-sm <%= c.origen === 'ocr' ? 'text-purple-500' : 'text-blue-500' %>"></i>
              </div>
              <div class="min-w-0">
                <div class="font-medium text-slate-800"><%= c.codigo %></div>
                <% if (c.documento_nombre) { %>
                <div class="text-xs text-slate-400 mt-0.5 truncate max-w-[160px]"><%= c.documento_nombre %></div>
                <% } %>
              </div>
            </div>
          </td>
          <td class="px-4 py-3.5 text-slate-600 font-medium"><%= c.anio %></td>
          <td class="px-4 py-3.5 text-slate-500"><%= c.grado_nombre || '—' %></td>
          <td class="px-4 py-3.5 text-slate-500 max-w-[140px]"><span class="truncate block"><%= c.docente || '—' %></span></td>
          <td class="px-4 py-3.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= c.origen === 'ocr' ? 'bg-purple-50 text-purple-700' : 'bg-blue-50 text-blue-700' %>">
              <i class="bi bi-<%= c.origen === 'ocr' ? 'cpu' : 'pencil' %> mr-1 text-[10px]"></i><%= c.origen %>
            </span>
          </td>
          <td class="px-4 py-3.5">
            <% if (c.validado_por) { %>
              <span class="inline-flex items-center gap-1 text-xs text-emerald-600 font-medium"><i class="bi bi-check-circle-fill"></i> Validado</span>
            <% } else { %>
              <span class="text-xs text-slate-400">Sin validar</span>
            <% } %>
          </td>
          <td class="px-4 py-3.5 text-right">
            <div class="flex items-center justify-end gap-1">
              <a href="/cuadros/<%= c.id %>" aria-label="Ver cuadro <%= c.codigo %>"
                class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors">
                <i class="bi bi-eye text-sm"></i>
              </a>
              <% if (can('documents.delete')) { %>
              <div class="relative">
                <button data-dd-trigger aria-label="Más opciones"
                  class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors">
                  <i class="bi bi-three-dots text-sm"></i>
                </button>
                <div data-dd-menu class="dropdown-menu closed absolute right-0 top-full mt-1 w-36 bg-white rounded-xl border border-slate-200 shadow-lg p-1.5 z-20">
                  <form method="POST" action="/cuadros/<%= c.id %>/eliminar">
                    <button type="button" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-500 rounded-lg hover:bg-red-50 transition-colors"
                      data-confirm="¿Eliminar el cuadro <%= c.codigo %>? Esta acción no se puede deshacer.">
                      <i class="bi bi-trash"></i> Eliminar
                    </button>
                  </form>
                </div>
              </div>
              <% } %>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- ── Mobile card list (< md) ──────────────────────── -->
  <div class="md:hidden divide-y divide-slate-100">
    <% cuadros.forEach(c => { %>
    <div class="px-4 py-3.5">
      <div class="flex items-start justify-between gap-2">
        <a href="/cuadros/<%= c.id %>" class="flex items-center gap-3 min-w-0 flex-1">
          <div class="w-10 h-10 rounded-xl <%= c.origen === 'ocr' ? 'bg-purple-50' : 'bg-blue-50' %> flex items-center justify-center flex-shrink-0">
            <i class="bi bi-file-earmark-text <%= c.origen === 'ocr' ? 'text-purple-500' : 'text-blue-500' %>"></i>
          </div>
          <div class="min-w-0">
            <div class="font-medium text-slate-800 truncate"><%= c.codigo %></div>
            <div class="text-xs text-slate-500 mt-0.5">
              <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-medium mr-1.5 <%= c.origen === 'ocr' ? 'bg-purple-50 text-purple-700' : 'bg-blue-50 text-blue-700' %>"><%= c.origen %></span>
              <%= c.anio %>
            </div>
          </div>
        </a>
        <div class="flex items-center gap-0.5 flex-shrink-0">
          <a href="/cuadros/<%= c.id %>" aria-label="Ver cuadro"
            class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors">
            <i class="bi bi-eye text-sm"></i>
          </a>
          <% if (can('documents.delete')) { %>
          <div class="relative">
            <button data-dd-trigger aria-label="Más opciones"
              class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-700 transition-colors">
              <i class="bi bi-three-dots text-sm"></i>
            </button>
            <div data-dd-menu class="dropdown-menu closed absolute right-0 top-full mt-1 w-36 bg-white rounded-xl border border-slate-200 shadow-lg p-1.5 z-20">
              <form method="POST" action="/cuadros/<%= c.id %>/eliminar">
                <button type="button" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-red-500 rounded-lg hover:bg-red-50 transition-colors"
                  data-confirm="¿Eliminar el cuadro <%= c.codigo %>?">
                  <i class="bi bi-trash"></i> Eliminar
                </button>
              </form>
            </div>
          </div>
          <% } %>
        </div>
      </div>
      <div class="mt-2 ml-[52px] flex flex-wrap gap-x-3 gap-y-1">
        <% if (c.grado_nombre) { %>
        <span class="text-xs text-slate-500"><i class="bi bi-mortarboard mr-0.5 text-[10px]"></i><%= c.grado_nombre %></span>
        <% } %>
        <% if (c.validado_por) { %>
        <span class="text-xs text-emerald-600 font-medium"><i class="bi bi-check-circle-fill mr-0.5"></i>Validado</span>
        <% } else { %>
        <span class="text-xs text-slate-400">Sin validar</span>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>

  <!-- Pagination bar -->
  <div class="flex items-center justify-between gap-3 px-4 py-3 border-t border-slate-100">
    <!-- Per-page selector -->
    <div class="flex items-center gap-2 text-xs text-slate-500">
      <span class="hidden sm:inline">Mostrar</span>
      <% [10, 20].forEach(n => { %>
        <a href="?pagina=1&limit=<%= n %>"
          class="w-9 h-8 flex items-center justify-center rounded-lg border text-xs font-medium transition-colors
            <%= limit === n ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
          <%= n %>
        </a>
      <% }) %>
    </div>
    <!-- Page links -->
    <% if (totalPaginas > 1) { %>
    <div class="flex items-center gap-1">
      <% if (pagina > 1) { %>
        <a href="?pagina=<%= pagina-1 %>&limit=<%= limit %>" class="w-9 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 transition-colors text-sm"><i class="bi bi-chevron-left"></i></a>
      <% } %>
      <% for(let p=1; p<=totalPaginas; p++) { %>
        <% if (p===pagina) { %>
          <span class="w-9 h-8 flex items-center justify-center rounded-lg bg-blue-600 text-white text-sm font-medium"><%= p %></span>
        <% } else { %>
          <a href="?pagina=<%= p %>&limit=<%= limit %>" class="w-9 h-8 flex items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 transition-colors text-sm"><%= p %></a>
        <% } %>
      <% } %>
      <% if (pagina < totalPaginas) { %>
        <a href="?pagina=<%= pagina+1 %>&limit=<%= limit %>" class="w-9 h-8 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-100 transition-colors text-sm"><i class="bi bi-chevron-right"></i></a>
      <% } %>
    </div>
    <% } else { %>
    <span></span>
    <% } %>
  </div>

  <% } %>
</div>
